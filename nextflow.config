params {
  vcf_dir = "/scratch/datalake/raw/genbr/genbr_bioinfo/projects/DNABR_QC/decrypted"
  ref_fasta = "/scratch/datalake/trusted/genbr/genbr_bioinfo/projects/DNABR_QC/reference/hg38_ucsc/Homo_sapiens_assembly38.fasta"
  outdir = "/scratch/datalake/refined/genbr/genbr_bioinfo/projects/DNABR_QC/results_new1_1k_param_new1"

  workdir = "/scratch/datalake/transient/genbr/genbr_bioinfo/projects/DNABR_QC/tmp/nxf_work"

  keep_pass = true  // deja pasar solo variantes con flag PASS
  max_missing_site = 0.05  // el valor maximo es 1.0 , que anularia el filtro
  sample_missing_fail = 0.05  // NO FILTRAN , SOLO GENERA FLAGS, el valor maximo es 1.0 , que anularia el filtro
  het_sd_fail = 3           // NO FILTRAN , SOLO GENERA FLAGS
  // Cuándo “afectan algo” estos dos "NO FILTRAN ": solo si luego activas use_keep_samples_from_qc=true,
  // porque ahí sí se usarían para construir keep_samples.txt.
  plink_mac_min = 1  // dejarlo en 1 porque asi elimina monomorfismos
  plink_snps_only = true  
  plink_max_alleles = 2  

  bcftools_min_alleles = 2
  max_maf = null  // null = sin filtro MAF. Ej: 0.01 para quedarse con variantes raras (MAF < 1%)

  // Override del directorio donde discoverFilteredVcfs/discoverCountsTsvs buscan los VCFs de 02_filter.
  // null = usa params.outdir. Puede apuntarse a otro resultado para reutilizar VCF ya filtrados.
  filtered_input_dir = null

  // LAI rare biallelic (módulo 02.1)
  lai_rare_max_maf = 0.01         // MAF < 1% para variantes raras
  lai_rare_remove_info = false     // true = elimina todos los campos INFO
  lai_rare_keep_format = "GT"     // campos FORMAT a conservar (ej: "GT" o "GT,DP"). null = conserva todos
  // Filtro samples antes del MAF/MAC. Si set, ruta absoluta a archivo de IDs (uno por línea).
  // Caso de uso: KING-prune sobre individuos unrelated para separar demografía de pedigrés
  // (Manichaikul 2010 BIOINFORMATICS). MAF/MAC se recomputan sobre el subset.
  lai_rare_keep_samples_file = null
  // MAC mínimo del alelo menor. 2 excluye singletons; 1 = sin filtro. Anderson 2010 Nat Protocols
  // documenta que singletons son enriquecidos en errores de calling.
  lai_rare_min_mac = 1
  // Excluye chrX/Y/MT del módulo LAI_RARE. Hemicigosis distorsiona Jaccard rare-variant en
  // cohorts mixtas M/F (Browning 2018 PLOS Genetics). Default false por compatibilidad histórica.
  lai_rare_exclude_sex_chr = false

  chr_regex = "dnabr\\.hg38\\.2723\\.chr(\\d+|X|Y|MT)\\.vcf\\.gz"

  // Per-module switches (01-06 QC core)
  //
  // ``run_qc`` is a master switch for QC modules 01-06.  When false, all
  // six QC processes are skipped regardless of their individual
  // ``enable_*`` flag.  When true (default), each ``enable_*`` controls
  // its module independently — useful for running only a subset of QC
  // (e.g. ``enable_norm=true`` but ``enable_bcfstats=false``).
  //
  // Effective gate applied in main.nf:  do_<module> = enable_<module> && run_qc
  //
  // Example: skip all QC and run only advanced modules from disk:
  //     nextflow run main.nf ... --run_qc false --enable_ibd_enhanced true
  enable_smoke_test  = false  // 00 SMOKE_TEST — verificación ligera de Slurm+Singularity

  run_qc           = true
  enable_norm        = true   // 01 PREPROCESS_NORM_LEFTALIGN
  enable_filter      = true   // 02 PREPROCESS_FILTER_SNV_BIALLELIC_PASS
  enable_lai_rare    = false  // 02.1 LAI_RARE_BIALELIC_ONLY (requiere output de 02)
  enable_bcfstats    = true   // 03 QC_BCFTOOLS_STATS
  enable_pgen        = true   // 04 QC_PLINK_MAKE_PGEN
  enable_missing_het = true   // 05 QC_PLINK_MISSING_HET
  enable_report      = true   // 06 QC_AGGREGATE_REPORT_PY

  cpus = 4
  memory = "16 GB"
  time = "24h"
  max_retries = 2   // reintentos ante kills EXTERNOS transitorios (preempción/timeout exitcode); errores reales del comando NO reintentan



  slurm_queue = "cpu"
  slurm_account = null
  slurm_qos = null

  container_image = "${System.getenv('HOME')}/images/dnabr-qc-hpc.sif"

  // -----------------------------
  // Downstream modules 07+ (population genetics)
  // -----------------------------
  run_downstream = true  //  aplicar false para que NO ejecute los modulos 7 a 11.
                         //  (retrocompat: si true y algún enable_* downstream está true, se activan)

  // Rare SNP tract analysis from upstream rare-only VCFs
  enable_rare_snp_tracts = false
  runRareSnpTractAnalysis = false
  rare_tract_input_format = "vcf_rare"
  rare_tract_input_dir = "${params.outdir}/lai_rare"
  rare_tract_input_glob = "*.rare.vcf.gz"
  rare_tract_results_dir = "${params.outdir}/12_rare_snp_tracts"
  rare_tract_metadata = null
  rare_tract_genetic_map = null
  rare_tract_use_cm_if_available = true
  rare_tract_maf_threshold = params.lai_rare_max_maf ?: 0.01
  rare_tract_window_size_snps = 2000
  rare_tract_step_size_snps = 500
  rare_tract_enrichment_percentile = 95
  rare_tract_threshold_scope = "chromosome"
  rare_tract_max_gap_windows = 1
  rare_tract_min_tract_snps = 2000
  rare_tract_min_tract_bp = 50000
  rare_tract_min_chrom_rare_snps = 5000
  rare_tract_plot_dpi = 600
  rare_tract_plot_palette = "journal"
  rare_tract_plot_bins_method = "fd"
  rare_tract_plot_kde_bandwidth_scale = 1.0
  rare_tract_plot_ecdf = true
  rare_tract_plot_kde = true
  rare_tract_plot_scatter = true
  rare_tract_plot_boxplot_by_chrom = true
  rare_tract_plot_violin_by_chrom = true
  rare_tract_plot_chrom_metric = "log10_length_bp"
  rare_tract_plot_chrom_min_tracts = 3
  rare_tract_plot_chrom_max = 24
  rare_tract_plot_scatter_log_x = false
  rare_tract_plot_scatter_log_y = false

  // Per-individual distance modes from upstream rare-only VCFs
  enable_individual_snp_distance_modes = false
  distance_mode_input_format = "vcf_rare"
  distance_mode_input_dir = "${params.outdir}/lai_rare"
  distance_mode_input_glob = "*.rare.vcf.gz"
  distance_mode_results_dir = "${params.outdir}/13_individual_snp_distance_modes"
  distance_mode_sample_ids_file = null
  distance_mode_max_samples = null
  distance_mode_min_carrier_snps_per_individual_chr = 2
  distance_mode_distance_units = "bp"
  distance_mode_pair_selection = "all"
  distance_mode_max_pair_distance_bp = null
  distance_mode_nearest_neighbor_k = 1
  distance_mode_pair_block_size_snps = 2000
  distance_mode_hist_min_log10_bp = 1.0
  distance_mode_hist_max_log10_bp = 8.4
  distance_mode_hist_n_bins = 74
  distance_mode_abort_if_pairs_exceed = null
  distance_mode_plot_hist = true
  distance_mode_plot_dpi = 600
  distance_mode_plot_width_inches = 8.8
  distance_mode_plot_height_inches = 5.6
  distance_mode_plot_palette = "journal"
  distance_mode_plot_font_family = "DejaVu Sans"
  distance_mode_plot_export_pdf = true
  distance_mode_plot_export_svg = false

  // Rare allele sharing painting from upstream rare-only VCFs (module 14)
  enable_rare_allele_painting = false
  painting_input_format = "vcf_rare"
  painting_input_dir = "/scratch/datalake/refined/genbr/genbr_bioinfo/projects/DNABR_QC/results_modtest/lai_rare"
  painting_input_glob = "*.rare.vcf.gz"
  painting_results_dir = "${params.outdir}/14_rare_allele_sharing_painting"
  // Aggregate-only mode: skip per-chromosome ANALYZE and rebuild the
  // genome-wide aggregate outputs from existing per-chr scan results.
  // When null, ``painting_per_chr_dir`` defaults to the ``per_chr``
  // subdirectory published by a previous run under ``painting_results_dir``.
  painting_aggregate_only = false
  painting_per_chr_dir = null
  painting_sample_ids_file = null
  painting_max_samples = null
  // Cromosomas incluidos en M14 (per-chr scan + agregado genome-wide que consume M16.5).
  // Default: 22 autosomas. Excluye chrX/chrY por razones biológicas concretas en DNABR:
  //   - chrY: hemizygote, no recombina fuera de PAR, Ne ~1/4 autosómico. En DNABR 71% EUR
  //     (Nunes 2025 Fig 2D) -> sharing chrY sesga pares EUR-EUR. AC/AN mal computados al
  //     no usar --ploidy 1. "Sharing" en chrY = haplogrupo Y completo, no IBD.
  //   - chrX: ploidía variable (M=1, F=2). Ne ~3/4 autosómico. En DNABR 42% AFR + 35% NAM
  //     vs autosómico 59% EUR (Nunes 2025 Fig S10) -> sex-biased admixture contamina la
  //     matriz de sharing con una demografía distinta a la autosómica.
  // Convención del campo: fineSTRUCTURE/ADMIXTURE/IBDNe corren sobre autosomas o tratan
  // chrX por separado (Patterson 2006, Browning 2018, Lawson 2012).
  // Acepta List Groovy ['chr1',...] o String CSV "chr1,chr2,..." (prefijo "chr" opcional).
  // Override para análisis sex-aware: --painting_chromosomes "chr1,...,chr22,chrX"
  // El filtro se aplica simétricamente en el live path (ANALYZE per-chr) y en el path
  // aggregate-only (discoverPaintingPerChr) -- el agregado nunca ve los chrs excluidos.
  painting_chromosomes = (1..22).collect { "chr${it}" }
  painting_window_size_bp = 500000
  painting_step_size_bp = 250000
  painting_min_shared_variants = 1
  painting_min_jaccard = 0.05
  painting_max_gap_bp = 500000
  painting_min_segment_bp = 50000
  painting_max_block_gap_bp = 200000  // max gap (bp) between consecutive carrier variants within a block; 200 kb ≈ LD decay
  painting_min_block_snps = 3         // minimum consecutive carrier SNPs per individual to form a block in painting/heatmap/span-distribution plots; runs shorter than this are treated as isolated carriers (faint dots). Raise (e.g. 3) to suppress length-2 single-pair tracts.
  painting_plot_dpi = 600
  painting_plot_palette = "journal"
  painting_plot_font_family = "DejaVu Sans"
  painting_plot_width_inches = 16.0
  painting_plot_height_inches = 10.0
  painting_plot_max_height_inches = 40.0  // cap for per-individual painting height to avoid OOM on large cohorts (at 600 dpi, 16x40 in ≈ 0.9 GB RGBA; uncapped 16x800 in ≈ 18 GB → SIGKILL)
  painting_plot_raster_bp_per_col = 10000 // genomic resolution of the individual-painting raster (bp / image column); 10 kb ≈ 13k cols for chr1, crisp block boundaries with ~50 MB int32 grid for N=1000
  painting_skip_plots = false             // if true, skip plot generation entirely and only produce TSV/JSON (downstream modules consume the TSVs only)
  painting_plot_export_pdf = true
  painting_plot_export_svg = false
  painting_plot_mode = "both"
  painting_plot_max_pairs_legend = 30
  painting_region = null                 // e.g. "chr22:30000000-40000000" to paint a specific genomic region
  painting_region_size_bp = null        // e.g. 10000000 (10 Mb) to split paintings into shorter windows
  painting_n_jobs = null                 // joblib workers for pairwise-segment detection (single-threaded loop over ~2M pairs/chr at N=2619). null → auto = task.cpus (matches Slurm reservation, prevents oversubscription). Set explicit int to override (e.g. 1 for serial / debugging, 8 for full cpus=8 allocation). Speedup empirical: ~3.5x with n_jobs=8 (chr1 baseline 220s → ~60s; total M14 walltime ~14h → ~5h on 2619 cohort).
  painting_extra_args = ""               // escape hatch for ad-hoc experiments: any extra CLI args appended verbatim to the rare_allele_sharing_painter.py invocation (e.g. "--my-new-flag value"). Use this to test a new argparse flag without modifying modules/14_*.nf or this config. Empty by default.

  // ---------------------------------------------------------------------------
  // Module 17 — Rare variants in LAI tracts (Gnomix local-ancestry painting)
  // ---------------------------------------------------------------------------
  // Mapea copias de alelo raro (upstream lai_rare) sobre la ancestría local del
  // painting Gnomix (.msp por crom) y mide enriquecimiento por ancestría local
  // contra un baseline posicional de la cohorte. DESCRIPTIVO/control: no remueve
  // la tautología burden∝NAM a nivel-individuo (requiere residualización, Paso 2).
  enable_rare_in_lai = false
  rare_in_lai_input_format = "vcf_rare"
  rare_in_lai_input_dir = "${params.outdir}/lai_rare"        // dir con *.rare.vcf.gz (FORMAT/GT requerido)
  rare_in_lai_input_glob = "*.rare.vcf.gz"
  rare_in_lai_results_dir = "${params.outdir}/17_rare_in_lai_tracts"
  // Directorio del painting Gnomix por-cromosoma: <msp_dir>/chr<C>/dnabr.chr<C>.results.msp
  rare_in_lai_msp_dir = "/scratch/datalake/trusted/genbr/genbr_bioinfo/projects/DNABR_QC/lai-genomix/persnplai_default_rephase_results"
  rare_in_lai_msp_glob = "chr*/dnabr.chr*.results.msp"
  // Archivo externo con las columnas ID y Cohort para cruzar rare_id con LAI_id.
  rare_in_lai_metadata = null
  // Cromosomas incluidos (per-chr + agregado). Default: 22 autosomas — el .msp Gnomix
  // de DNABR cubre solo autosomas; misma convención biológica que painting_chromosomes
  // (ver su bloque: chrX/chrY tienen ploidía/Ne/sex-biased-admixture distintos).
  // Acepta List Groovy o String CSV (prefijo "chr" opcional).
  rare_in_lai_chromosomes = (1..22).collect { "chr${it}" }

  // ---------------------------------------------------------------------------
  // Module 19: figura raras-sobre-painting-LAI (karyograma + densidad + zoom).
  // Reutiliza la densidad estratificada de M17 (bin/rare_variants_in_lai_tracts.py
  // --emit_windows_bp) y la dibuja con scripts/plot_rare_karyogram_lai.py.
  // ---------------------------------------------------------------------------
  enable_rare_on_lai_painting = false
  rare_on_lai_input_format = "vcf_rare"
  rare_on_lai_input_dir = "${params.outdir}/lai_rare"          // dir con *.rare.vcf.gz (FORMAT/GT)
  rare_on_lai_input_glob = "*.rare.vcf.gz"
  rare_on_lai_results_dir = "${params.outdir}/19_rare_on_lai_painting"
  // Painting Gnomix por-cromosoma: <msp_dir>/chr<C>/dnabr.chr<C>.results.msp
  rare_on_lai_msp_dir = "/scratch/datalake/trusted/genbr/genbr_bioinfo/projects/DNABR_QC/lai-genomix/persnplai_default_rephase_results"
  rare_on_lai_msp_glob = "chr*/dnabr.chr*.results.msp"
  rare_on_lai_metadata = null  // archivo externo con el cruce de identificadores
  rare_on_lai_chromosomes = (1..22).collect { "chr${it}" }     // .msp Gnomix = solo autosomas
  rare_on_lai_window_bp = 250000        // ancho de ventana de la densidad estratificada (panel b)
  rare_on_lai_n_grid = 1600             // bins de muestreo del painting (panel a)
  rare_on_lai_panel_c = "zoom"          // "zoom" (region) o "full" (cromosoma completo)
  rare_on_lai_panel_c_select = "extremes"  // "extremes" (gradiente) o "mosaic" (mas quiebres)
  rare_on_lai_individuals = ""          // CSV de IDs (LAI_id 'Cohort_ID' o sample ID); prioridad sobre select
  rare_on_lai_zoom_mb = 4.0             // ancho del zoom (Mb) cuando panel_c="zoom"
  rare_on_lai_n_zoom_per_group = 2      // individuos por ancestria cuando select="extremes"
  rare_on_lai_dpi = 400

  // ---------------------------------------------------------------------------
  // Module 18 — Common-variant asIBD comparator vs rare-variant communities
  // ---------------------------------------------------------------------------
  // Compara la estructura de comunidad de variantes COMUNES (asIBD de Nunes:
  // Refined IBD sobre el WGS rephased, estratificado por ancestría local
  // anc{1,2,3}.gapfilled_ibd) contra las comunidades de raras (M16.5), usando el
  // MISMO Leiden. Reporta las 3 ancestrías + concordancia + complementariedad +
  // fallos. Discriminante JOINT pre-registrado (eje mtDNA fijo + null por
  // permutación AND no-contención en árbitro >2cM per-ancestría). Afinidad
  // normalizada por dosis de ancestría local. Sin datación temporal (M14 = IBS bp).
  enable_asibd_comparator = false
  // Dir con anc{1,2,3}.gapfilled_ibd descargados de gs://.../dnabr-ibd/combined/
  asibd_input_dir = "/scratch/datalake/trusted/genbr/genbr_bioinfo/projects/DNABR_QC/nunes_asibd"
  asibd_glob = "anc*.gapfilled_ibd"
  asibd_anc_map = "anc1=AFR,anc2=EUR,anc3=NAM"   // confirmado en runtime por dosis local media
  asibd_results_dir = "${params.outdir}/18_common_asibd_comparator"
  // null → descubre leiden_assignments.tsv en ibd_enhanced_results_dir (M16.5)
  asibd_leiden_assignments = null
  asibd_metadata = null
  asibd_resolution_col = "community_res_1"
  // Se conservan los mismos valores de Leiden que en M16.5 para que la comparación sea directa.
  asibd_leiden_resolutions = "0.5,0.8,1.0,1.2,1.5,2.0,3.0"
  asibd_leiden_n_seeds = 25
  asibd_leiden_min_community_size = 3
  asibd_leiden_consensus_resolution = 1.0
  asibd_seed = 42
  // Comparador
  asibd_affinity_weight = "sum_cm"        // sum_cm | n_seg | max_cm (sensibilidad)
  asibd_normalize_by_dosage = true        // divide afinidad por dosis_a*dosis_b de la ancestría (anti-confound de dosis)
  asibd_arbiter_min_cm = 2.0              // umbral del árbitro Refined-IBD per-ancestría (Browning&Browning)
  asibd_ortho_perm_n = 2000               // permutaciones del null de enriquecimiento mtDNA (criterio A)
  asibd_ortho_perm_alpha = 0.05
  asibd_arbiter_containment = 0.80        // fracción contenida en una comunidad del árbitro = "contenida" (B)

  // ---------------------------------------------------------------------------
  // Module 21 — Build presence channel (canal de presencia externa / NO-privacidad)
  // ---------------------------------------------------------------------------
  // Para cada SNV raro de DNABR y cada panel NAM externo PRE-STAGED, clasifica si el ALELO
  // aparece afuera: PRESENT_ALLELE refuta privacidad; ABSENT NO confirma founder (canal
  // BINARIO present/unknown, sin Beta-Binomial ni un tercer estado de callability). Multi-panel
  // (NAMBR-128 VQSR vs 71-native .raw) = comparación apples-to-apples vía --panel-pass-only.
  enable_presence_channel = false
  presence_channel_input_format = "vcf_rare"
  // Dir con *.rare.vcf.gz (universo de raras = target del audit, SITE-LEVEL). Matriz canónica MAC=2.
  presence_channel_input_dir = "/scratch/datalake/refined/genbr/genbr_bioinfo/projects/DNABR_QC/results_modtest_mac2/lai_rare"
  presence_channel_input_glob = "*.rare.vcf.gz"
  presence_channel_results_dir = "${params.outdir}/21_presence_channel"
  // Cromosomas (per-chr + agregado). Default 22 autosomas; misma convención biológica que
  // painting_chromosomes. Acepta List Groovy o String CSV (prefijo "chr" opcional).
  presence_channel_chromosomes = (1..22).collect { "chr${it}" }
  // Dir de referencia con los paneles PRE-STAGED: <dir>/<panel_id>/chr<C>.vcf.gz (+ .tbi).
  // Provisioning fuera del pipeline: tools/stage_presence_panels.sh (baja del bucket + tabix).
  presence_panel_dir = "/scratch/datalake/refined/genbr/genbr_bioinfo/projects/DNABR_QC/reference_external_panels"
  // Máscaras UCSC/ENCODE crudas para construir el bed LCR/segdup (genome-wide, 1 vez).
  presence_lcr_mask_dir = "/scratch/datalake/refined/genbr/genbr_bioinfo/projects/DNABR_QC/reference_masks_hg38/raw"
  // Paneles a auditar (multi-panel, escalable: agregar un panel = 1 entrada aquí + re-stage).
  //   id          : identificador y subdir bajo presence_panel_dir (única fuente de verdad del consumo)
  //   version     : etiqueta de versión que va al PROVENANCE/manifest
  //   drop_sample : muestra a excluir para la sensibilidad de circularidad ('' = ninguna).
  //                 EC57_EC57 = 1 muestra del proyecto DNABR dentro del panel NAMBR (1/128).
  //   pass_only   : indexar solo filas PASS para comparar paneles con el mismo criterio.
  //                 NAMBR ya viene 100% PASS upstream; el .raw no tiene VQSR -> pass_only=false y
  //                 el conteo PASS/non-PASS del summary documenta la asimetría de régimen.
  presence_panels = [
    [ id: 'NAMBR_128_hg38_vqsr', version: 'nambr.normalized@2025-02-17', drop_sample: 'EC57_EC57', pass_only: true ],
    [ id: 'NAM_native_71_raw',   version: 'natwgs.hg38.71.raw',          drop_sample: '',           pass_only: false ],
  ]

  // ---------------------------------------------------------------------------
  // Module 20 — Build feature store (NÚCLEO V.02-A: Q + Σℓ + densidad por individuo)
  // ---------------------------------------------------------------------------
  // Tabla de características por individuo. Consume lai_rare (densidad), M14 (Σℓ) y metadata (Q).
  enable_feature_build = false
  feature_build_input_dir = "/scratch/datalake/refined/genbr/genbr_bioinfo/projects/DNABR_QC/results_modtest_mac2/lai_rare"
  feature_build_input_glob = "*.rare.vcf.gz"
  feature_build_results_dir = "${params.outdir}/20_feature_store"
  // Cromosomas para la densidad. Default 22 autosomas (misma convención que painting_chromosomes).
  feature_build_chromosomes = (1..22).collect { "chr${it}" }
  // Dir del agregado de M14 (Σℓ por individuo = individual_sharing_summary.tsv).
  feature_build_m14_dir = "/scratch/datalake/refined/genbr/genbr_bioinfo/projects/DNABR_QC/14_wgs_2619-indiv_painting_mac2_minseg-1Mb_minvar-10_gap-50k_minjac-0.1/14_rare_allele_sharing_painting_autosomes_only"
  // Metadata con Q (cols Autosomes_*_anc) + Sex; clave de join = ID == sample_id del VCF de raras.
  feature_build_metadata_file = null
  // Cohorte certificada (rare ∩ metadata, dedup). assert N o aborta.
  feature_build_expected_n = 2619
  feature_build_dedup_id = "BB-COVL-397"
  // Fecha del build fijada por PARÁMETRO (no del reloj) para reproducibilidad del manifest.
  feature_build_date = "2026-06-25"
  // Densidad por ventana fija (bp). 0 = off (default; burden genome-wide + por-cromosoma basta hoy).
  feature_build_density_window = 0

  // ---------------------------------------------------------------------------
  // Module 16.5 — IBD Community Detection Enhanced (biological interpretability)
  // ---------------------------------------------------------------------------
  // Leiden multi-resolution communities + Laplacian-normalised Sym-NMF
  // (cophenetic K selection, ARI multi-seed stability, per-sample confidence,
  // silhouette), UMAP network layout, hierarchical within-community heatmap
  // ordering and optional metadata (region/UF) overlay.  Reads the pair-wise
  // sharing outputs of M14 (pair_sharing_summary + all_pairwise_segments).
  enable_ibd_enhanced = false
  ibd_enhanced_results_dir = "${params.outdir}/16_5_ibd_community_enhanced"
  ibd_enhanced_input_dir   = null       // null → auto-discover from M14 outputs (same policy as M16)
  ibd_enhanced_seed = 42
  ibd_enhanced_min_edge_bp = 100000
  ibd_enhanced_min_max_segment_bp = 0
  ibd_enhanced_edge_weight_transform = "log1p"
  ibd_enhanced_segments_chunk_rows = 5000000
  // Leiden: slightly finer sweep + seeds; min_community_size=3 to capture
  // nuclear families (duos/trios) relevant for cryptic-kinship question.
  ibd_enhanced_leiden_resolutions = "0.5,0.8,1.0,1.2,1.5,2.0,3.0"
  ibd_enhanced_leiden_n_seeds = 25
  ibd_enhanced_leiden_min_community_size = 3
  ibd_enhanced_leiden_consensus_resolution = 1.0
  // Sym-NMF: wider K sweep (Brazil usually shows 3-4 ancestral components;
  // starting at K=2 allows macro-structure to emerge).  ``nmf_inits`` > 1
  // is used by sprint 2 to compute cophenetic correlation per K.
  ibd_enhanced_nmf_k_values = "2,3,4,5,6,8,10,12"
  ibd_enhanced_nmf_inits = 30
  ibd_enhanced_nmf_init_mode = "nndsvd-fast"   // 'nndsvd-fast' (default, deterministic) or 'random-cophenetic' (Brunet 2004 K-selection genuine; required when nmf_inits>1 and you want an informative cophenetic correlation)
  ibd_enhanced_nmf_max_iter = 500
  ibd_enhanced_nmf_tol = 1e-5
  ibd_enhanced_laplacian_normalize = true   // D^{-1/2} S D^{-1/2} before Sym-NMF (fixes degree bias)
  // K-selection — biological + statistical criteria (post hoc on cophenetic curve)
  ibd_enhanced_nmf_operational_k = 0          // >0: lock recommended K to this value (use when biology dictates K, e.g. 8 for ~8 ancestral components in admixed Latin American cohorts).  0 = data-driven dispersion-elbow.
  ibd_enhanced_nmf_dispersion_threshold = 0.85 // Kim & Park 2007 dispersion floor for K to qualify as recommended
  ibd_enhanced_nmf_cophenetic_floor = 0.90    // Brunet 2004 cophenetic floor (standard threshold)
  ibd_enhanced_nmf_min_marginal_coph = 0.005  // marginal coph gain (coph[K]-coph[K-1]) below which curve considered flat (elbow reached)
  // Bio-detector thresholds (sprint 3)
  ibd_enhanced_kinship_segment_mb = 10       // max_segment_bp >= this → family candidate
  ibd_enhanced_kinship_max_size = 15         // community size cap to consider as family
  ibd_enhanced_founder_intra_inter_ratio = 10.0 // intra/inter sharing ratio for founder candidates
  ibd_enhanced_founder_min_silhouette = 0.3    // silhouette floor for founder candidates (set 0 to disable for admixed cohorts)
  ibd_enhanced_founder_min_size = 10           // community size floor for founder COMPUTATION
  ibd_enhanced_founder_min_size_for_report = 10 // community size floor for founder REPORT (separate to filter family-trio artefacts post-hoc)
  // Validation & plotting
  ibd_enhanced_validation_resolution = 1.0
  ibd_enhanced_top_samples_per_community = 3
  ibd_enhanced_metadata_file = null          // optional TSV with sample_id + region/UF
  ibd_enhanced_plot_color_by = null          // column name in metadata, e.g. 'region' or 'UF'
  ibd_enhanced_plot_dpi = 200
  ibd_enhanced_plot_width_inches = 12.0
  ibd_enhanced_plot_height_inches = 8.0
  ibd_enhanced_plot_export_pdf = false
  // Additional SVG vector export for the 2D network UMAP only.  Off by
  // default: PNG @ plot_dpi covers most thesis-figure needs.  Turn on
  // when you need infinite zoom or post-hoc editing in Inkscape.
  ibd_enhanced_plot_export_svg = false
  ibd_enhanced_plot_network_max_nodes = 3500   // raised from 2000 — for DNABR-scale (N≈3k) shows all individuals without down-sampling
  ibd_enhanced_plot_heatmap_max_nodes = 3500   // raised from 3000 — same rationale
  ibd_enhanced_plot_cluster_label_min_size = 10 // draw centroid label (C{id} or paper annotation) for communities with ≥ this many members
  ibd_enhanced_plot_community_annotations_file = ""  // optional TSV with community_id+annotation; HIGHEST priority (manual override).  Use for hand-curated labels not derivable from metadata.
  // Auto-annotation: derive UMAP centroid labels automatically from a
  // metadata column.  Set to e.g. 'finestructure_clusters' for paper-Nunes
  // mappings (BrazilA, BrazilB, ...), 'Region' for geo labels, or any
  // metadata column.  Empty default = labels fall back to 'C{id}'.
  //
  // When several communities collapse to the same modal value the script
  // disambiguates them deterministically as '<base>·subA/B/C…' ordered by
  // descending community size — so 3 communities all labelled 'BrazilA'
  // become 'BrazilA·subA' / 'BrazilA·subB' / 'BrazilA·subC'.
  //
  // The full mapping is persisted as community_auto_annotations.tsv with
  // columns (community_id, size, primary_modal, primary_purity,
  // secondary_modal, secondary_purity, auto_label, manual_label).  Edits
  // to the manual_label column are preserved across re-runs (read in
  // before the new auto labels are written) — so the user can refine
  // 'BrazilA·subA' to project-specific identifiers like
  // 'BrazilA·quilombola_pal' and a subsequent -resume / REPLOT run picks
  // those labels up automatically.
  ibd_enhanced_plot_auto_annotate_by = ""
  // Optional secondary metadata column composed into the auto label as
  // '<primary>·<secondary>' BEFORE collision disambiguation.  Useful when
  // a single primary column maps multiple substructures to the same
  // value but a coarser column resolves them.  Example combination:
  //   primary='finestructure_clusters', secondary='finestructure_bigclusters'
  // → 'BrazilA·AM_1' / 'BrazilA·AM_2·subA' / 'BrazilA·AM_2·subB'.
  ibd_enhanced_plot_auto_annotate_secondary = ""
  // Force-directed repulsion of centroid labels in the static PNG via
  // adjustText.  Adds thin grey leader lines from the displaced label
  // back to its true centroid.  Off by default to keep PNGs reproducible
  // bit-for-bit; turn on for figures destined for the thesis manuscript
  // where label legibility matters.  Requires adjustText in the sif.
  ibd_enhanced_plot_adjust_labels = false
  // Categorical palette for community colours in the network UMAP and
  // related plots.  Default 'glasbey' = colorcet.glasbey_category10
  // (Glasbey 2007), CIELAB-distance-optimised 256-colour categorical
  // palette used by Bokeh/HoloViews — adjacent indices have max
  // perceptual contrast.  Requires colorcet (installed in
  // ~/python_extras, agregado automáticamente a sys.path).
  // Alternatives: 'distinctipy' (per-run CIELAB-maximising fit),
  // 'tab20' (20 alternating dark/light), 'journal' (legacy 24-hue,
  // backwards compatibility only), 'husl' (HUSL+golden shuffle).
  ibd_enhanced_plot_palette = "glasbey"
  // Additionally render a 3D Plotly UMAP per resolution next to the 2D
  // PNG/HTML (file: 'plots/network_umap_3d_res{r}.html').  Off by
  // default — adds ~2× UMAP fit time per resolution and ~5 MB per HTML
  // (plotly.min.js inlined for offline portability).  Turn on when 2D
  // overlap of admixed individuals obscures the cluster structure.
  ibd_enhanced_plot_umap_3d = false
  // Multi-metadata REPLOT — fan-out activated when this list is non-empty.
  // Comma-separated metadata column names; one parallel task per column,
  // each publishing to <results_dir>/replot_by_<column>/.  Re-uses the
  // compute outputs of IBD_COMMUNITY_ENHANCED — no graph/Leiden/NMF re-runs.
  // Example:  'Region,State,finestructure_bigclusters,Self_reported_race'
  ibd_enhanced_extra_color_columns = ""
  // Escape hatch: extra CLI args appended verbatim to the M16.5 invocation.
  // Useful for trying flags exposed by bin/ibd_community_enhanced.py that
  // are not yet wired into CLI_FLAG_MAP in modules/16_5_IBD_COMMUNITY_ENHANCED.nf.
  // Example:  --ibd_enhanced_extra_args '--my-experimental-flag value'
  ibd_enhanced_extra_args = ""

  // Optional keep-samples list derived from QC flags (module 06 output)
  use_keep_samples_from_qc = false //true: genera keep_samples.txt desde el QC del módulo 06 y lo pasa a módulos downstream (07,10,11)
                                  // false: usa conf/empty.txt y downstream no filtra muestras
  flags_tsv = "${params.outdir}/06_report/flags_per_sample.tsv"
  flag_fail_col = "flag_fail"
  sample_id_col = "IID"

  // SFS
  enable_sfs = false
  min_an_frac = 0.95
  rare_tail_max_ac = 20
  sfs_bins_af = "0,0.001,0.005,0.01,0.05,0.1,0.2,0.5,1.0"  // bins ALT-AF [0,1]; lo usa M09 (espectro DERIVADO, polariza por ancestral → puede ir 0..1)
  // M07 folded por defecto: el SFS plegado por alelo menor es lo interpretable sin
  // polarización (REF/ALT lo fija la referencia, no la biología).
  sfs_fold = true
  sfs_bins_maf = "0,0.001,0.005,0.01,0.05,0.1,0.2,0.5"     // bins MAF plegada [0,0.5] para M07 cuando sfs_fold=true

  // Ancestral / DAF / DSFS
  enable_build_ancestral_tsv = false
  enable_daf = false
  ancestral_fasta = "/scratch/datalake/trusted/genbr/genbr_bioinfo/projects/DNABR_QC/reference/ensembl_ancestral/homo_sapiens_ancestor_GRCh38.fa"
  allow_flip_if_ancestral_is_alt = true
  ancestral_accept_ambiguous = false

  // LD decay
  enable_ld = false
  ld_maf_min = 0.05            // LD se mide en comunes (MAF≥5%); los raros dan r² inestable
  ld_site_missing_max = 0.02
  ld_window_kb = 250           // El LD de admixtura reciente cae en <250 kb; esta ventana permite r2_min=0.
  ld_window = 999999
  // r2_min=0: ESCRIBE TODOS los pares. Un umbral >0 trunca la cola izquierda de r² por
  // bin de distancia → la curva de decay no cae a su baseline (~1/2N≈1.8e-4) sino que se
  // aplana en un piso falso y crea sesgo de selección dependiente de la distancia.
  ld_r2_min = 0.0
  // Thinning de sitios vía plink2 --bp-space N: filtro GREEDY que excluye el 2º de cada par
  // de variantes a <N bp (NO garantiza densidad uniforme — en racimos densos sobreviven más).
  // Acota el nº de pares para que r2_min=0 sea viable genome-wide sin sesgar la forma del decay
  // (propiedad de la DISTANCIA, no de la densidad). null = sin thinning. CALIBRAR en chr22 antes
  // de genome-wide: el I/O real en chr1/chr2 (densos) puede superar lo planificado.
  ld_thin_bp_space = 1000
  ld_bin_size_bp = 1000
  ld_max_dist_bp = 250000      // = ventana; el binner del decay no genera bins vacíos más allá del window
  exclude_regions_bed = "/scratch/datalake/trusted/genbr/genbr_bioinfo/projects/DNABR_QC/reference/exclude_regions_hg38/exclude_regions_hg38.bed"
  // Dónde se usa: main.nf (si existe se pasa a módulos 10/11 como --exclude range)
  // Efecto: excluye regiones (MHC etc.) solo si se provee el BED

  // Tag SNPs
  enable_tag_snps = false
  tag_maf_min = 0.05
  tag_site_missing_max = 0.02
  tag_window_kb = 50
  tag_step = 5
  tag_r2 = 0.2
  tag_r2_strict = 0.8

  // -------------------------------------------------------------------------
  // Módulo 22 — Pipeline de modelado (modeling_master → split → CV interna → TEST)
  // -------------------------------------------------------------------------
  // Integra en Nextflow el experimento train/test. TEST cerrado por
  // defecto: EVALUATE_TEST se ejecuta solo con doble llave explícita; la verificación
  // rutinaria del TEST congelado es por sha256 (VERIFY_TEST_HASH), sin reabrirlo.
  // Los inputs de datos NO tienen default (sin inferencias no sustentadas): se pasan explícitos.
  run_model_pipeline = false   // master switch (mismo patrón que run_qc/run_downstream)

  enable_build_modeling_master = false   // 22a BUILD_MODELING_MASTER (P0)
  enable_build_split_manifest  = false   // 22b BUILD_SPLIT_MANIFEST (split congelado)
  enable_model_primary_cv      = false   // 22c MODEL_PRIMARY_CV (validación interna, solo TRAIN)
  enable_evaluate_test         = false   // 22d EVALUATE_TEST — TEST CERRADO; SIEMPRE false salvo autorización
  enable_verify_test_hash      = false   // 22e VERIFY_TEST_HASH — solo integridad sha256 del TEST congelado

  model_pipeline_results_dir = "${params.outdir}/22_model_pipeline"

  // --- inputs de BUILD_MODELING_MASTER (artefactos YA existentes; ninguno se recalcula) ---
  model_pipeline_feature_store_tsv = null   // 20_feature_store/feature_store.tsv (M20)
  model_pipeline_leiden_tsv        = null   // leiden_assignments.tsv (M16.5)
  model_pipeline_graph_nodes_tsv   = null   // graph_nodes.tsv (M16.5)
  model_pipeline_pcrelate_kin_tsv  = null   // dnabr.pcrelate.kin.tsv (PC-Relate)
  model_pipeline_metadata_file     = null
  model_pipeline_red_samples       = null   // 6 QC-rojas separadas por comas; sin default (sin inferencias no sustentadas)

  model_pipeline_kinship_thresholds      = "0.0221,0.0442,0.0884,0.1770"  // 4to,3ro,2do,1er grado (Manichaikul 2010)
  model_pipeline_kinship_group_columns   = "0.0442,0.0884"
  model_pipeline_replicate_threshold     = 0.354   // banda KING dup/MZ
  model_pipeline_leiden_col_for_crosstab = "community_res_1"

  // --- BUILD_SPLIT_MANIFEST ---
  model_pipeline_group_col     = "kinship_group_id_phi0442"
  model_pipeline_community_col = "community_res_1"
  model_pipeline_n_splits      = 5
  model_pipeline_seed          = 42

  // --- MODEL_PRIMARY_CV ---
  model_pipeline_n_perm = 200   // permutaciones del null ancestry-stratified

  // --- EVALUATE_TEST (TEST cerrado — cada param aquí es una puerta, no un default de conveniencia) ---
  model_pipeline_candidate_model            = "logreg"  // debe==candidato pre-declarado en cv_results.json
  model_pipeline_force_evaluate_test        = false     // re-evaluar pese a existir resultado; requiere reason
  model_pipeline_force_evaluate_test_reason = null      // texto obligatorio si force=true (auditable)

  // --- VERIFY_TEST_HASH (solo hash — nunca reabre TEST) ---
  model_pipeline_frozen_test_json   = null   // ruta ABSOLUTA al evaluate_test_results.json congelado; sin default
  model_pipeline_frozen_test_sha256 = null  // archivo externo con el hash esperado

  // -------------------------------------------------------------------------
  // Módulo 23 — Benchmark de la matriz rara individuo×variante (recuperabilidad técnica)
  // -------------------------------------------------------------------------
  // Diseño reducido. La fuente exacta de la etiqueta es:
  // results_modtest_mac2/lai_rare (raras MAC≥2, biallelic, FORMAT=GT). El fold 3 (TEST) NUNCA se
  // decodifica: la extracción pasa solo IDs de TRAIN a `bcftools query -S`. Esta etapa cubre la
  // extracción sparse por cromosoma + el SMOKE TÉCNICO en chr22 (sin CV, sin grilla, sin métricas
  // científicas). Los inputs de datos NO tienen default (sin inferencias no sustentadas).
  run_rare_bench = false   // master switch

  enable_rare_bench_extract = false   // 23a EXTRACT_RARE_MATRIX_CHR (matriz sparse por cromosoma)
  enable_rare_bench_smoke   = false   // 23b RARE_BENCH_SMOKE (smoke técnico chr22, etiqueta permutada)
  enable_rare_bench_concat  = false   // 23c CONCAT_RARE_MATRIX (matriz genoma-completa de los 22)
  enable_rare_bench_cv      = false   // 23d RARE_BENCH_CV (benchmark científico: CV anidada, sets A-E, E-C)

  rare_bench_results_dir = "${params.outdir}/23_rare_matrix_benchmark"

  // --- inputs de datos (sin default; se pasan explícitos) ---
  rare_bench_rare_vcf_dir  = null   // dir con dnabr.hg38.2723.chr*.rare.vcf.gz (results_modtest_mac2/lai_rare)
  rare_bench_split_manifest = null  // split_manifest.tsv congelado (M22): columnas sample_id/split/y/fold/split_group_key
  rare_bench_modeling_master = null // modeling_master.tsv (M22): sets A=Q+sexo y B=burden para la CV
  rare_bench_vcf_prefix    = "dnabr.hg38.2723"   // prefijo del nombre de archivo por cromosoma
  rare_bench_chromosomes   = "22"   // lista de cromosomas (extract/concat); "1,2,...,22" para genoma

  // --- roles de columna del split_manifest ---
  rare_bench_sample_id_col = "sample_id"
  rare_bench_split_col     = "split"
  rare_bench_label_col     = "y"
  rare_bench_fold_col      = "fold"              // fold congelado {0,1,2,4}=TRAIN, 3=TEST
  rare_bench_group_col     = "split_group_key"   // componente de parentesco φ̂≥0.0442 (grupo de CV)
  rare_bench_train_label   = "TRAIN"
  rare_bench_test_label    = "TEST"   // PROHIBIDO: nunca se decodifica del VCF
  rare_bench_test_fold     = 3        // fold de TEST: excluido de toda la CV (fail-closed)

  // --- regla fold-fitted de retención de variantes (defaults justificados; parametrizables) ---
  rare_bench_min_mac_train          = 2      // átomo M14 (doubletons compartibles)
  rare_bench_min_alt_carriers_train = 2      // ≥2 individuos distintos portadores (condición de co-sharing)
  rare_bench_max_missing_train      = 0.10   // call-rate ≥90% en train (plink --geno 0.1)
  rare_bench_min_variance_train     = 0.0    // descarta solo columnas monomórficas tras el split del fold

  // --- smoke técnico: fit único SAGA con etiqueta permutada (sin ciencia) ---
  rare_bench_smoke_c        = 0.01   // C fijo del smoke técnico
  rare_bench_smoke_l1_ratio = 0.5    // l1_ratio fijo del smoke técnico
  rare_bench_smoke_max_iter = 1000
  rare_bench_smoke_tol      = 1e-4
  rare_bench_seed           = 42

  // --- benchmark científico con validación cruzada anidada y agrupada ---
  rare_bench_c_grid            = "1e-3,1e-2,1e-1,1"  // shrinkage fuerte→moderado (p≫n)
  rare_bench_l1_ratios         = "0.1,0.5,0.9"       // ridge→lasso; 3×4=12 combinaciones
  rare_bench_inner_splits      = 3                   // StratifiedGroupKFold interior (selección hiperparám.)
  rare_bench_inner_scorer      = "balanced_accuracy" // alineado al endpoint primario
  rare_bench_decision_threshold = 0.5                // umbral fijo (no se tunea; evita knob/fuga extra)
  rare_bench_class_weight      = "balanced"          // logística balanceada (prevalencia ~0.25)
  rare_bench_run_svd           = false               // comparador SVD desactivado; ejecuta solo Elastic Net
  rare_bench_svd_components    = 50                  // TruncatedSVD (secundario, solo si run_svd=true)
  rare_bench_cv_max_iter       = 1000                // saga / lbfgs
  rare_bench_cv_tol            = 1e-4
  rare_bench_concat_time       = "4h"                // ceiling del concat (hstack de 22 CSC, minutos); acotado para el presupuesto del wrapper
  rare_bench_cv_time           = "36h"               // (legacy) ceiling del CV monolitico; el particionado usa los times de abajo

  // --- CV particionado por (set,fold) para permitir la reanudación de cada tarea ---
  rare_bench_cv_heavy_sets     = "D_matrix_elasticnet,E_full_elasticnet"  // sets pesados: 1 tarea por (set,fold); deben coincidir con HEAVY_SETS del script
  rare_bench_cv_folds          = "0,1,2,4"           // outer-folds TRAIN; el agregador exige exactamente estos (fail-closed)
  rare_bench_cv_light_time     = "2h"                // límite para preflight, abc y aggregate
  rare_bench_cv_fold_time      = "18h"               // límite base para una tarea pesada (set,fold)
  // Copias/intermedios por worker en el paralelismo de GridSearchCV. n_jobs=8 (antes 16) + pre_dispatch=8 (antes 2*n_jobs=16)
  // acotan cuántas copias e intermedios mantiene loky en memoria.
  // Estos parámetros no entran en la huella científica y no invalidan resultados por sí solos.
  rare_bench_cv_n_jobs         = 8                   // workers de loky para GridSearchCV (<= cpus de la tarea)
  rare_bench_cv_pre_dispatch   = "8"                 // tareas pre-despachadas a la vez (int o expr 'N*n_jobs'); acota el pico de RAM del paralelismo
  // Retry prudente por (set,fold): params en conf/auto_resources.config (rare_bench_cv_fold_max_retries /
  // _retry_memory / _retry_time), junto al bloque withName que los consume. Ahi se documenta la limitacion
  // OOM/TIMEOUT-indistinguibles que obliga al reintento unico que sube memoria Y tiempo a la vez, y el remapeo
  // del OOM-en-worker-loky (exit 42) a codigo reintentable.
  // Con maxForks=8, los ocho folds se ejecutan en una tanda. El peor caso estimado
  // es de 48 horas más las etapas ligeras.
}

workDir = params.workdir ?: "/scratch/${System.getenv('USER')}/dnabr_qc_work"

process {
  // Robustez ante kills EXTERNOS transitorios (preempción en nodos compartidos cpu+gpu como
  // gpu2, o timeout de lectura del .exitcode por latencia del FS /scratch/.../transient):
  // exitStatus null = job matado sin escribir código de salida. Esos se reintentan; un error
  // REAL del comando (exit>0: OOM 137, params malos, etc.) NO se reintenta → termina rápido.
  // Los trabajos terminados externamente sin código de salida pueden reintentarse.
  errorStrategy = { (task.exitStatus == null) && task.attempt <= params.max_retries ? 'retry' : 'terminate' }
  maxRetries = params.max_retries
  container = params.container_image
  cpus = params.cpus
  memory = params.memory
  time = params.time
}

profiles {
  slurm_singularity {
    singularity.enabled = true
    singularity.autoMounts = true
    // Nextflow auto-bind-mounts only the working/staged paths under
    // /scratch and the project tree; it also passes --no-home.  Add
    // explicit bind for project-local Python extras (colorcet,
    // distinctipy etc. installed via pip --target) so the container
    // sees them at the same path the script's sys.path.insert expects.
    // Keep this list small — every -B widens the trust boundary.
    singularity.runOptions = "-B ${System.getenv('HOME')}/python_extras"
    process.executor = 'slurm'
    workDir = params.workdir

    // Sube el timeout de lectura del .exitcode (default 270s). En el FS compartido de Aesop
    // (/scratch/.../transient) la latencia de aparición del .exitcode bajo carga (decenas de
    // jobs cortos a la vez) excedía 4.5 min → Nextflow declaraba 'terminated by external system'
    // en masa. Veinte minutos absorben los picos de latencia del sistema de archivos.
    executor.exitReadTimeout = '20 min'
    // Cap de jobs Slurm simultáneos del workflow. Los módulos QC tienen maxForks=null →
    // someten el canal completo de golpe (~40 jobs), saturando el scheduler y la aparición
    // de .exitcode en el FS (causa del spike de latencia de arriba). 24 suaviza la ráfaga sin
    // perder paralelismo útil para trabajos cortos.
    executor.queueSize = 24

    process.queue = params.slurm_queue

    process.clusterOptions = [
      params.slurm_account ? "--account=${params.slurm_account}" : null,
      params.slurm_qos ? "--qos=${params.slurm_qos}" : null
    ].findAll{ x -> x }.join(' ')
  }
}

// Include resource configuration
includeConfig 'conf/auto_resources.config' 
