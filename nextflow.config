params {
  vcf_dir = "/mnt/d/ega/DNABR/raw/decrypted"
  ref_fasta = "/mnt/d/ega/DNABR/ref/hg38_ucsc/Homo_sapiens_assembly38.fasta"
  outdir = "/mnt/d/ega/DNABR/stats/dnabr_qc"

  workdir = null

  // ---- Per-module enable switches (QC core: 01-06) ----
  // Set run_qc=true to run all 01-06 from raw VCFs (default full pipeline).
  // Set run_qc=false and enable individual modules to re-run from outdir.
  run_qc = true
  enable_norm        = true   // 01: bcftools norm + left-align
  enable_filter      = true   // 02: filter SNV biallelic PASS
  enable_bcfstats    = true   // 03: bcftools stats
  enable_pgen        = true   // 04: plink2 make-pgen
  enable_missing_het = true   // 05: plink2 missing + het QC
  enable_report      = true   // 06: aggregate QC report

  keep_pass = true
  max_missing_site = 0.05
  sample_missing_fail = 0.05
  het_sd_fail = 3
  plink_mac_min = 1
  plink_snps_only = true
  plink_max_alleles = 2

  chr_regex = "dnabr\\.hg38\\.2723\\.chr(\\d+|X|Y|MT)\\.vcf\\.gz"


  cpus = 4
  memory = "16 GB"
  time = "4h"

  slurm_queue = null
  slurm_account = null
  slurm_qos = null

  container_image = "dnabr-qc:latest"

  // -----------------------------
  // Downstream modules 07+ (population genetics)
  // -----------------------------
  run_downstream = false
  downstream_from_outdir = true

  filtered_vcf_regex = 'dnabr\\.hg38\\.2723\\.chr(\\d+|X|Y|MT)\\.snv\\.bi\\.pass\\.vcf\\.gz$'
  require_filtered_tbi = true

  pgen_regex = 'dnabr\\.hg38\\.2723\\.chr(\\d+|X|Y|MT)\\.pgen$'
  require_pgen_pvar_psam = true

  // Optional keep-samples list derived from QC flags (module 06 output)
  use_keep_samples_from_qc = false
  flags_tsv = "${params.outdir}/06_report/flags_per_sample.tsv"
  flag_fail_col = "flag_fail"
  sample_id_col = "IID"

  // SFS
  enable_sfs = false
  min_an_frac = 0.95
  rare_tail_max_ac = 20
  sfs_bins_af = "0,0.001,0.005,0.01,0.05,0.1,0.2,0.5,1.0"

  // Ancestral / DAF / DSFS
  enable_build_ancestral_tsv = false
  enable_daf = false
  ancestral_fasta = "/mnt/d/ega/DNABR/meta/ancestral_alleles/homo_sapiens_ancestor_GRCh38.allchr.fa"
  allow_flip_if_ancestral_is_alt = true
  ancestral_accept_ambiguous = false

  // LD decay
  enable_ld = false
  ld_maf_min = 0.05
  ld_site_missing_max = 0.02
  ld_window_kb = 1000
  ld_window = 999999
  ld_r2_min = 0.2
  ld_bin_size_bp = 1000
  ld_max_dist_bp = 1000000
  exclude_regions_bed = "/mnt/d/ega/DNABR/meta/exclude_regions_hg38.bed"

  // Tag SNPs
  enable_tag_snps = false
  tag_maf_min = 0.05
  tag_site_missing_max = 0.02
  tag_window_kb = 50
  tag_step = 5
  tag_r2 = 0.2
  tag_r2_strict = 0.8
}

workDir = params.workdir ?: "/mnt/d/ega/DNABR/tmp/nxf_work"

process {
  errorStrategy = 'terminate'
  container = params.container_image
  cpus = params.cpus
  memory = params.memory
  time = params.time
}

profiles {
  local_docker {
    docker.enabled = true
    process.executor = 'local'
  }

  local_singularity {
    singularity.enabled = true
    singularity.autoMounts = true
    process.executor = 'local'
  }

  slurm_singularity {
    singularity.enabled = true
    singularity.autoMounts = true
    process.executor = 'slurm'
    workDir = "/scratch/${System.getenv('USER')}/dnabr_qc_work"

    process.queue = params.slurm_queue

    process.clusterOptions = [
      params.slurm_account ? "--account=${params.slurm_account}" : null,
      params.slurm_qos ? "--qos=${params.slurm_qos}" : null
    ].findAll{ x -> x }.join(' ')
  }
}

// Include resource configuration
includeConfig 'conf/auto_resources.config'
