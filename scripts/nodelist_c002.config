// Configuración usada para la corrida de M23 del 23 de julio de 2026. El datalake
// /scratch/datalake está montado en c002, por eso el controlador y las tareas se fijan en ese nodo.
// Este archivo se pasa como el último -c para que tenga prioridad sobre clusterOptions del perfil.
process.clusterOptions = '--nodelist=c002'
