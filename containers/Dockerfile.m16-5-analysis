FROM us-central1-docker.pkg.dev/uspbr-242713/dnabr-lai/dnabr-qc@sha256:883fdadc1f951edc335c1f394d5a00958411dcd04a95d65334c6ce80e7b5d53d

LABEL org.opencontainers.image.title="dnabr-qc-m16-5-analysis" \
      org.opencontainers.image.description="Pinned M16.5 graph, clustering and plotting dependencies for dnaBr-lai" \
      org.opencontainers.image.source="https://github.com/jfct777/lai-exploracion-datos"

# M16.5 uses SciPy from the pinned M14 image and adds the exact graph,
# clustering, UMAP and plotting stack at image-build time. Batch jobs never
# install packages at runtime.
RUN python3 -m pip install --no-cache-dir --break-system-packages \
      scikit-learn==1.8.0 \
      python-igraph==0.11.9 \
      leidenalg==0.10.2 \
      umap-learn==0.5.11 \
      seaborn==0.13.2 \
      adjustText==1.3.0 \
    && python3 -c "import importlib.metadata as m; import adjustText, igraph, leidenalg, numpy, pandas, scipy, seaborn, sklearn, umap; print(numpy.__version__, pandas.__version__, scipy.__version__, sklearn.__version__, igraph.__version__, m.version('leidenalg'), umap.__version__)"
