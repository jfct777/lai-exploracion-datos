Bootstrap: docker
From: etherium/dnabr-qc:27-01-2026

%labels
    Maintainer Proyecto DNABR
    Description DNABR QC image extended minimally for Nextflow monitoring features requiring ps

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends procps
    apt-get clean
    rm -rf /var/lib/apt/lists/*

%test
    command -v ps
    python3 -c "import pandas, numpy, matplotlib"
