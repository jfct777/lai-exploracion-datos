params {
  m32_pack_preregistration = "${baseDir}/../conf/m32_packed_benchmark_preregistration.json"
  m32_pack_results_dir = "${baseDir}/../results/32_packed_benchmark"
  m32_pack_run_id = null
  m32_pack_git_commit = null
  m32_pack_genetic_map = null
  m32_pack_root17_grid = null
  m32_pack_root17_rare = null
  m32_pack_root17_sites = null
  m32_pack_root17_target = null
  m32_pack_root17_tree = null
  m32_pack_root17_pools = null
  m32_pack_root17_flare_vcf = null
  m32_pack_root18_grid = null
  m32_pack_root18_rare = null
  m32_pack_root18_sites = null
  m32_pack_root18_target = null
  m32_pack_root18_tree = null
  m32_pack_root18_pools = null
  m32_pack_root18_flare_vcf = null
  m32_pack_container_image = 'sha256:2c30d018028636ac1b7a4890641e04b3e15be8c79d991dfade35b90db0e17bd1'
  m32_pack_container_options = '--network none --memory 8g'
  m32_pack_expected_memory_bytes = 8589934592
  m32_pack_cpus = 2
  m32_pack_memory = '8 GB'
  m32_pack_time = '1h'
