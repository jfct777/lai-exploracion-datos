params {
    // Explicit modes: plan is local validation; smoke uses synthetic data; train fails without a receipt.
    m36_cora_mode = 'plan'
    // A real materialization must provide a unique run namespace explicitly.
    // Keeping UNSET fail-closed prevents accidental re-publication of a prior run.
    m36_cora_run_id = 'UNSET'
    m36_cora_synthetic_smoke = false
    m36_cora_materialization_receipt = ''
    m36_cora_loci = ''
    m36_cora_carriers = ''
    m36_cora_missing = ''
    m36_cora_feature_chrom = 'chr22'
    m36_cora_events = 'tests/fixtures/m36_cora_events.tab'
    m36_cora_covariates = 'tests/fixtures/m36_cora_covariates.tab'
    m36_cora_components = 'tests/fixtures/m36_cora_components.tab'
    m36_cora_targets = 'tests/fixtures/m36_cora_external_targets.tab'
    // Set Transformer is opt-in because the initial benchmark is capacity-matched Deep Sets.
    m36_cora_model_families = 'deep_sets'
    m36_cora_halving_budgets = '32,128'
    m36_cora_halving_eta = 2
    m36_cora_n_folds = 3
    m36_cora_seed = 1701
    m36_cora_train_seeds = '1701'
    m36_cora_bootstrap_reps = 100
    m36_cora_positive_min_relative_mse_reduction = 0.10
    m36_cora_cpus = 1
    m36_cora_memory = '1 GB'
    m36_cora_time = '10m'
    // Measured host envelope: 8 CPUs / 31 GiB RAM; the real sparse chr22
    // smoke remains local and bounded below this availability.
    m36_cora_train_cpus = 4
    m36_cora_train_memory = '16 GB'
    m36_cora_train_time = '6h'
    m36_cora_pytorch_image = 'us-central1-docker.pkg.dev/uspbr-242713/dnabr-lai/m33-t0a@sha256:c03864a9ed0c56b00fd1a234daee2d17ddfa57d4c426628bd59cd9daf351ee99'
    // Canonical read-only sources; no M14 output is used as truth.
    m36_cora_rare_vcf = 'gs://projects-usp/dnaBr-lai/datalake/refined/DNABR_QC/results_modtest_mac2/lai_rare/dnabr.hg38.2723.chr22.rare.vcf.gz'
    m36_cora_locus_metadata = ''
    m36_cora_genetic_map = 'gs://projects-usp/dna-do-brasil/dnabr-lai-gnomix/maps/genetic.map.chr22'
    m36_cora_sample_metadata = '' // generated by m36_cora_canonical_adapter.py
    m36_cora_pcrelate_components = '' // generated from canonical modeling master phi>=0.0442 groups
    m36_cora_asibd_manifest = "${baseDir}/../conf/m36_cora_asibd_manifest.tab"
    m36_cora_asibd_segments = 'gs://projects-usp/dna-do-brasil/dnabr-ibd/combined/anc*.gapfilled_ibd'
    m36_cora_zero_negative_ratio = 1
    // Zero-inflation sensitivity: chain train uses 1:1; 3:1 and 5:1 are held as matched sparse target tables.
    m36_cora_zero_negative_ratios = '1,3,5'
    m36_cora_max_positives_per_stratum = 2000
    m36_cora_materialize_output_dir = "gs://teams-usp/frank/lai-exploracion-datos/runs/${params.m36_cora_run_id}/m36_cora_set/"
    m36_cora_materialize_cpus = 2
    m36_cora_materialize_memory = '8 GB'
    m36_cora_materialize_time = '4h'
    m36_cora_canonical_metadata = 'gs://projects-usp/dnaBr-lai/datalake/trusted/DNABR_QC/metadata/metadata_cleaned.txt'
    m36_cora_m20_feature_store = 'gs://projects-usp/dnaBr-lai/datalake/refined/DNABR_QC/20_feature_store/20_feature_store/feature_store.tsv'
    m36_cora_modeling_master = 'gs://projects-usp/dnaBr-lai/datalake/refined/DNABR_QC/model_pipeline_canonical/22_model_pipeline/modeling_master/modeling_master.tsv'
}

docker {
    enabled = true
    // The pinned image runs as a non-host user; the isolated local work dir
    // must be writable for its synthetic smoke outputs.
    runOptions = '--user 0:0'
}

process {
    withName: 'M36_CORA_SET_PLAN' {
        executor = 'local'
        errorStrategy = 'terminate'
    }
    withName: 'M36_CORA_SET_TRAIN' {
        executor = 'local'
        errorStrategy = 'terminate'
    }
}
