params {
  m28b_v2_tree_sequence = null
  m28b_v2_pool_manifest = null
  m28b_v2_genetic_map = null
  m28b_v2_baseline_template = null
  m28b_v2_m28_preregistration = "${baseDir}/../conf/m28_lai_simulation_preflight_preregistration.json"
  m28b_v2_preregistration = "${baseDir}/../conf/m28b_lai_marker_capacity_preregistration.v2.json"
  m28b_v2_results_dir = "${baseDir}/../results/28b_lai_joint_capacity_audit"
  m28b_v2_container_image = "dnabr-m28-lai-sim:0.1.1"
  m28b_v2_container_digest = "sha256:1f08736aa2750eac4ab8fb0506fb22bad91d2266b7b02b9e35d971f554b807f7"
  // Set DNABR_CONTAINER_OPTIONS='--user <uid>:<gid>' on shared Docker hosts.
  m28b_v2_container_options = System.getenv('DNABR_CONTAINER_OPTIONS') ?: ''
  // V1 measured 508.9 MB RSS and 4m28s on these exact inputs.
  m28b_v2_cpus = 1
  m28b_v2_memory = "4 GB"
  m28b_v2_time = "30m"
}

docker.enabled = true

process {
  executor = 'local'
  errorStrategy = 'terminate'
  maxRetries = 0
}
