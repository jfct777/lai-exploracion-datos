plugins {
  id 'nf-google@1.27.3'
}

params {
  // ConfigParser v2 solo admite asignaciones declarativas en archivos de
  // configuración. Las validaciones de estos valores viven en el workflow.
  m34_batch_region = System.getenv('DNABR_CLOUD_REGION') ?: 'us-central1'
  m34_batch_root = 'gs://teams-usp/frank/lai-exploracion-datos'
  m34_inputs_run_id = System.getenv('DNABR_RUN_ID')
  // El workflow añade el run_id y separa models/ de metrics/ debajo de esta raíz.
  m34_inputs_results_dir = "${params.m34_batch_root}/runs"
  m34_inputs_pytorch_image = (
    'us-central1-docker.pkg.dev/uspbr-242713/dnabr-lai/' +
    'm33-t0a@sha256:c03864a9ed0c56b00fd1a234daee2d17ddfa57d4c426628bd59cd9daf351ee99'
  )
  // El volumen localizado de Batch pertenece al runtime efímero. Ejecutar como
  // root evita depender del UID de la VM; el contenedor continúa sin red.
  m34_inputs_container_user = '0:0'

  m34_inputs_train_cpus = 4
  m34_inputs_train_memory = '8 GB'
  m34_inputs_train_max_forks = 4
  m34_inputs_train_device = 'cpu'

  m34_inputs_score_cpus = 1
  m34_inputs_score_memory = '4 GB'
  m34_inputs_score_max_forks = 4
}

workDir = "${params.m34_batch_root}/work/nextflow/${params.m34_inputs_run_id}"

// Google Batch ejecuta directamente la imagen del proceso; no se anida Docker
// dentro de la VM de trabajo.
docker.enabled = false

process {
  executor = 'google-batch'
  container = params.m34_inputs_pytorch_image
  disk = '20 GB'
  maxForks = 4
  errorStrategy = 'terminate'
  maxRetries = 0
  resourceLabels = [team: 'frank']

  withName: 'M34_NAM_TRAIN_FACTORIZED' {
    cpus = 4
    memory = '8 GB'
  }
  withName: 'M34_NAM_TRAIN_TRANSFORMER_FACTORIZED' {
    cpus = 4
    memory = '8 GB'
  }
  withName: 'M34_NAM_SCORE_VALID' {
    cpus = 1
    memory = '4 GB'
  }
}

// queueSize es el límite global: nunca habrá más de cuatro tareas Batch en vuelo.
executor.queueSize = 4

google {
  project = 'uspbr-242713'
  location = params.m34_batch_region
  batch {
    // Batch crea una VM por tarea y la elimina al terminar; no se mantienen VM o discos ociosos.
    spot = false
    maxSpotAttempts = 0
  }
}
