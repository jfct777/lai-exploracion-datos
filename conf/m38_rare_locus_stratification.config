plugins {
  id 'nf-google@1.27.3'
}

params {
  m38_run_id = 'm38-r0-rare-locus-stratification-20260903a'
  m38_batch_root = 'gs://teams-usp/frank/lai-exploracion-datos'
  m38_results_dir = "${params.m38_batch_root}/runs"
  m38_region = System.getenv('DNABR_CLOUD_REGION') ?: 'us-central1'
  m38_container_digest = 'us-central1-docker.pkg.dev/uspbr-242713/dnabr-lai/m33-t0a@sha256:c03864a9ed0c56b00fd1a234daee2d17ddfa57d4c426628bd59cd9daf351ee99'

  // All four inputs are immutable products of the M34 R0 REF_TRAIN lane.
  m38_selected_loci = 'gs://teams-usp/frank/lai-exploracion-datos/runs/m34-nam-128-r0-20260827a/fit/bridge/m34_fit_bridge/m34_selected_loci.npz'
  m38_reference_summary = 'gs://teams-usp/frank/lai-exploracion-datos/runs/m34-nam-128-r0-20260827a/fit/bridge/m34_fit_bridge/m34_reference_rare_summary.npz'
  m38_audit_tsv = 'gs://teams-usp/frank/lai-exploracion-datos/runs/m34-nam-128-pre-20260827a/m34_rare_loci.audit.tsv'
  m38_audit_summary = 'gs://teams-usp/frank/lai-exploracion-datos/runs/m34-nam-128-pre-20260827a/m34_rare_loci.audit.summary.json'
  m38_selected_sha256 = '0bdf50d6812abf3d74975774f1a7257b52c3c263822e8aeaa59cd673c5c31fd0'
  m38_reference_sha256 = '47502fa4697d2d1f88ea526bcaf1dd7fe49e6aa13b404c85d6d1d741a6af2fc9'
  m38_audit_tsv_sha256 = '71f808867c6da79d214b6eae89966d4b8256ef03551d3e8edde897f990ba4eab'
  m38_audit_summary_sha256 = 'fe80aeb434da0076981450de503b320c2c717c02538241db80ab1f6b310309d5'

  m38_expected_loci = 660
  m38_expected_ancestry_an = 'AFR=682,EUR=774,NAM=50'
  m38_beta_priors = '0.5,1.0'
  m38_rare_af_cutoff = 0.01
  m38_q_top_thresholds = '0.8,0.9,0.95'
  m38_q_rare_thresholds = '0.5,0.8,0.95'
  m38_unit_thresholds = '2,3'
  // 131072 draws bound the worst binomial Monte Carlo SE below 0.0014.
  m38_q_top_draws = 131072
  m38_seed = 3801103
  m38_f0_contains_selected_rare_loci = true
  m38_f0_overlap_assertion_source = 'M34_FLARE_CONTRACT_COMPLETE_SNV_REF_MAC_GE_1'

  m38_cpus = 2
  m38_memory = '4 GB'
  m38_time = '30m'
}

workDir = "${params.m38_batch_root}/work/nextflow/${params.m38_run_id}"
docker.enabled = false

process {
  executor = 'google-batch'
  container = params.m38_container_digest
  containerOptions = '--network none --user 0:0'
  disk = '10 GB'
  errorStrategy = 'terminate'
  maxRetries = 0
  resourceLabels = [team: 'frank', lane: 'm38-stratification']
}

google {
  project = 'uspbr-242713'
  location = params.m38_region
  batch {
    spot = false
    maxSpotAttempts = 0
  }
}
