// Resultados NUEVOS únicamente. No copia ni reubica corridas anteriores.
// main.nf conserva la sintaxis Groovy: ejecutar con NXF_SYNTAX_PARSER=v1.
// Se añade mediante -c conf/presentation.config --presentation_run_id <id-unico>.
// Familia/etapa son optativas, pero deben proporcionarse juntas; sin ellas se
// conserva presentacion/<categoria>/<run_id> para compatibilidad histórica.
params.presentation_category = params.presentation_category ?: 'smokes'
params.presentation_run_id = params.presentation_run_id ?: null
// ConfigObject puede devolver [:] al leer una clave ausente: comprobar presencia
// antes de leerla y no convertir cadenas vacías explícitas en ausencia.
params.presentation_family_id = params.containsKey('presentation_family_id') ? params.presentation_family_id : null
params.presentation_stage_id = params.containsKey('presentation_stage_id') ? params.presentation_stage_id : null
if (!(params.presentation_category in ['smokes', 'biologico'])) {
    throw new IllegalArgumentException('presentation_category debe ser smokes o biologico')
}
def hasPresentationFamily = params.presentation_family_id != null
def hasPresentationStage = params.presentation_stage_id != null
if (hasPresentationFamily != hasPresentationStage) {
    throw new IllegalArgumentException('presentation_family_id y presentation_stage_id deben definirse juntas')
}
def presentationNames = [presentation_run_id: params.presentation_run_id]
if (hasPresentationFamily) {
    presentationNames.presentation_family_id = params.presentation_family_id
    presentationNames.presentation_stage_id = params.presentation_stage_id
}
presentationNames.each { name, value ->
    if (value == null || !(value.toString() ==~ /[A-Za-z0-9][A-Za-z0-9_-]{0,127}/)) {
        throw new IllegalArgumentException("${name} debe ser un nombre simple seguro de 1 a 128 caracteres; no reutilizar una corrida anterior")
    }
}
def presentationParts = [params.presentation_category]
if (hasPresentationFamily) presentationParts.addAll([params.presentation_family_id, params.presentation_stage_id])
presentationParts.add(params.presentation_run_id)
// biologico identifica análisis científicos, incluidos resultados negativos;
// no certifica significancia estadística ni validación independiente.
def presentationRoot = "gs://projects-usp/dnaBr-lai/datalake/refined/DNABR_QC/presentacion/${presentationParts.join('/')}"
// Sólo destinos de escritura; no cambia entradas, genotipos fuente ni workdir.
// Para entrypoints adicionales comprobar sus publishDir al preparar la corrida.
params.outdir = presentationRoot
params.rare_tract_results_dir = "${presentationRoot}/12_rare_snp_tracts"
params.distance_mode_results_dir = "${presentationRoot}/13_individual_snp_distance_modes"
params.painting_results_dir = "${presentationRoot}/14_rare_allele_sharing_painting"
// Ambos entrypoints M14 publican sus carpetas segment_views/sensitivity/relatedness.
params.m14_followup_results_dir = presentationRoot
params.ibd_enhanced_results_dir = "${presentationRoot}/16_5_ibd_community_enhanced"
params.rare_in_lai_results_dir = "${presentationRoot}/17_rare_in_lai_tracts"
params.asibd_results_dir = "${presentationRoot}/18_common_asibd_comparator"
params.rare_on_lai_results_dir = "${presentationRoot}/19_rare_on_lai_painting"
params.feature_build_results_dir = "${presentationRoot}/20_feature_store"
params.presence_channel_results_dir = "${presentationRoot}/21_presence_channel"
params.model_pipeline_results_dir = "${presentationRoot}/22_model_pipeline"
params.rare_bench_results_dir = "${presentationRoot}/23_rare_matrix_benchmark"
params.allele_orientation_audit_results_dir = "${presentationRoot}/24_rare_allele_orientation_audit"
params.allele_orientation_inventory_results_dir = "${presentationRoot}/24_rare_allele_orientation_inventory"
params.rare_window_features_results_dir = "${presentationRoot}/25_rare_window_features"
params.rare_window_pca_results_dir = "${presentationRoot}/25b_rare_window_pca"
params.rare_window_scale_results_dir = "${presentationRoot}/25c_rare_window_scale_sensitivity"
params.m16_target_audit_results_dir = "${presentationRoot}/26_m16_target_viability"
params.lai_pilot_preflight_results_dir = "${presentationRoot}/27_lai_pilot_preflight"
params.rare_scaffold_bridge_results_dir = "${presentationRoot}/27b_rare_scaffold_bridge"
params.targeted_gvcf_results_dir = "${presentationRoot}/27c_targeted_gvcf_readiness"
params.donor_kinship_results_dir = "${presentationRoot}/27d_donor_kinship_audit"
params.ibd_rare_transfer_results_dir = "${presentationRoot}/27e_ibd_rare_transfer"
params.m27f_split_results_dir = "${presentationRoot}/27f_blind_split"
params.m27f_support_results_dir = "${presentationRoot}/27f_ref_valid_support"
