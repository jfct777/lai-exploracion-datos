params {
  // Contract-only: no scientific asset URI is accepted by this workflow.
  m33_asset_execution_asset_contract = "${baseDir}/../conf/m33_asset_manifest_contract.json"
  m33_asset_execution_amendment = "${baseDir}/../conf/m33_asset_execution_amendment.json"
  m33_asset_execution_results_dir = "${baseDir}/../results/33_asset_execution_contract"
  m33_asset_execution_run_id = null
  m33_asset_execution_git_commit = null
}

process {
  executor = 'local'
  errorStrategy = 'terminate'
  maxRetries = 0
  maxForks = 1
}
