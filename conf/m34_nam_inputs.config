params {
  m34_inputs_run_id = null
  m34_inputs_results_dir = null
  m34_inputs_phased_vcf = null
  m34_inputs_split_tsv = null
  m34_inputs_genetic_map = null
  m34_inputs_flare_jar = null
  m34_inputs_experiment_contract = null
  m34_inputs_experiment_contract_sha256 = '920d19a7401830ec00ca2364e5175710af5202cc9dd8bf3512a254cbcaa18970'
  m34_inputs_adaptive_contract = null

  m34_inputs_pytorch_image = 'us-central1-docker.pkg.dev/uspbr-242713/dnabr-lai/m33-t0a@sha256:c03864a9ed0c56b00fd1a234daee2d17ddfa57d4c426628bd59cd9daf351ee99'
  m34_inputs_tabix_image = 'us-central1-docker.pkg.dev/uspbr-242713/dnabr-lai/m33-tabix@sha256:e730c35759e3851a92d7f3a6619333105331d97f1ae44a50dfa8d59745c43e54'
  m34_inputs_flare_image = 'us-central1-docker.pkg.dev/uspbr-242713/dnabr-lai/m30-flare-runtime@sha256:86bf36c5d23407ed187d546f2420a0d2c44fbb6eed12ba81ddfc0f75df6b3a84'
  m34_inputs_container_user = '1017:1020'

  m34_inputs_contract_cpus = 1
  m34_inputs_contract_memory = '512 MB'
  m34_inputs_contract_time = '10m'

  m34_inputs_mosaic_cpus = 1
  m34_inputs_mosaic_memory = '4 GB'
  m34_inputs_mosaic_time = '6h'
  m34_inputs_mosaic_max_forks = 2

  m34_inputs_bridge_cpus = 1
  m34_inputs_bridge_memory = '8 GB'
  m34_inputs_bridge_time = '6h'
  m34_inputs_bridge_max_forks = 2

  m34_inputs_tabix_cpus = 1
  m34_inputs_tabix_memory = '1 GB'
  m34_inputs_tabix_time = '30m'
  m34_inputs_tabix_max_forks = 4

  m34_inputs_flare_contract_cpus = 1
  m34_inputs_flare_contract_memory = '1 GB'
  m34_inputs_flare_contract_time = '15m'

  m34_inputs_flare_cpus = 4
  m34_inputs_flare_memory = '8 GB'
  m34_inputs_flare_time = '6h'
  m34_inputs_flare_max_forks = 2

  m34_inputs_parse_cpus = 1
  m34_inputs_parse_memory = '8 GB'
  m34_inputs_parse_time = '4h'
  m34_inputs_parse_max_forks = 2

  m34_inputs_truth_cpus = 1
  m34_inputs_truth_memory = '4 GB'
  m34_inputs_truth_time = '2h'
  m34_inputs_truth_max_forks = 2

  m34_inputs_manifest_cpus = 1
  m34_inputs_manifest_memory = '16 GB'
  m34_inputs_manifest_time = '4h'

  m34_inputs_plan_cpus = 1
  m34_inputs_plan_memory = '1 GB'
  m34_inputs_plan_time = '15m'

  m34_inputs_train_cpus = 4
  // The broad chr22 screen stays below 4 GiB for most tasks, but the largest
  // LAI-Net-style CNN crosses that boundary during full VALID evaluation.
  // Eight GB preserves two-way CPU parallelism on the 8-vCPU development VM.
  m34_inputs_train_memory = '8 GB'
  m34_inputs_train_time = '12h'
  m34_inputs_train_max_forks = 4
  m34_inputs_train_device = 'cpu'
  m34_inputs_train_sample_shard_size = 8
  m34_inputs_train_marker_shard_size = 256
  m34_inputs_train_maximum_rows_per_batch = 2048
  m34_inputs_train_maximum_tokens_per_batch = 262144
  m34_inputs_train_validation_every = 50

  m34_inputs_score_cpus = 1
  m34_inputs_score_memory = '4 GB'
  m34_inputs_score_time = '1h'
  m34_inputs_score_max_forks = 8
}

docker.enabled = true

process {
  executor = 'local'
  errorStrategy = 'terminate'
  maxRetries = 0
  stageInMode = 'copy'
  resourceLabels = [team: 'frank']
  containerOptions = { "--network none --user ${params.m34_inputs_container_user}" }
}
