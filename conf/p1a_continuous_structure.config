params {
  p1a_run_id = System.getenv('DNABR_RUN_ID')
  p1a_cloud_region = System.getenv('DNABR_CLOUD_REGION') ?: 'us-central1'
  p1a_pairs = 'gs://projects-usp/dnaBr-lai/datalake/refined/DNABR_QC/runs/m14-minor-autosomes-20260806a/14_rare_allele_sharing_painting/pair_sharing_summary.tsv'
  p1a_global_summary = 'gs://projects-usp/dnaBr-lai/datalake/refined/DNABR_QC/runs/m14-minor-autosomes-20260806a/14_rare_allele_sharing_painting/global_sharing_summary.json'
  p1a_metadata = 'gs://projects-usp/dnaBr-lai/datalake/trusted/DNABR_QC/metadata/metadata_cleaned.txt'
  p1a_burden = 'gs://projects-usp/dnaBr-lai/datalake/refined/DNABR_QC/runs/m24-orientation-inventory-autosomes-20260805b/24_rare_allele_orientation_inventory/aggregate/autosomes.sample_burden_by_mode.tsv.gz'
  p1a_feature_store = 'gs://projects-usp/dnaBr-lai/datalake/refined/DNABR_QC/20_feature_store/20_feature_store/feature_store.tsv'
  p1a_modeling_master = 'gs://projects-usp/dnaBr-lai/datalake/refined/DNABR_QC/model_pipeline_canonical/22_model_pipeline/modeling_master/modeling_master.tsv'
  p1a_split_manifest = 'gs://projects-usp/dnaBr-lai/datalake/refined/DNABR_QC/model_pipeline_canonical/22_model_pipeline/split/split_manifest.tsv'
  // Must point to a PASS report generated by the separately versioned P1A preflight.
  p1a_preflight_report = null
  p1a_results_dir = "gs://projects-usp/dnaBr-lai/datalake/refined/DNABR_QC/runs/${System.getenv('DNABR_RUN_ID')}/p1a_continuous_structure_dev"
  p1a_container_image = 'us-central1-docker.pkg.dev/uspbr-242713/dnabr-lai/dnabr-qc@sha256:3e9381d165b1e664e75093d885a62d8c180711c1c3f495324e8c08bdb5bd2af2'
  p1a_container_digest = 'sha256:3e9381d165b1e664e75093d885a62d8c180711c1c3f495324e8c08bdb5bd2af2'
  p1a_cpus = 2
  p1a_memory = '8 GB'
  p1a_time = '4h'
}

workDir = "gs://projects-usp/dnaBr-lai/datalake/transient/DNABR_QC/tmp/nxf_work/${System.getenv('DNABR_RUN_ID')}"

process {
  executor = 'google-batch'
  container = params.p1a_container_image
  errorStrategy = 'terminate'
  maxRetries = 0
  maxForks = 1
  disk = '20 GB'
  resourceLabels = [team: 'frank']
}

executor.queueSize = 2

google {
  project = 'uspbr-242713'
  location = params.p1a_cloud_region
}
