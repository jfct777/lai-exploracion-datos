params {
  m28_genetic_map = null
  m28_preregistration = "${baseDir}/../conf/m28_lai_simulation_preflight_preregistration.json"
  m28_root_seed = 20260817
  m28_results_dir = "${baseDir}/../results/28_lai_simulation_preflight"
  // Local tag for the two technical validation cycles. A scientific/cloud run must
  // override this with an Artifact Registry image pinned by sha256 digest.
  m28_container_image = "dnabr-m28-lai-sim:0.1.1"
  m28_container_digest = null
  m28_container_options = System.getenv('DNABR_CONTAINER_OPTIONS') ?: ''
  // msprime ancestry simulation is predominantly single-threaded. These are ceilings,
  // not measured requirements; the full chr22 smoke remains blocked until profiling.
  m28_cpus = 2
  m28_memory = "16 GB"
  m28_time = "2h"
}

docker.enabled = true

process {
  executor = 'local'
  errorStrategy = 'terminate'
  maxRetries = 0
}
