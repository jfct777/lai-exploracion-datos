params {
  // Contract and synthetic equivalence only; no scientific asset URI is accepted.
  m33_factorized_lazy_contract = "${baseDir}/../conf/m33_m0_factorized_lazy_amendment_contract.json"
  m33_factorized_lazy_materializer_contract = "${baseDir}/../conf/m33_m0_materializer_contract.json"
  m33_factorized_lazy_sanitized_f0_contract = "${baseDir}/../conf/m33_m0_f0_sanitized_amendment_contract.json"
  m33_factorized_lazy_pre4_preregistration = "${baseDir}/../conf/m33_pre4_preregistration.json"
  m33_factorized_lazy_results_dir = "${baseDir}/../results/33_m0_factorized_lazy_contract"
  m33_factorized_lazy_run_id = null
}

docker.enabled = true

process {
  executor = 'local'
  errorStrategy = 'terminate'
  maxRetries = 0
  maxForks = 1
  container = 'us-central1-docker.pkg.dev/uspbr-242713/dnabr-lai/m28-lai-sim@sha256:06e7b70a2484de19c73a18a6fc9ddefbfa1599e43cbcdcd60fd185495dfb9a19'
  containerOptions = '--network none --memory 1g --user 1017:1020'
}
