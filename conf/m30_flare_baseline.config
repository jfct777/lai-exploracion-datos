params {
  m30_run_id = System.getenv('DNABR_RUN_ID')
  m30_cloud_region = System.getenv('DNABR_CLOUD_REGION') ?: 'us-central1'
  m30_preregistration = "${baseDir}/../conf/m30_flare_baseline_preregistration.json"
  m30_genetic_map = 'gs://projects-usp/dna-do-brasil/dnabr-lai-gnomix/maps/genetic.map.chr22'

  m30_root17_reference_vcf = 'gs://projects-usp/dnaBr-lai/datalake/refined/DNABR_QC/runs/m29-root-b0-production-20260818a/29_root_b0_production/root17/ingest/m28c_b0_reference.vcf.gz'
  m30_root17_reference_tbi = 'gs://projects-usp/dnaBr-lai/datalake/refined/DNABR_QC/runs/m29-root-b0-production-20260818a/29_root_b0_production/root17/ingest/m28c_b0_reference.vcf.gz.tbi'
  m30_root17_target_vcf = 'gs://projects-usp/dnaBr-lai/datalake/refined/DNABR_QC/runs/m29-root-b0-production-20260818a/29_root_b0_production/root17/ingest/m28c_b0_target.vcf.gz'
  m30_root17_target_tbi = 'gs://projects-usp/dnaBr-lai/datalake/refined/DNABR_QC/runs/m29-root-b0-production-20260818a/29_root_b0_production/root17/ingest/m28c_b0_target.vcf.gz.tbi'
  m30_root17_sample_map = 'gs://projects-usp/dnaBr-lai/datalake/refined/DNABR_QC/runs/m29-root-b0-production-20260818a/29_root_b0_production/root17/materialized/m28c_b0_reference.sample_map.tsv'
  m30_root17_gnomix_binding = 'gs://projects-usp/dnaBr-lai/datalake/refined/DNABR_QC/runs/m29-root-gnomix-b0-20260818c/29_root_gnomix_b0_20260818c/root17/binding/m29_b0_binding.json'
  m30_root17_gnomix_fb = 'gs://projects-usp/dnaBr-lai/datalake/refined/DNABR_QC/runs/m29-root-gnomix-b0-20260818c/29_root_gnomix_b0_20260818c/root17/inference/results/query_results.fb'
  m30_root17_gnomix_msp = 'gs://projects-usp/dnaBr-lai/datalake/refined/DNABR_QC/runs/m29-root-gnomix-b0-20260818c/29_root_gnomix_b0_20260818c/root17/inference/results/query_results.msp'
  m30_root17_truth = 'gs://projects-usp/dnaBr-lai/datalake/refined/DNABR_QC/runs/m28-v2-individual-safe-20260817a/seed17-b/seed-20260817/m28/m28_lai_truth.tsv.gz'

  m30_root18_reference_vcf = 'gs://projects-usp/dnaBr-lai/datalake/refined/DNABR_QC/runs/m29-root-b0-production-20260818a/29_root_b0_production/root18/ingest/m28c_b0_reference.vcf.gz'
  m30_root18_reference_tbi = 'gs://projects-usp/dnaBr-lai/datalake/refined/DNABR_QC/runs/m29-root-b0-production-20260818a/29_root_b0_production/root18/ingest/m28c_b0_reference.vcf.gz.tbi'
  m30_root18_target_vcf = 'gs://projects-usp/dnaBr-lai/datalake/refined/DNABR_QC/runs/m29-root-b0-production-20260818a/29_root_b0_production/root18/ingest/m28c_b0_target.vcf.gz'
  m30_root18_target_tbi = 'gs://projects-usp/dnaBr-lai/datalake/refined/DNABR_QC/runs/m29-root-b0-production-20260818a/29_root_b0_production/root18/ingest/m28c_b0_target.vcf.gz.tbi'
  m30_root18_sample_map = 'gs://projects-usp/dnaBr-lai/datalake/refined/DNABR_QC/runs/m29-root-b0-production-20260818a/29_root_b0_production/root18/materialized/m28c_b0_reference.sample_map.tsv'
  m30_root18_gnomix_binding = 'gs://projects-usp/dnaBr-lai/datalake/refined/DNABR_QC/runs/m29-root-gnomix-b0-20260818c/29_root_gnomix_b0_20260818c/root18/binding/m29_b0_binding.json'
  m30_root18_gnomix_fb = 'gs://projects-usp/dnaBr-lai/datalake/refined/DNABR_QC/runs/m29-root-gnomix-b0-20260818c/29_root_gnomix_b0_20260818c/root18/inference/results/query_results.fb'
  m30_root18_gnomix_msp = 'gs://projects-usp/dnaBr-lai/datalake/refined/DNABR_QC/runs/m29-root-gnomix-b0-20260818c/29_root_gnomix_b0_20260818c/root18/inference/results/query_results.msp'
  m30_root18_truth = 'gs://projects-usp/dnaBr-lai/datalake/refined/DNABR_QC/runs/m28-v2-individual-safe-20260817a/seed18-a/seed-20260818/m28/m28_lai_truth.tsv.gz'

  m30_container_image = 'us-central1-docker.pkg.dev/uspbr-242713/dnabr-lai/m30-flare-runtime@sha256:86bf36c5d23407ed187d546f2420a0d2c44fbb6eed12ba81ddfc0f75df6b3a84'
  m30_container_digest = 'sha256:86bf36c5d23407ed187d546f2420a0d2c44fbb6eed12ba81ddfc0f75df6b3a84'
  m30_flare_jar = 'gs://projects-usp/dnaBr-lai/datalake/software/flare/0.6.0/flare.jar'
  m30_flare_jar_sha256 = '8c804341b555f302591b12cd72e870b1ca7849055d1dcd2b5cfa09b725bd9420'

  m30_results_dir = "gs://projects-usp/dnaBr-lai/datalake/refined/DNABR_QC/runs/${System.getenv('DNABR_RUN_ID')}/30_flare_baseline"
  m30_cpus = 4
  m30_memory = '8 GB'
  m30_preflight_time = '30m'
  m30_inference_time = '2h'
  m30_scoring_cpus = 2
  m30_scoring_memory = '8 GB'
  m30_scoring_time = '2h'
  m30_disk = '30 GB'
}

workDir = "gs://projects-usp/dnaBr-lai/datalake/transient/DNABR_QC/tmp/nxf_work/${System.getenv('DNABR_RUN_ID')}"

process {
  executor = 'google-batch'
  errorStrategy = 'terminate'
  maxRetries = 0
  maxForks = 1
  disk = params.m30_disk
  resourceLabels = [team: 'frank']
}

executor.queueSize = 1

google {
  project = 'uspbr-242713'
  location = params.m30_cloud_region
}
