params {
    m16_5_sensitivity_m14_input_dir = 'gs://projects-usp/dnaBr-lai/datalake/refined/DNABR_QC/runs/m14-minor-autosomes-20260806a/14_rare_allele_sharing_painting'
    m16_5_sensitivity_metadata_file = 'gs://projects-usp/dnaBr-lai/datalake/trusted/DNABR_QC/metadata/metadata_cleaned.txt'
    m16_5_sensitivity_burden_file = 'gs://projects-usp/dnaBr-lai/datalake/refined/DNABR_QC/runs/m24-orientation-inventory-autosomes-20260805b/24_rare_allele_orientation_inventory/aggregate/autosomes.sample_burden_by_mode.tsv.gz'
    m16_5_sensitivity_pcrelate_file = 'gs://projects-usp/dnaBr-lai/datalake/refined/DNABR_QC/qc_pcrelate/dnabr.pcrelate.kin.tsv'
    m16_5_sensitivity_results_dir = 'gs://projects-usp/dnaBr-lai/datalake/refined/DNABR_QC/runs/m16-5-threshold-sensitivity-20260818d/16_5_threshold_sensitivity'

    m16_5_sensitivity_container_image = 'us-central1-docker.pkg.dev/uspbr-242713/dnabr-lai/dnabr-qc@sha256:3e9381d165b1e664e75093d885a62d8c180711c1c3f495324e8c08bdb5bd2af2'
    m16_5_sensitivity_cpus = 8
    m16_5_sensitivity_memory = '16 GB'
    m16_5_sensitivity_time = '2h'
}

workDir = 'gs://projects-usp/dnaBr-lai/datalake/transient/DNABR_QC/tmp/nxf_work/m16-5-threshold-sensitivity-20260818d'

process {
    executor = 'google-batch'
    errorStrategy = 'terminate'
    maxRetries = 0
    maxForks = 2
    resourceLabels = [team: 'frank']

    withName: 'WRITE_M16_5_THRESHOLD_SENSITIVITY_PROVENANCE' {
        disk = '20 GB'
    }
    withName: 'RUN_M16_5_THRESHOLD_SENSITIVITY' {
        disk = '30 GB'
    }
}

executor.queueSize = 2

google {
    project = 'uspbr-242713'
    location = 'us-central1'
}
