plugins {
  id 'nf-google@1.27.3'
}

params {
  m35b_run_id = System.getenv('DNABR_RUN_ID')
  m35b_results_dir = 'gs://teams-usp/frank/lai-exploracion-datos/runs'
  m35b_contract = "${baseDir}/../conf/m35b_flare2_balanced_contract.json"

  m35b_roles = null
  m35b_reference_vcf = null
  m35b_reference_tbi = null
  m35b_target_vcf = null
  m35b_target_tbi = null
  m35b_genetic_map = null
  m35b_truth_npz = null
  m35b_canonical_f0_metrics = null

  // Local image ID is accepted on the development VM; Batch requires a registry @sha256 digest.
  m35b_flare2_image = null
  m35b_tabix_image = 'us-central1-docker.pkg.dev/uspbr-242713/dnabr-lai/m33-tabix@sha256:e730c35759e3851a92d7f3a6619333105331d97f1ae44a50dfa8d59745c43e54'
  m35b_scoring_image = 'us-central1-docker.pkg.dev/uspbr-242713/dnabr-lai/m33-t0a@sha256:c03864a9ed0c56b00fd1a234daee2d17ddfa57d4c426628bd59cd9daf351ee99'
  m35b_container_user = '1017:1020'

  m35b_executor = System.getenv('DNABR_M35B_EXECUTOR') ?: 'local'
  m35b_run_final = true
  m35b_prepare_max_forks = 3
  m35b_screen_cpus = 2
  m35b_screen_memory = '3 GB'
  m35b_screen_time = '1h'
  m35b_screen_max_forks = 3
  m35b_final_cpus = 2
  m35b_final_memory = '3 GB'
  m35b_final_time = '2h'
  m35b_batch_region = System.getenv('DNABR_CLOUD_REGION') ?: 'us-central1'
}

process {
  executor = params.m35b_executor
  stageInMode = 'copy'
  errorStrategy = 'terminate'
  maxRetries = 0
  resourceLabels = [team: 'frank']
  withName: /M35B_.*/ {
    disk = '20 GB'
  }
}

docker.enabled = params.m35b_executor == 'local'
workDir = params.m35b_executor == 'local' \
  ? "/tmp/nextflow/${params.m35b_run_id}" \
  : "gs://teams-usp/frank/lai-exploracion-datos/work/nextflow/${params.m35b_run_id}"

executor.queueSize = params.m35b_executor == 'local' ? 3 : 6

google {
  project = 'uspbr-242713'
  location = params.m35b_batch_region
  batch {
    spot = false
    maxSpotAttempts = 0
  }
}
