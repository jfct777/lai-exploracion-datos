// M36B: nested exploratory screen of chr22 rare-event sets against
// cross-chromosome common-IBD pair totals.  This is not an LAI validation.
plugins {
  id 'nf-google@1.27.3'
}

params {
  m36b_run_id = 'm36b-cora-chr22-triage-20260903a'
  m36b_run_config = 'conf/m36b_cora_chr22_screen.config'
  m36b_feature_chrom = 'chr22'
  m36b_output_prefix = "gs://teams-usp/frank/lai-exploracion-datos/runs/${params.m36b_run_id}/m36b_cora_set/"

  m36b_loci = 'gs://teams-usp/frank/lai-exploracion-datos/runs/m36-cora-chr22-materialize-20260902a/m36_cora_set/m36_cora_loci.tsv'
  m36b_carriers = 'gs://teams-usp/frank/lai-exploracion-datos/runs/m36-cora-chr22-materialize-20260902a/m36_cora_set/m36_cora_carriers.tsv'
  m36b_missing = 'gs://teams-usp/frank/lai-exploracion-datos/runs/m36-cora-chr22-materialize-20260902a/m36_cora_set/m36_cora_missing.tsv'
  m36b_covariates = 'gs://teams-usp/frank/lai-exploracion-datos/runs/m36-cora-chr22-materialize-20260902a/m36_cora_set/m36_cora_covariates.tsv'
  m36b_components = 'gs://teams-usp/frank/lai-exploracion-datos/runs/m36-cora-chr22-materialize-20260902a/m36_cora_set/m36_cora_components.tsv'
  m36b_targets = 'gs://teams-usp/frank/lai-exploracion-datos/runs/m36-cora-chr22-materialize-20260902a/m36_cora_set/m36_cora_external_targets.tsv'
  m36b_materialization_receipt = 'gs://teams-usp/frank/lai-exploracion-datos/runs/m36-cora-chr22-materialize-20260902a/m36_cora_set/m36_cora_materialization_receipt.json'

  // Architecture ranking is nested inside each outer FIT partition.
  m36b_model_families = 'deep_sets,set_transformer'
  // Half-scale budgets keep the one-seed triage bounded.  A promising result
  // is repeated at 32/128 with all three fixed seeds in a new run namespace.
  m36b_halving_budgets = '16,64'
  m36b_halving_eta = 2
  m36b_outer_folds = 3
  m36b_inner_folds = 2
  // Phase 1 measures feasibility and direction with one seed.  Seeds 2701
  // and 3701 are added only if the same prespecified controls pass.
  m36b_train_seeds = '1701'

  // One hundred component-node bootstrap replicates provide an exploratory
  // uncertainty interval; they are not a substitute for independent cohorts.
  m36b_bootstrap_reps = 100
  m36b_pair_batch_size = 1024
  m36b_permutation_swap_multiplier = 10.0
  // A nominal permutation must move at least half of the carrier edges in
  // every FIT and validation partition.  This is a technical null-validity
  // guard, not a biological cutoff or a claim of uniform-chain mixing.
  m36b_minimum_moved_carrier_fraction = 0.50
  // Both known-answer controls traverse the same nested and matched-control
  // path before any real table is read.  Their triage capacity is frozen.
  m36b_positive_control_budgets = '16,64'
  m36b_positive_control_seed = 1701
  m36b_learning_rate = 0.01
  m36b_weight_decay = 0.0001
  m36b_huber_delta = 1.0

  // The 10% effect-size gate is retained from the current M36 implementation
  // as an explicit exploratory threshold, not as a biological cutoff.  The
  // effect sign must also agree in at least two of three outer folds and the
  // paired component-node interval must exclude zero.
  m36b_minimum_relative_mse_reduction = 0.10
  m36b_minimum_positive_folds = 2

  m36b_pytorch_image = 'us-central1-docker.pkg.dev/uspbr-242713/dnabr-lai/m33-t0a@sha256:c03864a9ed0c56b00fd1a234daee2d17ddfa57d4c426628bd59cd9daf351ee99'
  m36b_cpus = 8
  m36b_memory = '32 GB'
  m36b_time = '8h'
}

workDir = "gs://teams-usp/frank/lai-exploracion-datos/work/nextflow/${params.m36b_run_id}"
docker.enabled = false

process {
  executor = 'google-batch'
  container = params.m36b_pytorch_image
  containerOptions = '--user 0:0'
  disk = '50 GB'
  maxForks = 1
  errorStrategy = 'terminate'
  maxRetries = 0
  resourceLabels = [team: 'frank', lane: 'm36b-cora']
}

executor.queueSize = 1
google {
  project = 'uspbr-242713'
  location = 'us-central1'
  batch { spot = false; maxSpotAttempts = 0 }
}
