// Auto-generated resource configuration
// Este archivo se actualiza con scripts/autotune_resources.py
//
// To use this config:
//   nextflow run main.nf -profile local_docker -c conf/auto_resources.config ...

params {
  resources {
    preprocess_norm_leftalign {
      cpus = 4
      memory = '16 GB'
      threads = 4
      maxForks = null
    }

    preprocess_filter_snv_biallelic_pass {
      cpus = 4
      memory = '16 GB'
      threads = 4
      maxForks = null
    }

    qc_bcftools_stats {
      cpus = 4
      memory = '16 GB'
      threads = 4
      maxForks = null
    }

    qc_plink_make_pgen {
      cpus = 8
      memory = '32 GB'
      threads = 8
      maxForks = null
    }

    qc_plink_missing_het {
      cpus = 8
      memory = '32 GB'
      threads = 8
      maxForks = null
    }

    qc_aggregate_report_py {
      cpus = 1
      memory = '8 GB'
      threads = 1
      maxForks = 1
    }

    sfs_from_filtered_vcf {
      cpus = 1
      memory = '16 GB'
      threads = 1
      maxForks = null
    }

    build_ancestral_tsv_from_fasta {
      cpus = 1
      memory = '16 GB'
      threads = 1
      maxForks = null
    }

    daf_dsfs_from_ancestral_tsv {
      cpus = 1
      memory = '16 GB'
      threads = 1
      maxForks = null
    }

    ld_decay_from_pgen {
      cpus = 8
      memory = '64 GB'
      threads = 8
      maxForks = null
    }

    tag_snps_from_pgen {
      cpus = 8
      memory = '48 GB'
      threads = 8
      maxForks = null
    }

    lai_rare_bialelic_only {
      // bcftools view + annotate + index es I/O-bound: rendimientos decrecientes
      // arriba de 4-8 threads (Danecek 2021 GigaScience). Reservar 32 CPUs por
      // proceso × 24 cromosomas en paralelo monopoliza la partición cpu.
      cpus = 8
      memory = '24 GB'
      threads = 8
      maxForks = 6   // tope: 6 procesos × 8 CPUs = 48 CPUs concurrentes (~6% cluster)
    }

    rare_snp_tracts_scan {
      cpus = 20
      memory = '26 GB'
      threads = 4
      maxForks = 8
    }

    rare_snp_tracts_aggregate {
      cpus = 20
      memory = '26 GB'
      threads = 4
      maxForks = 8
    }

    individual_snp_distance_modes_scan {
      cpus = 2
      memory = '24 GB'
      threads = 1
      maxForks = 3
    }

    individual_snp_distance_modes_aggregate {
      cpus = 1
      memory = '8 GB'
      threads = 1
      maxForks = 1
    }

    // Module 14a: rare allele sharing painting per-chromosome scan.
    // Memory is bounded by per-pair streaming state (<= C(N,2) tuples) plus
    // the matplotlib Agg canvas capped via --plot-max-height-inches.
    //
    // joblib parallelism (refactor cont. 2): worker pool feeds the pairwise-
    // segment detection loop in ``bin/rare_allele_sharing_painter.py`` (see
    // ``painting_n_jobs`` in nextflow.config). Empirical speedup with 8 cpus
    // = 3.5x vs serial on chr1 (N=2619, ~2M qualifying pairs). With 16 cpus
    // expected ~5x (diminishing returns from joblib IPC + GIL-free numpy ops).
    //
    // Los nodos de cómputo disponen de 128 CPUs y cerca de 4 TB de RAM.
    // Para no ocupar más del 65 % de un nodo, el dimensionamiento considera
    // el peor caso en que todos los procesos coinciden en el mismo nodo.
    //
    // Worst-case CPU en un nodo = cpus × maxForks. Para 128 CPUs/nodo el
    // tope es 128 × 0.65 ≈ 83 CPUs.
    //
    // Config actual: cpus=16, maxForks=5 → 80 CPUs en peor caso (62.5% del
    // nodo) ≤ 65% ✓. Total cluster: 80 CPUs = 10.4% partición.
    // Memory: 5 × 64 GB = 320 GB ≪ 4 TB (8% del nodo) ✓.
    // Walltime esperado: 24 chr / 5 paralelos × ~30 min joblib 16-wide ≈ 2.5h.
    //
    // joblib speedup curve (bin/rare_allele_sharing_painter.py):
    //   cpus=8  → ~3.5x frente a la ejecución serial
    //   cpus=16 → ~5x esperado (diminishing returns por IPC overhead)
    //   cpus=32 → ~6x (no vale la pena vs perder paralelismo de chr)
    //
    // Memory headroom: chr1-2 son los más densos. Con MAC=2 (~50% menos
    // variantes que MAC=1) 64 GB es conservador. Con MAC=1 (Paso 2) 42 GB
    // alcanzaron sin OOM.
    rare_allele_sharing_scan {
      cpus = 16
      memory = '64 GB'
      threads = 1
      maxForks = 5
    }

    // Module 14b: rare allele sharing aggregation + HTML report.
    // Streaming aggregator (post-refactor): peak RAM is dominated by the
    // per-pair and per-individual accumulator dicts, ~2 GB at N=2723 and
    // O(|pairs|) overall. 32 GB leaves ample headroom for N ~= 10k or for
    // cohorts with unusually dense sharing (|segments| >> 10^8).
    rare_allele_sharing_aggregate {
      cpus = 2
      memory = '32 GB'
      threads = 2
      maxForks = 1
    }

    // Module 17a: rare variants in LAI tracts, per-chromosome.
    // Liviano: un stream ``bcftools query`` (GT="alt") + matriz .msp de ancestría
    // local int8 [n_seg × 2·N] en numpy (N=2619 → unos pocos cientos de MB). Sin
    // joblib. Worst-case CPU en un nodo = cpus×maxForks = 2×8 = 16 ≪ 83 (65% de 128).
    // Memoria: 8 × 16 GB = 128 GB ≪ 4 TB. 22 autosomas / 8 paralelos ≈ minutos c/u.
    rare_in_lai_scan {
      cpus = 2
      memory = '16 GB'
      threads = 1
      maxForks = 8
    }

    // Module 17b: agrega los summary.json por-crom (suma de conteos crudos). Trivial.
    rare_in_lai_aggregate {
      cpus = 1
      memory = '4 GB'
      threads = 1
      maxForks = 1
    }

    // Module 19: figura raras-sobre-painting-LAI. Por-crom: windowing (igual que
    // rare_in_lai_scan: stream VCF + .msp) + render matplotlib. Peor caso CPU en un
    // nodo = 2×8 = 16 ≪ 83. Memoria 8×16 GB = 128 GB ≪ 4 TB.
    rare_on_lai_painting {
      cpus = 2
      memory = '16 GB'
      threads = 1
      maxForks = 8
    }

    // Module 16.5: IBD community detection enhanced.  Memory budget: dense
    // N x N sharing matrix (~8 * N^2 bytes) + NMF H @ HtH workspace
    // (~8 * N * K) + UMAP spectral embedding + cophenetic stability
    // (30 inits per K × extended K sweep) + ARI multi-seed.  For N = 3000,
    // dense S ~= 72 MB; sparse graph ~= 30 MB; igraph layout scales linearly
    // in |E|.  Leiden is CPU-bound (n_seeds x n_resolutions), so allocate
    // generous cores.
    ibd_community_enhanced {
      cpus = 12
      memory = '64 GB'
      threads = 12
      maxForks = 1
    }

    // Module 16.5 REPLOT (fan-out task that re-renders plots per metadata
    // column).  No graph/Leiden/NMF re-compute — but plot mode still loads
    // the segments table to reconstruct S, then builds the interactive
    // Plotly artefacts.  At N=2723 the heatmap customdata array alone is
    // ~3-4 GB peak (2723² cells × 9 string columns + intermediates), plus
    // plotly's JSON serialisation copy and 7 network UMAP HTMLs.  16 GB
    // (the global default) is OOM-killed; 48 GB leaves comfortable margin.
    // Up to 7 REPLOTs run concurrently — Slurm gates parallelism.
    ibd_enhanced_replot {
      cpus = 4
      memory = '48 GB'
      threads = 4
      maxForks = null
    }

    // Módulo 18: comparador asIBD. Ejecuta la misma configuración de Leiden de M16.5 unas seis veces.
    // (3 ancestrías × {partición, árbitro}, 25 seeds × 7 resoluciones c/u) +
    // null de permutación mtDNA (2000 × ~28 comunidades). CPU-bound, single-proc.
    // Matrices sparse 2619² (livianas). Worst-case nodo = 8×1 = 8 CPUs ≪ 83.
    asibd_comparator {
      cpus = 8
      memory = '48 GB'
      threads = 8
      maxForks = 1
    }

    // Module 21a: construye el bed LCR/segdup genome-wide (zcat+awk+sort). Trivial, 1 vez.
    presence_lcr_mask {
      cpus = 2
      memory = '8 GB'
      threads = 1
      maxForks = 1
    }

    // Module 21b: canal de presencia externa, per (panel × cromosoma). cyvcf2 single-thread:
    // indexa el panel NAM (dict pos->alelos; chr1 NAMBR ~1M posiciones ≈ pocos GB) + stream del
    // target raro + FASTA mmap (no cuenta). Piloto chr22 corrió <2 min con 32 GB. Worst-case nodo
    // = cpus×maxForks = 2×10 = 20 ≪ 83 (65% de 128). Memoria 10×24 GB = 240 GB ≪ 4 TB.
    // 2 paneles × 22 autosomas = 44 tareas / 10 paralelas ≈ pocas rondas.
    presence_channel_scan {
      cpus = 2
      memory = '24 GB'
      threads = 1
      maxForks = 10
    }

    // Module 21c: agrega los summary.json por-crom de UN panel (suma de conteos crudos). Trivial.
    // Un AGGREGATE por panel (2) -> maxForks=2.
    presence_channel_aggregate {
      cpus = 1
      memory = '4 GB'
      threads = 1
      maxForks = 2
    }

    // Module 20a: cohorte certificada (bcftools query -l + intersección/dedup en python). Trivial, 1 vez.
    feature_define_cohort {
      cpus = 1
      memory = '8 GB'
      threads = 1
      maxForks = 1
    }

    // Module 20b: densidad PSC (`bcftools stats -s -`) per cromosoma sobre 2723 muestras. Igual que M03.
    // Worst-case nodo = cpus×maxForks = 2×10 = 20 ≪ 83 (65% de 128). Memoria 10×16 GB = 160 GB ≪ 4 TB.
    feature_count_density {
      cpus = 2
      memory = '16 GB'
      threads = 2
      maxForks = 10
    }

    // Module 20c: agrega cohorte + Σℓ + PSC + metadata (pandas, 2619 filas × pocas cols). Trivial, 1 vez.
    feature_aggregate {
      cpus = 2
      memory = '16 GB'
      threads = 1
      maxForks = 1
    }

    // Module 22a: ensambla modeling_master (joins pandas, 2619 filas). Trivial, 1 vez.
    model_build_master {
      cpus = 2
      memory = '16 GB'
      threads = 1
      maxForks = 1
    }

    // Módulo 22b: split StratifiedGroupKFold y selección del fold de test. Se ejecuta una vez.
    model_build_split {
      cpus = 2
      memory = '8 GB'
      threads = 1
      maxForks = 1
    }

    // Module 22c: CV interna (LeaveOneGroupOut × 3 modelos × 3 sets + null de 200 permutaciones que
    // repite la CV completa). Los recursos deben verificarse con `sacct`.
    model_primary_cv {
      cpus = 4
      memory = '16 GB'
      threads = 4
      maxForks = 1
    }

    // Módulo 22d: evaluación única del fold de test con bootstrap N=2000. Desactivado por defecto.
    model_evaluate_test {
      cpus = 2
      memory = '8 GB'
      threads = 1
      maxForks = 1
    }

    // Módulo 22e: verificación del hash del fold de test congelado; solo usa I/O y sha256sum.
    model_verify_test_hash {
      cpus = 1
      memory = '2 GB'
      threads = 1
      maxForks = 1
    }

    // Módulo 23a: extracción sparse individuo por variante de un cromosoma (bcftools query -S TRAIN +
    // acumulación scipy.sparse). El peor caso medido en chr2 alcanzó 4,0 GB, 1,76 cores y 8,0 min (los 22 en 13 min de
    // wall con maxForks=8). cpus=2 (bcftools query 1 hilo + python 1 hilo → 1,76 cores), memory=8 GB
    // (~2× el pico de 4 GB), maxForks=8 (2×8=16 CPUs concurrentes, holgado bajo el tope del nodo).
    // params.time global (24h) sobra para el máx de 8 min; se deja así (límite generoso, inofensivo).
    rare_bench_extract {
      cpus = 2
      memory = '8 GB'
      threads = 2
      maxForks = 8
    }

    // M25 chr22: bcftools stream + matrices [~204 ventanas x 2.091 TRAIN].
    // Dos CPUs cubren productor/consumidor; 8 GB mantiene una VM de CPU sostenida.
    rare_window_features {
      cpus = 2
      memory = '8 GB'
      threads = 2
      maxForks = 1
    }
    // Module 23b: smoke técnico chr22 (retención + MaxAbsScaler sparse + 1 fit SAGA etiqueta permutada).
    // Los recursos deben verificarse con `sacct`.
    rare_bench_smoke {
      cpus = 4
      memory = '24 GB'
      threads = 4
      maxForks = 1
    }

    // Module 23c: concatenación genoma-completa (hstack de 22 CSC). Pico ≈ 2× la matriz final (~2.4 GB
    // int16+indices) durante el hstack.
    rare_bench_concat {
      cpus = 2
      memory = '32 GB'
      threads = 2
      maxForks = 1
    }

    // Module 23 ETAPA 3 — CV PARTICIONADO por (set,fold). Recursos por proceso.
    // PREFLIGHT carga la matriz, construye X y E_input, y calcula su hash una vez. No entrena.
    rare_bench_preflight {
      cpus = 4
      memory = '128 GB'
      threads = 4
      maxForks = 1
    }
    // CV_ABC: sets densos A,B,C (ms) pero carga la matriz; n_jobs=cpus para el GridSearchCV.
    rare_bench_cv_abc {
      cpus = 8
      memory = '128 GB'
      threads = 8
      maxForks = 1
    }
    // CV_FOLD: una tarea pesada por (set,fold). Con maxForks=8 se usan 80 CPUs
    // y hasta 2048 GB en el peor caso
    // (reintento simultaneo de las 8) << 4 TB del nodo. Las 8 folds pesadas (D/E x {0,1,2,4}) corren en UNA
    // sola tanda. La política de memoria y tiempo vive en el bloque withName 'RARE_BENCH_CV_FOLD'.
    // el set E (matriz completa + burden) OOM-mataba con 128 GB; el set D real llego a 140 GB (fold_D_1 medido).
    // cpus=10 con n_jobs=10: sin CPUs de holgura extra (el padre esta mayormente idle durante el fit paralelo).
    // 8 folds x 10 cpus = 80 CPUs <= tope 65% del nodo (83 de 128). memory 192->256 GB da mas holgura sobre el
    // pico real (~108-140 GB) y sobre n_jobs=10; 8 x 256 = 2 TB << 4 TB del nodo.
    rare_bench_cv_fold {
      cpus = 10
      memory = '256 GB'
      threads = 10
      maxForks = 8
    }
    // AGGREGATE: solo reensambla JSONs (no carga la matriz). Trivial.
    rare_bench_aggregate {
      cpus = 2
      memory = '8 GB'
      threads = 2
      maxForks = 1
    }
    // REFIT_FOLD ejecuta un ajuste con hiperparámetros fijos. No usa GridSearchCV ni workers de loky,
    // por lo que evita las copias por worker que llevaron el set E a 140-151 GB.
    // Ya hay medición propia: en el intento del 2026-07-28 los cuatro folds de E marcaron un MaxRSS de
    // 15.3 a 17.7 GiB (sstat sobre los jobs 67841-67844). El pico se produce al cargar la matriz y
    // aplicar RareRetention.fit y MaxAbsScaler, es decir al principio; durante las iteraciones de saga
    // la matriz ya es fija y el consumo no crece. Sobre ese máximo medido, 96 GB dejan un margen de 5x.
    // Se usan dos CPU porque saga trabaja con un hilo y se deja otro para el proceso principal.
    // 4 folds x 2 cpus = 8 CPUs y 4 x 96 = 384 GB reservados en un nodo de 128 CPUs y 4 TB.
    rare_bench_refit_fold {
      cpus = 2
      memory = '96 GB'
      threads = 1
      maxForks = 4
    }

  }

  // --- Reintento de CV_FOLD ---
  // Aqui (no en nextflow.config) porque el bloque withName 'RARE_BENCH_CV_FOLD' de este mismo archivo los
  // referencia de forma EAGER (maxRetries) y Nextflow no resuelve un params.X definido en otro config file
  // en posicion eager durante el parseo.
  // En este Slurm, OOM y timeout no pueden distinguirse desde Nextflow.
  // desde Nextflow — ambos terminan en SIGKILL/exit 137 y Nextflow solo expone task.exitStatus, no el estado
  // Slurm (OUT_OF_MEMORY/TIMEOUT/NODE_FAILED); leer sacct dentro del closure es racy (JobAcctGatherFrequency=30s).
  // No se diferencia el reintento por OOM y por timeout: el segundo intento aumenta memoria y tiempo.
  // Los errores científicos, de hash o de validación terminan con código 1 y no se reintentan.
  rare_bench_cv_fold_max_retries  = 1        // un solo reintento por (set,fold)
  rare_bench_cv_fold_retry_memory = '320 GB' // techo de memoria del reintento (> 256 GB base)
  rare_bench_cv_fold_retry_time   = '72h'    // techo de tiempo del reintento (> 60 h base)
  // Reintento de REFIT_FOLD: aqui por el mismo motivo de parseo eager que el bloque de arriba.
  rare_bench_refit_fold_max_retries  = 1        // un solo reintento por (set,fold)
  rare_bench_refit_fold_retry_memory = '192 GB' // techo de memoria del reintento (> 96 GB base)
  rare_bench_refit_fold_retry_time   = '60h'    // techo de tiempo del reintento (> 48 h base)
}

// =============================================================================
// Mapa entre procesos y bloques de recursos.
//
// Cada entrada mapea un nombre de proceso a la clave correspondiente bajo
// `params.resources`. La búsqueda no se duplica en los bloques `withName:`; el
// helper `applyResources` aplica `cpus`, `memory` y `maxForks` atómicamente.
//
// Centralizar el mapeo en una sola estructura
// elimina la posibilidad de olvidar `maxForks` en futuros procesos. Agregar
// un módulo nuevo es UNA línea en `PROCESS_RESOURCES` + UN bloque withName de
// 3 líneas que sólo lookups por nombre.
//
// Una migración futura a `withLabel:` podría eliminar la enumeración de procesos.
// =============================================================================

def PROCESS_RESOURCES = [
  'PREPROCESS_NORM_LEFTALIGN':              'preprocess_norm_leftalign',
  'PREPROCESS_FILTER_SNV_BIALLELIC_PASS':   'preprocess_filter_snv_biallelic_pass',
  'QC_BCFTOOLS_STATS':                      'qc_bcftools_stats',
  'QC_PLINK_MAKE_PGEN':                     'qc_plink_make_pgen',
  'QC_PLINK_MISSING_HET':                   'qc_plink_missing_het',
  'QC_AGGREGATE_REPORT_PY':                 'qc_aggregate_report_py',
  'SFS_FROM_FILTERED_VCF':                  'sfs_from_filtered_vcf',
  'BUILD_ANCESTRAL_TSV_FROM_FASTA':         'build_ancestral_tsv_from_fasta',
  'DAF_DSFS_FROM_ANCESTRAL_TSV':            'daf_dsfs_from_ancestral_tsv',
  'LD_DECAY_FROM_PGEN':                     'ld_decay_from_pgen',
  'TAG_SNPS_FROM_PGEN':                     'tag_snps_from_pgen',
  'LAI_RARE_BIALELIC_ONLY':                 'lai_rare_bialelic_only',
  'ANALYZE_RARE_SNP_TRACTS':                'rare_snp_tracts_scan',
  'AGGREGATE_RARE_SNP_TRACTS':              'rare_snp_tracts_aggregate',
  'ANALYZE_INDIVIDUAL_SNP_DISTANCE_MODES':  'individual_snp_distance_modes_scan',
  'AGGREGATE_INDIVIDUAL_SNP_DISTANCE_MODES':'individual_snp_distance_modes_aggregate',
  'ANALYZE_RARE_ALLELE_SHARING':            'rare_allele_sharing_scan',
  'AGGREGATE_RARE_ALLELE_SHARING':          'rare_allele_sharing_aggregate',
  'ANALYZE_RARE_IN_LAI':                    'rare_in_lai_scan',
  'AGGREGATE_RARE_IN_LAI':                  'rare_in_lai_aggregate',
  'RARE_ON_LAI_PAINTING':                   'rare_on_lai_painting',
  'IBD_COMMUNITY_ENHANCED':                 'ibd_community_enhanced',
  'IBD_ENHANCED_REPLOT':                    'ibd_enhanced_replot',
  'COMPARE_ASIBD_COMMON':                   'asibd_comparator',
  'BUILD_PRESENCE_LCR_MASK':                'presence_lcr_mask',
  'ANALYZE_PRESENCE_CHANNEL':               'presence_channel_scan',
  'AGGREGATE_PRESENCE_CHANNEL':             'presence_channel_aggregate',
  'BUILD_MODELING_MASTER':                  'model_build_master',
  'BUILD_SPLIT_MANIFEST':                   'model_build_split',
  'MODEL_PRIMARY_CV':                       'model_primary_cv',
  'EVALUATE_TEST':                          'model_evaluate_test',
  'VERIFY_TEST_HASH':                       'model_verify_test_hash',
  'EXTRACT_RARE_MATRIX_CHR':                'rare_bench_extract',
  'RARE_BENCH_SMOKE':                       'rare_bench_smoke',
  'CONCAT_RARE_MATRIX':                     'rare_bench_concat',
  'RARE_BENCH_PREFLIGHT':                   'rare_bench_preflight',
  'RARE_BENCH_CV_ABC':                      'rare_bench_cv_abc',
  'RARE_BENCH_CV_FOLD':                     'rare_bench_cv_fold',
  'RARE_BENCH_AGGREGATE':                   'rare_bench_aggregate',
  'RARE_BENCH_REFIT_FOLD':                  'rare_bench_refit_fold',
  'RARE_BENCH_REFIT_AGGREGATE':             'rare_bench_aggregate',
  'DEFINE_COHORT':                          'feature_define_cohort',
  'COUNT_RARE_DENSITY':                     'feature_count_density',
  'AGGREGATE_FEATURE_STORE':                'feature_aggregate',
  'BUILD_RARE_WINDOW_FEATURES':             'rare_window_features',
]

// Comprobación final: cada clave referenciada debe existir en params.resources.
// Falla rápido y ruidoso si alguien añade un proceso al map sin definir su
// bloque de recursos — evita la asignación silenciosa de `null` al proceso
// Slurm (que se traduciría en defaults globales sin throttle).
PROCESS_RESOURCES.each { procName, resKey ->
  if (!params.resources.containsKey(resKey)) {
    throw new IllegalStateException(
      "auto_resources.config: PROCESS_RESOURCES['${procName}'] apunta a " +
      "params.resources.${resKey} pero no está definido. " +
      "Añadir el bloque o corregir el mapeo."
    )
  }
  def r = params.resources[resKey]
  ['cpus', 'memory', 'maxForks'].each { field ->
    if (!r.containsKey(field)) {
      throw new IllegalStateException(
        "auto_resources.config: params.resources.${resKey} falta el campo " +
        "'${field}' (requerido para ${procName}). maxForks=null es válido " +
        "(sin tope), pero la clave debe existir explícitamente."
      )
    }
  }
}

process {
  withName: 'PREPROCESS_NORM_LEFTALIGN'              { cpus = params.resources.preprocess_norm_leftalign.cpus;              memory = params.resources.preprocess_norm_leftalign.memory;              maxForks = params.resources.preprocess_norm_leftalign.maxForks }
  withName: 'PREPROCESS_FILTER_SNV_BIALLELIC_PASS'   { cpus = params.resources.preprocess_filter_snv_biallelic_pass.cpus;   memory = params.resources.preprocess_filter_snv_biallelic_pass.memory;   maxForks = params.resources.preprocess_filter_snv_biallelic_pass.maxForks }
  withName: 'QC_BCFTOOLS_STATS'                      { cpus = params.resources.qc_bcftools_stats.cpus;                      memory = params.resources.qc_bcftools_stats.memory;                      maxForks = params.resources.qc_bcftools_stats.maxForks }
  withName: 'QC_PLINK_MAKE_PGEN'                     { cpus = params.resources.qc_plink_make_pgen.cpus;                     memory = params.resources.qc_plink_make_pgen.memory;                     maxForks = params.resources.qc_plink_make_pgen.maxForks }
  withName: 'QC_PLINK_MISSING_HET'                   { cpus = params.resources.qc_plink_missing_het.cpus;                   memory = params.resources.qc_plink_missing_het.memory;                   maxForks = params.resources.qc_plink_missing_het.maxForks }
  withName: 'QC_AGGREGATE_REPORT_PY'                 { cpus = params.resources.qc_aggregate_report_py.cpus;                 memory = params.resources.qc_aggregate_report_py.memory;                 maxForks = params.resources.qc_aggregate_report_py.maxForks }
  withName: 'SFS_FROM_FILTERED_VCF'                  { cpus = params.resources.sfs_from_filtered_vcf.cpus;                  memory = params.resources.sfs_from_filtered_vcf.memory;                  maxForks = params.resources.sfs_from_filtered_vcf.maxForks }
  withName: 'BUILD_ANCESTRAL_TSV_FROM_FASTA'         { cpus = params.resources.build_ancestral_tsv_from_fasta.cpus;         memory = params.resources.build_ancestral_tsv_from_fasta.memory;         maxForks = params.resources.build_ancestral_tsv_from_fasta.maxForks }
  withName: 'DAF_DSFS_FROM_ANCESTRAL_TSV'            { cpus = params.resources.daf_dsfs_from_ancestral_tsv.cpus;            memory = params.resources.daf_dsfs_from_ancestral_tsv.memory;            maxForks = params.resources.daf_dsfs_from_ancestral_tsv.maxForks }
  withName: 'LD_DECAY_FROM_PGEN'                     { cpus = params.resources.ld_decay_from_pgen.cpus;                     memory = params.resources.ld_decay_from_pgen.memory;                     maxForks = params.resources.ld_decay_from_pgen.maxForks }
  withName: 'TAG_SNPS_FROM_PGEN'                     { cpus = params.resources.tag_snps_from_pgen.cpus;                     memory = params.resources.tag_snps_from_pgen.memory;                     maxForks = params.resources.tag_snps_from_pgen.maxForks }
  withName: 'LAI_RARE_BIALELIC_ONLY'                 { cpus = params.resources.lai_rare_bialelic_only.cpus;                 memory = params.resources.lai_rare_bialelic_only.memory;                 maxForks = params.resources.lai_rare_bialelic_only.maxForks }
  withName: 'ANALYZE_RARE_SNP_TRACTS'                { cpus = params.resources.rare_snp_tracts_scan.cpus;                   memory = params.resources.rare_snp_tracts_scan.memory;                   maxForks = params.resources.rare_snp_tracts_scan.maxForks }
  withName: 'AGGREGATE_RARE_SNP_TRACTS'              { cpus = params.resources.rare_snp_tracts_aggregate.cpus;              memory = params.resources.rare_snp_tracts_aggregate.memory;              maxForks = params.resources.rare_snp_tracts_aggregate.maxForks }
  withName: 'ANALYZE_INDIVIDUAL_SNP_DISTANCE_MODES'  { cpus = params.resources.individual_snp_distance_modes_scan.cpus;     memory = params.resources.individual_snp_distance_modes_scan.memory;     maxForks = params.resources.individual_snp_distance_modes_scan.maxForks }
  withName: 'AGGREGATE_INDIVIDUAL_SNP_DISTANCE_MODES'{ cpus = params.resources.individual_snp_distance_modes_aggregate.cpus;memory = params.resources.individual_snp_distance_modes_aggregate.memory;maxForks = params.resources.individual_snp_distance_modes_aggregate.maxForks }
  withName: 'ANALYZE_RARE_ALLELE_SHARING'            { cpus = params.resources.rare_allele_sharing_scan.cpus;               memory = params.resources.rare_allele_sharing_scan.memory;               maxForks = params.resources.rare_allele_sharing_scan.maxForks }
  withName: 'AGGREGATE_RARE_ALLELE_SHARING'          { cpus = params.resources.rare_allele_sharing_aggregate.cpus;          memory = params.resources.rare_allele_sharing_aggregate.memory;          maxForks = params.resources.rare_allele_sharing_aggregate.maxForks }
  withName: 'ANALYZE_RARE_IN_LAI'                    { cpus = params.resources.rare_in_lai_scan.cpus;                       memory = params.resources.rare_in_lai_scan.memory;                       maxForks = params.resources.rare_in_lai_scan.maxForks }
  withName: 'AGGREGATE_RARE_IN_LAI'                  { cpus = params.resources.rare_in_lai_aggregate.cpus;                  memory = params.resources.rare_in_lai_aggregate.memory;                  maxForks = params.resources.rare_in_lai_aggregate.maxForks }
  withName: 'RARE_ON_LAI_PAINTING'                   { cpus = params.resources.rare_on_lai_painting.cpus;                   memory = params.resources.rare_on_lai_painting.memory;                   maxForks = params.resources.rare_on_lai_painting.maxForks }
  withName: 'IBD_COMMUNITY_ENHANCED'                 { cpus = params.resources.ibd_community_enhanced.cpus;                 memory = params.resources.ibd_community_enhanced.memory;                 maxForks = params.resources.ibd_community_enhanced.maxForks }
  withName: 'IBD_ENHANCED_REPLOT'                    { cpus = params.resources.ibd_enhanced_replot.cpus;                    memory = params.resources.ibd_enhanced_replot.memory;                    maxForks = params.resources.ibd_enhanced_replot.maxForks }
  withName: 'COMPARE_ASIBD_COMMON'                   { cpus = params.resources.asibd_comparator.cpus;                       memory = params.resources.asibd_comparator.memory;                       maxForks = params.resources.asibd_comparator.maxForks }
  withName: 'BUILD_PRESENCE_LCR_MASK'                { cpus = params.resources.presence_lcr_mask.cpus;                      memory = params.resources.presence_lcr_mask.memory;                      maxForks = params.resources.presence_lcr_mask.maxForks }
  withName: 'ANALYZE_PRESENCE_CHANNEL'               { cpus = params.resources.presence_channel_scan.cpus;                  memory = params.resources.presence_channel_scan.memory;                  maxForks = params.resources.presence_channel_scan.maxForks }
  withName: 'AGGREGATE_PRESENCE_CHANNEL'             { cpus = params.resources.presence_channel_aggregate.cpus;             memory = params.resources.presence_channel_aggregate.memory;             maxForks = params.resources.presence_channel_aggregate.maxForks }
  withName: 'DEFINE_COHORT'                          { cpus = params.resources.feature_define_cohort.cpus;                  memory = params.resources.feature_define_cohort.memory;                  maxForks = params.resources.feature_define_cohort.maxForks }
  withName: 'COUNT_RARE_DENSITY'                     { cpus = params.resources.feature_count_density.cpus;                  memory = params.resources.feature_count_density.memory;                  maxForks = params.resources.feature_count_density.maxForks }
  withName: 'AGGREGATE_FEATURE_STORE'                { cpus = params.resources.feature_aggregate.cpus;                      memory = params.resources.feature_aggregate.memory;                      maxForks = params.resources.feature_aggregate.maxForks }
  withName: 'BUILD_RARE_WINDOW_FEATURES'             { cpus = params.resources.rare_window_features.cpus;                  memory = params.resources.rare_window_features.memory;                  maxForks = params.resources.rare_window_features.maxForks }
  withName: 'BUILD_MODELING_MASTER'                  { cpus = params.resources.model_build_master.cpus;                     memory = params.resources.model_build_master.memory;                     maxForks = params.resources.model_build_master.maxForks }
  withName: 'BUILD_SPLIT_MANIFEST'                   { cpus = params.resources.model_build_split.cpus;                      memory = params.resources.model_build_split.memory;                      maxForks = params.resources.model_build_split.maxForks }
  withName: 'MODEL_PRIMARY_CV'                       { cpus = params.resources.model_primary_cv.cpus;                       memory = params.resources.model_primary_cv.memory;                       maxForks = params.resources.model_primary_cv.maxForks }
  withName: 'EVALUATE_TEST'                          { cpus = params.resources.model_evaluate_test.cpus;                    memory = params.resources.model_evaluate_test.memory;                    maxForks = params.resources.model_evaluate_test.maxForks }
  withName: 'VERIFY_TEST_HASH'                       { cpus = params.resources.model_verify_test_hash.cpus;                 memory = params.resources.model_verify_test_hash.memory;                 maxForks = params.resources.model_verify_test_hash.maxForks }
  withName: 'EXTRACT_RARE_MATRIX_CHR'                { cpus = params.resources.rare_bench_extract.cpus;                     memory = params.resources.rare_bench_extract.memory;                     maxForks = params.resources.rare_bench_extract.maxForks }
  withName: 'RARE_BENCH_SMOKE'                       { cpus = params.resources.rare_bench_smoke.cpus;                       memory = params.resources.rare_bench_smoke.memory;                       maxForks = params.resources.rare_bench_smoke.maxForks }
  withName: 'CONCAT_RARE_MATRIX'                     { cpus = params.resources.rare_bench_concat.cpus;                      memory = params.resources.rare_bench_concat.memory;                      maxForks = params.resources.rare_bench_concat.maxForks }
  withName: 'RARE_BENCH_PREFLIGHT'                   { cpus = params.resources.rare_bench_preflight.cpus;                   memory = params.resources.rare_bench_preflight.memory;                   maxForks = params.resources.rare_bench_preflight.maxForks }
  withName: 'RARE_BENCH_CV_ABC'                      { cpus = params.resources.rare_bench_cv_abc.cpus;                      memory = params.resources.rare_bench_cv_abc.memory;                      maxForks = params.resources.rare_bench_cv_abc.maxForks }
  // CV_FOLD con retry prudente: 1er intento 256 GB/60 h; unico reintento 320 GB/72 h (sube memoria Y tiempo:
  // OOM y TIMEOUT indistinguibles, ver nextflow.config). Reintenta en fallo de nodo (exitStatus null),
  // muertes por señal de infra de recursos (137 OOM/SIGKILL del PROCESO, 143/140 SIGTERM/timeout) y el OOM-en-
  // worker-loky remapeado (exit 42, ver bin/rare_bench_cv.py): ese caso el padre Python sale limpio y sin el
  // remapeo saldría con código 1 y no reintentaría. Termina
  // (fail-closed) en errores cientificos/hash/validacion (SystemExit -> exit 1) y de argumentos (exit 2). 139
  // SIGSEGV no se reintenta: un segfault señala un error de código o datos, no un fallo
  // transitorio de recursos; reintentarlo enmascararia el defecto en vez de fallar ruidoso.
  withName: 'RARE_BENCH_CV_FOLD' {
    cpus          = params.resources.rare_bench_cv_fold.cpus
    memory        = { task.attempt > 1 ? params.rare_bench_cv_fold_retry_memory : params.resources.rare_bench_cv_fold.memory }
    time          = { task.attempt > 1 ? params.rare_bench_cv_fold_retry_time   : params.rare_bench_cv_fold_time }
    maxForks      = params.resources.rare_bench_cv_fold.maxForks
    maxRetries    = params.rare_bench_cv_fold_max_retries
    errorStrategy = { (task.exitStatus == null || task.exitStatus in [137, 140, 143, 42]) && task.attempt <= params.rare_bench_cv_fold_max_retries ? 'retry' : 'terminate' }
  }
  withName: 'RARE_BENCH_AGGREGATE'                   { cpus = params.resources.rare_bench_aggregate.cpus;                   memory = params.resources.rare_bench_aggregate.memory;                   maxForks = params.resources.rare_bench_aggregate.maxForks }
  // Misma política de reintento que CV_FOLD y por la misma razón: en este Slurm OOM y TIMEOUT son
  // indistinguibles desde Nextflow, así que el único segundo intento sube memoria Y tiempo a la vez.
  // Sin esto, un OOM (exit 137) no reintentaría — el errorStrategy global solo cubre exitStatus==null —
  // y el fold moriría después de horas de fit sin nada que mostrar.
  withName: 'RARE_BENCH_REFIT_FOLD' {
    cpus          = params.resources.rare_bench_refit_fold.cpus
    memory        = { task.attempt > 1 ? params.rare_bench_refit_fold_retry_memory : params.resources.rare_bench_refit_fold.memory }
    time          = { task.attempt > 1 ? params.rare_bench_refit_fold_retry_time   : params.rare_bench_refit_time }
    maxForks      = params.resources.rare_bench_refit_fold.maxForks
    maxRetries    = params.rare_bench_refit_fold_max_retries
    errorStrategy = { (task.exitStatus == null || task.exitStatus in [137, 140, 143, 42]) && task.attempt <= params.rare_bench_refit_fold_max_retries ? 'retry' : 'terminate' }
  }
  withName: 'RARE_BENCH_REFIT_AGGREGATE'             { cpus = params.resources.rare_bench_aggregate.cpus;                   memory = params.resources.rare_bench_aggregate.memory;                   maxForks = params.resources.rare_bench_aggregate.maxForks }
}
