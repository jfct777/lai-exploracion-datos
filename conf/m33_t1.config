params {
  m33_t1_run_id = null
  m33_t1_results_dir = null
  m33_t1_implementation_commit = null
  m33_t1_source_auth = null
  m33_t1_oci_image = null
  m33_t1_t0b_aggregate = null
  m33_t1_t0b_child_receipts = null
}

docker.enabled = true

process {
  executor = 'local'
  errorStrategy = 'terminate'
  maxRetries = 0
  container = params.m33_t1_oci_image
  containerOptions = '--network none --memory 1g --user 1017:1020'

  withName: M33_T1_BACKWARD {
    maxForks = 1
    containerOptions = '--network none --memory 8g --user 1017:1020'
  }
}
