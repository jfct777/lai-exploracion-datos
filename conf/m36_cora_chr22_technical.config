// Bounded technical check over the immutable chr22 materialization.
// It verifies loading, component-disjoint folds, controls, memory and runtime;
// its metrics are not used as the scientific M36 result.
params {
  m36_cora_run_id = 'm36-cora-chr22-technical-20260903a'
  m36_cora_mode = 'train'
  m36_cora_feature_chrom = 'chr22'

  m36_cora_loci = 'gs://teams-usp/frank/lai-exploracion-datos/runs/m36-cora-chr22-materialize-20260903a/m36_cora_set/m36_cora_loci.tsv'
  m36_cora_carriers = 'gs://teams-usp/frank/lai-exploracion-datos/runs/m36-cora-chr22-materialize-20260903a/m36_cora_set/m36_cora_carriers.tsv'
  m36_cora_missing = 'gs://teams-usp/frank/lai-exploracion-datos/runs/m36-cora-chr22-materialize-20260903a/m36_cora_set/m36_cora_missing.tsv'
  m36_cora_covariates = 'gs://teams-usp/frank/lai-exploracion-datos/runs/m36-cora-chr22-materialize-20260903a/m36_cora_set/m36_cora_covariates.tsv'
  m36_cora_components = 'gs://teams-usp/frank/lai-exploracion-datos/runs/m36-cora-chr22-materialize-20260903a/m36_cora_set/m36_cora_components.tsv'
  m36_cora_targets = 'gs://teams-usp/frank/lai-exploracion-datos/runs/m36-cora-chr22-materialize-20260903a/m36_cora_set/m36_cora_external_targets.tsv'
  m36_cora_materialization_receipt = 'gs://teams-usp/frank/lai-exploracion-datos/runs/m36-cora-chr22-materialize-20260903a/m36_cora_set/m36_cora_materialization_receipt.json'

  m36_cora_model_families = 'deep_sets,set_transformer'
  m36_cora_halving_budgets = '4,8'
  m36_cora_halving_eta = 2
  m36_cora_n_folds = 3
  m36_cora_seed = 1701
  m36_cora_train_seeds = '1701'
  m36_cora_bootstrap_reps = 25
  m36_cora_positive_min_relative_mse_reduction = 0.10

  m36_cora_train_cpus = 8
  m36_cora_train_memory = '32 GB'
  m36_cora_train_time = '2h'
}

workDir = 'gs://teams-usp/frank/lai-exploracion-datos/work/nextflow/m36-cora-chr22-technical-20260903a'

process {
  withName: 'M36_CORA_SET_TRAIN' {
    executor = 'google-batch'
    cpus = params.m36_cora_train_cpus
    memory = params.m36_cora_train_memory
    time = params.m36_cora_train_time
    errorStrategy = 'terminate'
    maxRetries = 0
  }
}
