params {
  // Original run identity is preserved because every family receipt binds it.
  m37_run_id = 'm37-r0-compact-sweep-20260903a'
  m37_root = 'R0'
  m37_recovery_id = 'm37-r0-compact-recovery-20260903a'
  m37_recovery_contract = 'conf/m37_trace_compact_recovery_contract.json'
  m37_recovery_source_archive = '/tmp/m37-r0-compact-sweep-20260903a.sources.tar'

  // Exact task work directories recorded before the coordinator received SIGHUP.
  m37_recovery_positive_control_work_dir = 'gs://teams-usp/frank/lai-exploracion-datos/work/nextflow/m37-r0-compact-sweep-20260903a/f7/4d530957c37cc1eea08edbf8186d33'
  m37_recovery_hmm_work_dir = 'gs://teams-usp/frank/lai-exploracion-datos/work/nextflow/m37-r0-compact-sweep-20260903a/04/7b6663bf9c6f05d8bebc372df99732'
  m37_recovery_tcn_work_dir = 'gs://teams-usp/frank/lai-exploracion-datos/work/nextflow/m37-r0-compact-sweep-20260903a/94/05b1ec5fe43a7f266b2bf317b5f4ae'
}

includeConfig 'm37_trace_gcp.config'

// Recovery never shares the abandoned coordinator cache and never launches a
// family sweep. Only the gate, metric collector and decision can be scheduled.
workDir = 'gs://teams-usp/frank/lai-exploracion-datos/work/nextflow/m37-r0-compact-recovery-20260903a'

process {
  resourceLabels = [team: 'frank', lane: 'm37-recovery']
}
