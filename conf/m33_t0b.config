params {
  m33_t0b_run_id = null
  m33_t0b_results_dir = null
  // Frozen full chromosome 22 axis; this is a technical gate, not a tunable screen.
  m33_t0b_marker_count = 79791
  m33_t0b_implementation_commit = null
  m33_t0b_source_auth = null
  m33_t0b_oci_image = null
  m33_t0b_t0a_aggregate = null
  m33_t0b_t0a_source_auth = null
  m33_t0b_t0a_child_receipts = null
  m33_t0b_root17_dir = null
  m33_t0b_root17_verify = null
  m33_t0b_root17_map = null
  m33_t0b_root18_dir = null
  m33_t0b_root18_verify = null
  m33_t0b_root18_map = null
}

docker.enabled = true

process {
  executor = 'local'
  errorStrategy = 'terminate'
  maxRetries = 0
  container = params.m33_t0b_oci_image
  containerOptions = '--network none --memory 1g --user 1017:1020'

  withName: M33_T0B_FORWARD {
    maxForks = 3
    containerOptions = '--network none --memory 8g --user 1017:1020'
  }
}
