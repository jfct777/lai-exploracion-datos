import groovy.json.JsonSlurper
import java.security.MessageDigest

plugins {
  id 'nf-google@1.27.3'
}

def m33KatGate = System.getenv('DNABR_M33_INFRA_KAT')
if( m33KatGate != '1' ) {
  throw new IllegalStateException('M33 Tabix KAT permanece bloqueado sin DNABR_M33_INFRA_KAT=1.')
}

def m33KatRunId = System.getenv('DNABR_RUN_ID')
if( !m33KatRunId || !(m33KatRunId ==~ /[a-z0-9][a-z0-9._-]{2,63}/) ) {
  throw new IllegalStateException('DNABR_RUN_ID no es válido para M33 Tabix KAT.')
}

def m33KatImage = System.getenv('DNABR_M33_TABIX_IMAGE')
def m33KatRepository = 'us-central1-docker.pkg.dev/uspbr-242713/dnabr-lai/m33-tabix'
def m33KatRoot = 'gs://teams-usp/frank/lai-exploracion-datos'
if( !m33KatImage || !(m33KatImage ==~ /us-central1-docker\.pkg\.dev\/uspbr-242713\/dnabr-lai\/m33-tabix@sha256:[0-9a-f]{64}/) ) {
  throw new IllegalStateException('La imagen M33 Tabix debe fijarse por repository@sha256.')
}

def m33ControllerReceiptPath = System.getenv('DNABR_M33_CONTROLLER_RECEIPT')
if( !m33ControllerReceiptPath ) {
  throw new IllegalStateException('M33 Tabix KAT solo puede iniciarse mediante el runner controlador autenticado.')
}
def m33ControllerReceiptFile = new File(m33ControllerReceiptPath)
if( !m33ControllerReceiptFile.isFile() ) {
  throw new IllegalStateException('No existe el recibo del runner controlador M33.')
}
def m33ControllerReceipt = new JsonSlurper().parse(m33ControllerReceiptFile)
def m33AuthorizationFile = new File(System.getenv('DNABR_M33_AUTHORIZATION') ?: '')
if( !m33AuthorizationFile.isFile() ) {
  throw new IllegalStateException('No existe la autorización M33 indicada por el runner.')
}
def m33AuthorizationSha = MessageDigest.getInstance('SHA-256').digest(m33AuthorizationFile.bytes).encodeHex().toString()
def m33SourceAuthFile = new File(System.getenv('DNABR_M33_SOURCE_AUTH') ?: '')
if( !m33SourceAuthFile.isFile() ) {
  throw new IllegalStateException('No existe la autorización del bundle de código M33.')
}
def m33SourceAuthSha = MessageDigest.getInstance('SHA-256').digest(m33SourceAuthFile.bytes).encodeHex().toString()
def m33Authorization = new JsonSlurper().parse(m33AuthorizationFile)
def m33AuthorizedDigest = m33Authorization.runtime?.oci_digest
def m33AuthorizedRepository = m33Authorization.runtime?.oci_repository
if( !(m33AuthorizedDigest instanceof String) ||
    !(m33AuthorizedDigest ==~ /sha256:[0-9a-f]{64}/) ||
    m33AuthorizedRepository != m33KatRepository ||
    m33KatImage != "${m33AuthorizedRepository}@${m33AuthorizedDigest}" ) {
  throw new IllegalStateException('La autorización M33 no contiene el digest OCI publicado de esta imagen.')
}
def m33ExpectedReceiptKeys = [
  'stage', 'status', 'controller_service_account', 'authorization_sha256',
  'runtime_image', 'nextflow_version', 'nf_google_version', 'run_id',
  'work_prefix', 'source_auth_sha256', 'real_asset_read'
] as Set
if( m33ControllerReceipt.stage != 'M33_TABIX_KAT_CONTROLLER' ||
    m33ControllerReceipt.keySet() != m33ExpectedReceiptKeys ||
    m33ControllerReceipt.status != 'PASS_CONTROLLER_IDENTITY_AND_AUTHORIZATION' ||
    m33ControllerReceipt.controller_service_account != 'dnabr-m33-controller-frank@uspbr-242713.iam.gserviceaccount.com' ||
    m33ControllerReceipt.authorization_sha256 != m33AuthorizationSha ||
    m33ControllerReceipt.runtime_image != m33KatImage ||
    m33ControllerReceipt.run_id != m33KatRunId ||
    m33ControllerReceipt.work_prefix != "${m33KatRoot}/work/nextflow/${m33KatRunId}/" ||
    m33ControllerReceipt.source_auth_sha256 != m33SourceAuthSha ) {
  throw new IllegalStateException('El recibo del runner controlador no autentica esta corrida M33.')
}

params {
  m33_tabix_kat_authorization = m33AuthorizationFile.toString()
  m33_tabix_kat_run_id = m33KatRunId
  m33_tabix_container = m33KatImage
  m33_tabix_kat_real_asset_read = false
  m33_tabix_kat_training = false
}

google {
  project = 'uspbr-242713'
  location = 'us-central1'
  batch {
    serviceAccountEmail = 'dnabr-m33-frank@uspbr-242713.iam.gserviceaccount.com'
    spot = false
    maxSpotAttempts = 0
  }
}

process {
  executor = 'google-batch'
  container = m33KatImage
  resourceLabels = [team: 'frank']
  maxForks = 2
}

workDir = "${m33KatRoot}/work/nextflow/${m33KatRunId}"
