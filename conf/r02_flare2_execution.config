/*
 * Execution template for workflows/r02_flare2_versioned.nf.
 * Null data/container/result values are deliberate: this file is not an
 * admitted human-data run and cannot launch until exact paths are supplied.
 */
params {
  r02_flare2_execution_scope = 'FIT_ONLY_TRANSDUCTIVE_MODEL_BUILD_NOT_EVALUATION'
  r02_flare2_run_direct = false
  r02_flare2_prior_direct_receipt = null

  r02_flare2_chromosome = null
  r02_flare2_config = null
  r02_flare2_reference_vcf = null
  r02_flare2_reference_index = null
  r02_flare2_target_vcf = null
  r02_flare2_target_index = null
  r02_flare2_direct_panel_map = null
  r02_flare2_fine_panel_map = null
  r02_flare2_panel_to_ancestry = null
  r02_flare2_genetic_map = null
  r02_flare2_excludemarkers = null
  r02_flare2_flare_jar = null
  r02_flare2_official_builder = null
  r02_flare2_roles = null

  r02_flare2_launcher = "${baseDir}/../bin/r02_flare_versioned.py"
  r02_flare2_model_io = "${baseDir}/../bin/r02_flare2_model_io.py"
  r02_flare2_seeded_builder = "${baseDir}/../bin/r02_flare2_seeded_create_model.py"
  r02_flare2_m35_runner = "${baseDir}/../bin/m35_flare2_paired.py"
  r02_flare2_m34_runner = "${baseDir}/../bin/m34_run_flare.py"

  r02_flare2_container = null
  r02_flare2_results = null
  // A real admitted run must size these from its JSON java_heap_mib/nthreads
  // and an explicit measured reserve. Nulls prevent accidental launch.
  r02_flare2_cpus = null
  r02_flare2_memory = null
  r02_flare2_memory_reserve_mib = null
  r02_flare2_model_memory = null
  r02_flare2_panel_time = null
  r02_flare2_model_time = null
  r02_flare2_inference_time = null
  r02_flare2_max_forks = null
}

docker.enabled = true

process {
  executor = 'local'
  errorStrategy = 'terminate'
  maxRetries = 0
}
