params {
  m31_pre2_run_id = System.getenv('DNABR_RUN_ID')
  m31_pre2_preregistration = "${baseDir}/../conf/m31_ordered_linear_pre2_preregistration.json"
  m31_pre2_genetic_map = null
  m31_pre2_results_dir = "gs://projects-usp/dnaBr-lai/datalake/refined/DNABR_QC/runs/${System.getenv('DNABR_RUN_ID') ?: 'RUN_ID_REQUIRED'}/31_ordered_linear_pre2"
  m31_pre2_work_dir = "/home/jose.tantalean/dnabr-lai/work/${System.getenv('DNABR_RUN_ID') ?: 'RUN_ID_REQUIRED'}/31_ordered_linear_pre2"
  m31_pre2_min_local_disk_gib = 20

  // The repository/image name must be supplied explicitly; the digest is frozen.
  m31_pre2_container_image = System.getenv('DNABR_M31_PRE2_CONTAINER_IMAGE')
  m31_pre2_container_digest = 'sha256:2c30d018028636ac1b7a4890641e04b3e15be8c79d991dfade35b90db0e17bd1'
  // Pregate processes receive no user-controlled mounts or broad datalake bind.
  m31_pre2_pregate_container_options = ''
  // The scorer alone receives the VM's Cloud SDK, read-only, to make the
  // generation-zero claim and fetch root18 truth after the OPEN receipt.
  m31_pre2_scorer_container_options = '-v /usr/lib/google-cloud-sdk:/usr/lib/google-cloud-sdk:ro'

  // Both remain absent until the user has reviewed duration/cost and authorizes a run.
  m31_pre2_execution_authorization = null
  m31_pre2_cost_cap_usd = null

  // The workers screen runs 1, 4 and 8 sequentially.  The workers=4 artifact
  // is the only one consumed downstream after exact semantic equality.
  m31_pre2_fit_memory = '16 GB'
  m31_pre2_fit_time = '24h'
  m31_pre2_score_memory = '8 GB'
  m31_pre2_score_time = '2h'

  m31_pre2_pre1_c_checkpoint = null
  m31_pre2_pre1_c_prediction = null
  m31_pre2_pre1_c_checkpoint_sha256 = 'dc1c8747d81b0aaedfe949f46188eca5759e99e2d70972493891438fbac29ab7'
  m31_pre2_pre1_c_prediction_sha256 = '923d67cc0af29d641a67b166b35e89cf7f1a71eebc18d35d056ba2f493975f7c'
  m31_pre2_pre1_c_metrics = [
    alpha: 0.01,
    boundary_weight: 1.0,
    'cv_boundary_F1_at_0.2cM': 0.7245508982035928,
    'cv_false_transitions_per_cM_at_0.2cM': 0.02252698375310415,
    cv_macro_ancestry_dose_MAE: 0.02700018795763942,
    cv_Brier: 0.020907216102530986,
    selection_status: 'NO_GUARDED_CONFIG'
  ]

  m31_pre2_root17_sites = null
  m31_pre2_root17_target = null
  m31_pre2_root17_tree = null
  m31_pre2_root17_pools = null
  m31_pre2_root17_truth = null
  m31_pre2_root17_flare_vcf = null
  m31_pre2_root17_flare_audit = null

  // root18 truth is intentionally a string, not a Nextflow path input.  Only
  // SCORE_ROOT18 receives it and opens it after a durable one-time claim.
  m31_pre2_root18_sites = null
  m31_pre2_root18_target = null
  m31_pre2_root18_tree = null
  m31_pre2_root18_pools = null
  m31_pre2_root18_flare_vcf = null
  m31_pre2_root18_flare_audit = null
  m31_pre2_root18_truth_source = null
  m31_pre2_opening_ledger_uri = 'gs://projects-usp/dnaBr-lai/datalake/refined/DNABR_QC/control/M31_ORDERED_LINEAR_DEV_PRE2.root18-20260818.CLAIMED.json'
}

docker.enabled = true
workDir = params.m31_pre2_work_dir

process {
  executor = 'local'
  errorStrategy = 'terminate'
  maxRetries = 0
}

trace {
  enabled = true
  file = "${params.m31_pre2_results_dir}/trace.tsv"
  overwrite = false
}

timeline {
  enabled = true
  file = "${params.m31_pre2_results_dir}/timeline.html"
  overwrite = false
}

report {
  enabled = true
  file = "${params.m31_pre2_results_dir}/report.html"
  overwrite = false
}
