// R0 triage uses only the canonical M34 FIT split.  VALID is intentionally
// absent and remains available only to the frozen-evaluation workflow.
params {
  m37_run_id = 'm37-r0-triage-20260902a'
  m37_root = 'R0'
  m37_run_overlay_config = 'conf/m37_r0_triage.config'
  m37_run_overlay_uri = 'repo://conf/m37_r0_triage.config'

  m37_fit_selected = 'gs://teams-usp/frank/lai-exploracion-datos/runs/m34-nam-128-r0-20260827a/fit/bridge/m34_fit_bridge/m34_selected_loci.npz'
  m37_fit_target = 'gs://teams-usp/frank/lai-exploracion-datos/runs/m34-nam-128-r0-20260827a/fit/bridge/m34_fit_bridge/m34_target_rare_diploid.npz'
  m37_fit_reference_folds = 'gs://teams-usp/frank/lai-exploracion-datos/runs/m34-nam-128-r0-20260827a/fit/bridge/m34_fit_bridge/m34_reference_rare_summary.npz'
  m37_fit_f0 = 'gs://teams-usp/frank/lai-exploracion-datos/runs/m34-nam-128-r0-20260827a/fit/f0/m34_fit_f0/m34_f0.npz'
  m37_fit_marker_cm = 'gs://teams-usp/frank/lai-exploracion-datos/runs/m34-nam-128-r0-20260827a/fit/f0/m34_fit_f0/marker_cM.npz'
  m37_fit_f0_receipt = 'gs://teams-usp/frank/lai-exploracion-datos/runs/m34-nam-128-r0-20260827a/fit/f0/m34_fit_f0/m34_f0.receipt.json'
  m37_fit_truth = 'gs://teams-usp/frank/lai-exploracion-datos/runs/m34-nam-128-r0-20260827a/fit/truth/m34_fit_truth/truth.npz'
}

// The generic cloud config is parsed before this run overlay, so bind the
// work namespace here after m37_run_id is known.  This keeps every retry and
// cache entry isolated from other M37 roots.
workDir = 'gs://teams-usp/frank/lai-exploracion-datos/work/nextflow/m37-r0-triage-20260902a'
