params {
  m28c_b0_root_seed = 20260818
  m28c_b0_tree_sequence = "${baseDir}/../results/28_lai_simulation_preflight_seed20260818/seed-20260818/m28/m28_sources.trees"
  m28c_b0_pool_manifest = "${baseDir}/../results/28_lai_simulation_preflight_seed20260818/seed-20260818/m28/m28_pools.private.tsv"
  m28c_b0_mosaic_events = "${baseDir}/../results/28_lai_simulation_preflight_seed20260818/seed-20260818/m28/m28_mosaic_events.private.tsv.gz"
  m28c_b0_markers = "${baseDir}/../results/28b_lai_optimal_matching_audit/run1/m28b_v4_validation/m28b_v4_validation_B0.tsv.gz"
  m28c_b0_preregistration = "${baseDir}/../conf/m28c_b0_input_preregistration.json"
  m28c_gnomix_ingest_preregistration = "${baseDir}/../conf/m28c_gnomix_ingest_preregistration.json"
  m28c_b0_results_dir = "${baseDir}/../results/28c_b0_input_preflight"
  m28c_b0_container_image = "dnabr-m28-lai-sim:0.1.1"
  m28c_b0_container_digest = "sha256:1f08736aa2750eac4ab8fb0506fb22bad91d2266b7b02b9e35d971f554b807f7"
  m28c_gnomix_container_image = "dnabr-m28c-gnomix:e758f2c-r2"
  m28c_gnomix_container_digest = "sha256:fabae8702a7f3fef9225bd5d18206fec240ff5d849cd8f405adb385afd7697d5"
  m28c_b0_container_options = System.getenv('DNABR_CONTAINER_OPTIONS') ?: ''
  // Streaming 574k simulated sites while retaining only 79,791 B0 sites is
  // predominantly single-threaded. These are conservative local ceilings.
  m28c_b0_cpus = 2
  m28c_b0_memory = "4 GB"
  m28c_b0_time = "30m"
  // BGZF/Tabix conversion and the exact Gnomix loader are I/O-bound and
  // validated before any model training is allowed.
  m28c_gnomix_ingest_cpus = 2
  m28c_gnomix_ingest_memory = "4 GB"
  m28c_gnomix_ingest_time = "20m"
}

docker.enabled = true

process {
  executor = 'local'
  errorStrategy = 'terminate'
  maxRetries = 0
}
