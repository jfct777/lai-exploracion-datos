includeConfig 'm37_trace_lai.config'

params {
  // The compact lane reuses authenticated materialization and persists only
  // score/audit JSON; it never emits predictions, checkpoints or VALID data.
  m37_compact_candidate_manifest = 'conf/m37_trace_compact_candidates.json'
  m37_compact_parent_contract = 'conf/m37_trace_sweep_contract.json'
  m37_compact_contract_amendment = 'conf/m37_trace_compact_sweep_amendment.json'
  m37_compact_canonical_metrics = null
  m37_compact_canonical_metrics_receipt = null
  m37_compact_feature_files = null
  m37_compact_feature_receipts = null
  m37_compact_cpus = 4
  m37_compact_memory = '16 GB'
  m37_compact_time = '4h'
  m37_compact_max_forks = 2
  m37_compact_positive_control_updates = 1600
}
