params {
  m33_safe_bridge_technical_run_id = null
  m33_safe_bridge_technical_git_commit = null
  m33_safe_bridge_technical_source_auth = null
  m33_safe_bridge_technical_root17_snapshot = null
  m33_safe_bridge_technical_root18_snapshot = null
  m33_safe_bridge_technical_root17_flare_tbi = null
  m33_safe_bridge_technical_root18_flare_tbi = null
  m33_safe_bridge_technical_results_dir = "${baseDir}/../results/33_safe_bridge_technical_kat"
  m33_safe_bridge_technical_cpus = 1
  m33_safe_bridge_technical_memory = '4 GB'
  m33_safe_bridge_technical_time = '30m'
  m33_safe_bridge_technical_container_image = 'us-central1-docker.pkg.dev/uspbr-242713/dnabr-lai/m28-lai-sim@sha256:06e7b70a2484de19c73a18a6fc9ddefbfa1599e43cbcdcd60fd185495dfb9a19'
  m33_safe_bridge_technical_container_options = '--network=none --read-only --user 0:0 --cap-drop=ALL --cap-add=SETUID --cap-add=SETGID --cap-add=CHOWN --cap-add=DAC_OVERRIDE --cap-add=FOWNER --security-opt=no-new-privileges'
}

docker.enabled = true

process {
  executor = 'local'
  errorStrategy = 'terminate'
  maxRetries = 0
  maxForks = 2
  stageInMode = 'copy'
  withName: M33_SAFE_BRIDGE_TECHNICAL_KAT_ROOT {
    publishDir = [path: params.m33_safe_bridge_technical_results_dir, mode: 'copy', overwrite: false]
  }
}
