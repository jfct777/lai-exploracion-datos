params {
    // Reuse the existing M39 image: probability-only NumPy work, no software download.
    m39cal_image = 'us-central1-docker.pkg.dev/uspbr-242713/dnabr-lai/m33-t0a@sha256:c03864a9ed0c56b00fd1a234daee2d17ddfa57d4c426628bd59cd9daf351ee99'
    m39cal_plan = null                 // Frozen search, role hashes and scoring contract.
    m39cal_development = null          // TRAIN + SELECT only; never a whole binder directory.
    m39cal_score = null                // Historical SCORE, opened only after the new fit lock.
    m39cal_comparators_dir = null      // Flat manifest + three predictions + selection + receipt.
    m39cal_output_dir = null           // Fresh append-only local result directory.
}

process {
    executor = 'local'
    errorStrategy = 'terminate'
    maxRetries = 0
    maxForks = 1
    stageInMode = 'copy'
    // Bounded CPU-only diagnostic; launcher additionally caps the complete workflow at 15 min.
    cpus = 2
    memory = '3 GB'
    time = '15m'
    containerOptions = '--pull never --network none --user 1017:1020 --cpus 2 --memory 3g --memory-swap 3g'
    resourceLabels = [team: 'frank', lane: 'm39-calibration']
}

docker.enabled = true
docker.fixOwnership = false
executor.queueSize = 1
executor.cpus = 2
executor.memory = '3 GB'

env {
    OMP_NUM_THREADS = '2'
    OPENBLAS_NUM_THREADS = '2'
    MKL_NUM_THREADS = '2'
    NUMEXPR_NUM_THREADS = '2'
    PYTHONDONTWRITEBYTECODE = '1'
}

trace {
    enabled = true
    overwrite = false
    fields = 'task_id,hash,native_id,name,status,exit,submit,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar,cpus,memory'
}
timeline.enabled = true
report.enabled = true
