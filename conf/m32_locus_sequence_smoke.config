params {
  m32_smoke_preregistration = "${baseDir}/../conf/m32_locus_sequence_smoke_preregistration.json"
  m32_smoke_results_dir = "${baseDir}/../results/32_locus_sequence_smoke"
  m32_smoke_run_id = null
  m32_smoke_git_commit = null
  m32_smoke_seed = 320017
  m32_smoke_cpus = 1
  m32_smoke_memory = '2 GB'
  m32_smoke_time = '20m'
}

process {
  executor = 'local'
  errorStrategy = 'terminate'
  maxRetries = 0
  maxForks = 1
}
