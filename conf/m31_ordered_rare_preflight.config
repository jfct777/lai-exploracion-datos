params {
  m31_preflight_preregistration = "${baseDir}/../conf/m31_ordered_rare_preflight_preregistration.json"
  m31_preflight_results_dir = "${baseDir}/../results/31_ordered_rare_preflight"
  m31_preflight_container_image = "dnabr-m29-same-locus:0.1.0"
  m31_preflight_container_options = System.getenv('DNABR_CONTAINER_OPTIONS') ?: ''
  m31_preflight_cpus = 2
  m31_preflight_memory = '8 GB'
  m31_preflight_time = '1h'

  m31_preflight_root17_tree = 'gs://projects-usp/dnaBr-lai/datalake/refined/DNABR_QC/runs/m28-v2-individual-safe-20260817a/seed17-b/seed-20260817/m28/m28_sources.trees'
  m31_preflight_root17_pools = 'gs://projects-usp/dnaBr-lai/datalake/refined/DNABR_QC/runs/m28-v2-individual-safe-20260817a/seed17-b/seed-20260817/m28/m28_pools.private.tsv'
  m31_preflight_root17_catalog = 'gs://projects-usp/dnaBr-lai/datalake/refined/DNABR_QC/runs/m28-v2-individual-safe-20260817a/seed17-b/seed-20260817/m28/m28_rare_catalog.tsv.gz'
  m31_preflight_root17_haplotypes = 'gs://projects-usp/dnaBr-lai/datalake/refined/DNABR_QC/runs/m28-v2-individual-safe-20260817a/seed17-b/seed-20260817/m28/m28_rare_haplotypes.tsv.gz'

  m31_preflight_root18_tree = 'gs://projects-usp/dnaBr-lai/datalake/refined/DNABR_QC/runs/m28-v2-individual-safe-20260817a/seed18-a/seed-20260818/m28/m28_sources.trees'
  m31_preflight_root18_pools = 'gs://projects-usp/dnaBr-lai/datalake/refined/DNABR_QC/runs/m28-v2-individual-safe-20260817a/seed18-a/seed-20260818/m28/m28_pools.private.tsv'
  m31_preflight_root18_catalog = 'gs://projects-usp/dnaBr-lai/datalake/refined/DNABR_QC/runs/m28-v2-individual-safe-20260817a/seed18-a/seed-20260818/m28/m28_rare_catalog.tsv.gz'
  m31_preflight_root18_haplotypes = 'gs://projects-usp/dnaBr-lai/datalake/refined/DNABR_QC/runs/m28-v2-individual-safe-20260817a/seed18-a/seed-20260818/m28/m28_rare_haplotypes.tsv.gz'
}

docker.enabled = true

process {
  executor = 'local'
  errorStrategy = 'terminate'
  maxRetries = 0
  maxForks = 1
}
