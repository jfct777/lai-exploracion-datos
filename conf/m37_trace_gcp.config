// Explicit opt-in production profile.  Never include this config in local smoke.
plugins {
  id 'nf-google@1.27.3'
}

params {
  m37_batch_root = 'gs://teams-usp/frank/lai-exploracion-datos'
  m37_batch_region = System.getenv('DNABR_CLOUD_REGION') ?: 'us-central1'
  m37_results_dir = "${params.m37_batch_root}/runs"
  m37_container_digest = 'us-central1-docker.pkg.dev/uspbr-242713/dnabr-lai/m33-t0a@sha256:c03864a9ed0c56b00fd1a234daee2d17ddfa57d4c426628bd59cd9daf351ee99'
}
workDir = "${params.m37_batch_root}/work/nextflow/${params.m37_run_id}"
docker.enabled = false

process {
  executor = 'google-batch'
  container = params.m37_container_digest
  // The fixed M33 image declares a non-root account whose numeric identity is
  // absent on Batch-mounted work disks.  Run with the same explicit identity
  // used by the validated local lane so staged outputs remain writable.
  containerOptions = '--user 0:0'
  disk = '30 GB'
  stageInMode = 'copy'
  resourceLabels = [team: 'frank', lane: 'm37-trace']
}

google {
  project = 'uspbr-242713'
  location = params.m37_batch_region
  batch {
    spot = false
    maxSpotAttempts = 0
  }
}
