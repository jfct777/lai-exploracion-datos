params {
  m28d_truth = "${baseDir}/../results/28_lai_simulation_preflight_seed20260818/seed-20260818/m28/m28_lai_truth.tsv.gz"
  m28d_b0_markers = "${baseDir}/../results/28b_lai_optimal_matching_audit/run1/m28b_v4_validation/m28b_v4_validation_B0.tsv.gz"
  m28d_genetic_map = "${baseDir}/../results/28c_gnomix_training_smoke/inputs/genetic.map.chr22"
  m28d_fb_A = "${baseDir}/../results/28c_gnomix_full_b0/replicate-A/full_b0/inference_A/results/query_results.fb"
  m28d_msp_A = "${baseDir}/../results/28c_gnomix_full_b0/replicate-A/full_b0/inference_A/results/query_results.msp"
  m28d_fb_B = "${baseDir}/../results/28c_gnomix_full_b0/replicate-B/full_b0/inference_B/results/query_results.fb"
  m28d_msp_B = "${baseDir}/../results/28c_gnomix_full_b0/replicate-B/full_b0/inference_B/results/query_results.msp"
  m28d_m28c_comparison = "${baseDir}/../results/28c_gnomix_full_b0/comparison/m28c_gnomix_full_b0_compare.public.json"
  m28d_simulation_manifest = "${baseDir}/../results/28_lai_simulation_preflight_seed20260818/seed-20260818/m28/m28_preflight.manifest.json"
  m28d_b0_preflight_manifest = "${baseDir}/../results/28c_b0_input_preflight/run6/seed-20260818/m28c_b0/m28c_b0_input_preflight.manifest.json"
  m28d_ingest_report = "${baseDir}/../results/28c_b0_input_preflight/run6/seed-20260818/m28c_ingest/m28c_b0_gnomix_ingest.public.json"
  m28d_inference_manifest_A = "${baseDir}/../results/28c_gnomix_full_b0/replicate-A/full_b0/inference_A/m28c_gnomix_full_b0_inference.manifest.json"
  m28d_inference_manifest_B = "${baseDir}/../results/28c_gnomix_full_b0/replicate-B/full_b0/inference_B/m28c_gnomix_full_b0_inference.manifest.json"
  m28d_preregistration = "${baseDir}/../conf/m28d_b0_scoring_preregistration.json"
  m28d_results_dir = "${baseDir}/../results/28d_b0_scoring/run1"

  // Local immutable image ID verified against the audited r5 tag before execution.
  m28d_container_image = "sha256:b89353efc9a4a5953519fa9f066728e2f63d0e9125fc9fc771ef3ea9bb9c961c"
  m28d_container_digest = "sha256:b89353efc9a4a5953519fa9f066728e2f63d0e9125fc9fc771ef3ea9bb9c961c"
  m28d_container_options = System.getenv('DNABR_CONTAINER_OPTIONS') ?: ''

  m28d_score_cpus = 2
  m28d_score_memory = "4 GB"
  m28d_score_time = "15m"
}

docker.enabled = true

process {
  executor = 'local'
  errorStrategy = 'terminate'
  maxRetries = 0
  maxForks = 1
}
