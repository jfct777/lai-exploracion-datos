plugins {
  id 'nf-google@1.27.3'
}

params {
  m38_fminus_run_id = 'm38-r0-f-minus-s660-baseline-20260903a'
  m38_fminus_batch_root = 'gs://teams-usp/frank/lai-exploracion-datos'
  m38_fminus_results_dir = "${params.m38_fminus_batch_root}/runs"
  m38_fminus_region = System.getenv('DNABR_CLOUD_REGION') ?: 'us-central1'

  m38_fminus_python_image = 'us-central1-docker.pkg.dev/uspbr-242713/dnabr-lai/m33-t0a@sha256:c03864a9ed0c56b00fd1a234daee2d17ddfa57d4c426628bd59cd9daf351ee99'
  m38_fminus_tabix_image = 'us-central1-docker.pkg.dev/uspbr-242713/dnabr-lai/m33-tabix@sha256:e730c35759e3851a92d7f3a6619333105331d97f1ae44a50dfa8d59745c43e54'
  m38_fminus_container_user = '0:0'

  // The canonical comparison is selected and evaluated by OOF rotation inside FIT.
  // VALID remains addressable only through an explicit command-line override.
  m38_fminus_splits = ['FIT']

  // Immutable FIT artifacts from the canonical M34 R0 run.
  m38_fminus_fit_reference_vcf = 'gs://teams-usp/frank/lai-exploracion-datos/runs/m34-nam-128-r0-20260827a/fit/bridge/m34_fit_bridge/m34_ref_train.chr22.vcf.gz'
  m38_fminus_fit_target_vcf = 'gs://teams-usp/frank/lai-exploracion-datos/runs/m34-nam-128-r0-20260827a/fit/bridge/m34_fit_bridge/m34_target.chr22.vcf.gz'
  m38_fminus_fit_selected_loci = 'gs://teams-usp/frank/lai-exploracion-datos/runs/m34-nam-128-r0-20260827a/fit/bridge/m34_fit_bridge/m34_selected_loci.npz'
  m38_fminus_fit_reference_sha256 = '20f38a170c7f847a17a52df38b511186f46d047916d7075734dac60f30617c8a'
  m38_fminus_fit_target_sha256 = 'c7209b0cf7eb2cf996e79915cdebe22857febc162ee080f828a2518e69deb98d'
  m38_fminus_fit_selected_sha256 = '0bdf50d6812abf3d74975774f1a7257b52c3c263822e8aeaa59cd673c5c31fd0'

  // Immutable VALID artifacts, inactive unless m38_fminus_splits includes VALID.
  m38_fminus_valid_reference_vcf = 'gs://teams-usp/frank/lai-exploracion-datos/runs/m34-nam-128-r0-20260827a/valid/bridge/m34_valid_bridge/m34_ref_train.chr22.vcf.gz'
  m38_fminus_valid_target_vcf = 'gs://teams-usp/frank/lai-exploracion-datos/runs/m34-nam-128-r0-20260827a/valid/bridge/m34_valid_bridge/m34_target.chr22.vcf.gz'
  m38_fminus_valid_selected_loci = 'gs://teams-usp/frank/lai-exploracion-datos/runs/m34-nam-128-r0-20260827a/valid/bridge/m34_valid_bridge/m34_selected_loci.npz'
  m38_fminus_valid_reference_sha256 = 'eaf878473888e5c44847a3bad99226a9e0a34c9b9255376f8116ca6e6a3c32fc'
  m38_fminus_valid_target_sha256 = '56f77e42c178ce194e9cdca1a86574a349f9581a380ca1bf616c526ff33a0ac9'
  m38_fminus_valid_selected_sha256 = '0bdf50d6812abf3d74975774f1a7257b52c3c263822e8aeaa59cd673c5c31fd0'

  m38_fminus_chromosome = '22'
  m38_fminus_expected_full_loci = 42986
  m38_fminus_expected_selected_loci = 660
  m38_fminus_expected_reference_samples = 753
  m38_fminus_expected_fit_samples = 96
  m38_fminus_expected_valid_samples = 32

  m38_fminus_filter_cpus = 1
  m38_fminus_filter_memory = '2 GB'
  m38_fminus_filter_time = '30m'
  m38_fminus_filter_max_forks = 2

  m38_fminus_index_cpus = 1
  m38_fminus_index_memory = '1 GB'
  m38_fminus_index_time = '15m'
  m38_fminus_index_max_forks = 4
}

workDir = "${params.m38_fminus_batch_root}/work/nextflow/${params.m38_fminus_run_id}"
docker.enabled = false

process {
  executor = 'google-batch'
  disk = '10 GB'
  errorStrategy = 'terminate'
  maxRetries = 0
  stageInMode = 'copy'
  resourceLabels = [team: 'frank', lane: 'm38-fminus-s660']
}

google {
  project = 'uspbr-242713'
  location = params.m38_fminus_region
  batch {
    spot = false
    maxSpotAttempts = 0
  }
}
