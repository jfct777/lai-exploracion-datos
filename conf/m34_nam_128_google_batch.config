plugins {
  id 'nf-google@1.27.3'
}

params {
  m34_batch_region = System.getenv('DNABR_CLOUD_REGION') ?: 'us-central1'
  m34_batch_root = 'gs://teams-usp/frank/lai-exploracion-datos'
  m34_inputs_run_id = System.getenv('DNABR_RUN_ID')
  m34_inputs_results_dir = "${params.m34_batch_root}/runs"
  m34_inputs_pytorch_image = (
    'us-central1-docker.pkg.dev/uspbr-242713/dnabr-lai/' +
    'm33-t0a@sha256:c03864a9ed0c56b00fd1a234daee2d17ddfa57d4c426628bd59cd9daf351ee99'
  )
  m34_inputs_container_user = '0:0'

  // Dos tareas por raíz mantienen seis VM como máximo entre R0, R1 y R2.
  m34_inputs_mosaic_max_forks = 2
  m34_inputs_bridge_max_forks = 2
  m34_inputs_tabix_max_forks = 2
  m34_inputs_flare_max_forks = 2
  m34_inputs_parse_max_forks = 2
  m34_inputs_truth_max_forks = 2
  m34_inputs_train_max_forks = 2
  m34_inputs_score_max_forks = 2
  m34_inputs_train_device = 'cpu'
  m34_inputs_train_validation_every = 200
}

workDir = "${params.m34_batch_root}/work/nextflow/${params.m34_inputs_run_id}"
docker.enabled = false

process {
  executor = 'google-batch'
  disk = '30 GB'
  maxForks = 2
  errorStrategy = 'terminate'
  maxRetries = 0
  resourceLabels = [team: 'frank']

  withName: 'M34_NAM_VALIDATE_EXPERIMENT_CONTRACT' {
    container = params.m34_inputs_pytorch_image
  }
  withName: 'M34_NAM_GENERATE_MOSAICS' {
    container = params.m34_inputs_pytorch_image
  }
  withName: 'M34_NAM_PREPARE_PANEL_FACTORS' {
    container = params.m34_inputs_pytorch_image
  }
  withName: 'M34_NAM_TABIX_INDEX' {
    container = params.m34_inputs_tabix_image
  }
  withName: 'M34_NAM_BUILD_FLARE_CONTRACT' {
    container = params.m34_inputs_flare_image
  }
  withName: 'M34_NAM_RUN_FLARE' {
    container = params.m34_inputs_flare_image
  }
  withName: 'M34_NAM_PARSE_F0' {
    container = params.m34_inputs_pytorch_image
  }
  withName: 'M34_NAM_ALIGN_TRUTH' {
    container = params.m34_inputs_pytorch_image
  }
  withName: 'M34_NAM_BUILD_FACTORIZED_MANIFEST' {
    container = params.m34_inputs_pytorch_image
  }
  withName: 'M34_NAM_PACK_BASELINE' {
    container = params.m34_inputs_pytorch_image
  }
  withName: 'M34_NAM_TRAIN_FACTORIZED' {
    container = params.m34_inputs_pytorch_image
    cpus = 4
    memory = '8 GB'
  }
  withName: 'M34_NAM_TRAIN_TRANSFORMER_FACTORIZED' {
    container = params.m34_inputs_pytorch_image
    cpus = 4
    memory = '8 GB'
  }
  withName: 'M34_NAM_SCORE_VALID' {
    container = params.m34_inputs_pytorch_image
    cpus = 1
    memory = '4 GB'
  }
}

executor.queueSize = 2

google {
  project = 'uspbr-242713'
  location = params.m34_batch_region
  batch {
    spot = false
    maxSpotAttempts = 0
  }
}
