docker.enabled = true
docker.runOptions = '--network none --user 1017:1020 --cpus 1 --memory 2g'

process {
    executor = 'local'
    errorStrategy = 'terminate'
    maxRetries = 0
    withName: PREPARE_LAI_CONTEXT_QUERY {
        maxForks = 1
        cpus = 1
        memory = '2 GB'
        time = '30 min'
    }
}
