params {
  // A phase-free exploratory lane: supply all FIT/VALID factors explicitly; no cloud defaults.
  m37_run_id = null
  m37_root = null
  m37_results_dir = null
  m37_run_overlay_config = null
  m37_run_overlay_uri = null
  m37_container_digest = 'local-unspecified'
  m37_fit_selected = null; m37_fit_target = null; m37_fit_reference_folds = null; m37_fit_reference_folds_sham = null
  m37_fit_f0 = null; m37_fit_marker_cm = null; m37_fit_f0_receipt = null; m37_fit_truth = null
  m37_valid_selected = null; m37_valid_target = null; m37_valid_reference_folds = null; m37_valid_reference_folds_sham = null
  m37_valid_f0 = null; m37_valid_marker_cm = null; m37_valid_f0_receipt = null; m37_valid_truth = null
  // Beta(0.5,0.5) gives finite likelihoods at sparse ancestry-specific counts.
  m37_beta_prior_strength = 0.5
  // Compact initial rung; successive-halving candidates may use only the declared ranges.
  m37_updates = 200
  m37_batch_people = 8
  m37_marker_shard = 256
  m37_validation_every = 25
  m37_early_stopping_patience = 4
  m37_tune_fraction = 0.20
  m37_split_seed = 3401103
  m37_event_radius_cm = 0.20
  m37_sham_seed = 3401103
  m37_keep_fraction = 0.5
  // These values implement the preregistered strict-positive F1 and
  // non-worsening log-loss rules; they are not post-hoc effect-size cutoffs.
  m37_promotion_boundary_tolerance_cm = 0.20
  m37_promotion_minimum_f1_gain = 0.0
  m37_promotion_maximum_log_loss_increase = 0.0
  m37_promotion_bootstrap_seed = 1103
  m37_promotion_bootstrap_draws = 2000
  m37_promotion_minimum_replication_roots = 3
  // The distinct frozen-evaluation workflow accepts exactly this one row.
  m37_frozen_candidate = null
  m37_materialize_cpus = 4; m37_materialize_memory = '12 GB'; m37_materialize_time = '45m'
  m37_train_cpus = 4; m37_train_memory = '16 GB'; m37_train_time = '60m'; m37_train_max_forks = 2
  m37_candidates = [
    [candidate_id:'hmm_r0', family:'hmm', arm:'RE', hazard_per_morgan:12.0, evidence_scale:1.0, hidden_dim:32, depth:2, kernel_size:3, dropout:0.0, seed:1103, learning_rate:0.0003, dilations:'1,2'],
    [candidate_id:'hmm_r0', family:'hmm', arm:'RD', hazard_per_morgan:12.0, evidence_scale:1.0, hidden_dim:32, depth:2, kernel_size:3, dropout:0.0, seed:1103, learning_rate:0.0003, dilations:'1,2'],
    [candidate_id:'hmm_r0', family:'hmm', arm:'POOLED', hazard_per_morgan:12.0, evidence_scale:1.0, hidden_dim:32, depth:2, kernel_size:3, dropout:0.0, seed:1103, learning_rate:0.0003, dilations:'1,2'],
    [candidate_id:'hmm_r0', family:'hmm', arm:'SHAM', hazard_per_morgan:12.0, evidence_scale:1.0, hidden_dim:32, depth:2, kernel_size:3, dropout:0.0, seed:1103, learning_rate:0.0003, dilations:'1,2'],
    [candidate_id:'hmm_r0', family:'hmm', arm:'GEOMETRY', hazard_per_morgan:12.0, evidence_scale:1.0, hidden_dim:32, depth:2, kernel_size:3, dropout:0.0, seed:1103, learning_rate:0.0003, dilations:'1,2'],
    [candidate_id:'tcn_r0', family:'tcn', arm:'RE', hazard_per_morgan:12.0, evidence_scale:1.0, hidden_dim:32, depth:2, kernel_size:3, dropout:0.0, seed:1103, learning_rate:0.0003, dilations:'1,2'],
    [candidate_id:'tcn_r0', family:'tcn', arm:'RD', hazard_per_morgan:12.0, evidence_scale:1.0, hidden_dim:32, depth:2, kernel_size:3, dropout:0.0, seed:1103, learning_rate:0.0003, dilations:'1,2'],
    [candidate_id:'tcn_r0', family:'tcn', arm:'POOLED', hazard_per_morgan:12.0, evidence_scale:1.0, hidden_dim:32, depth:2, kernel_size:3, dropout:0.0, seed:1103, learning_rate:0.0003, dilations:'1,2'],
    [candidate_id:'tcn_r0', family:'tcn', arm:'SHAM', hazard_per_morgan:12.0, evidence_scale:1.0, hidden_dim:32, depth:2, kernel_size:3, dropout:0.0, seed:1103, learning_rate:0.0003, dilations:'1,2'],
    [candidate_id:'tcn_r0', family:'tcn', arm:'GEOMETRY', hazard_per_morgan:12.0, evidence_scale:1.0, hidden_dim:32, depth:2, kernel_size:3, dropout:0.0, seed:1103, learning_rate:0.0003, dilations:'1,2']
  ]
}

docker.enabled = true
process {
  executor = 'local'
  errorStrategy = 'terminate'
  maxRetries = 0
}
