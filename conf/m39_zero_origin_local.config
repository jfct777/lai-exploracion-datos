params {
    m39zero_inputs = null
    m39zero_manifest = null
    m39zero_output_dir = null
    m39zero_image = 'us-central1-docker.pkg.dev/uspbr-242713/dnabr-lai/m33-t0a@sha256:c03864a9ed0c56b00fd1a234daee2d17ddfa57d4c426628bd59cd9daf351ee99'
    // Memory-only chunking: all historical people and anchors remain in the audit.
    m39zero_chunk_people = 8
    // Override for other execution users; no root-owned outputs on the development VM.
    m39zero_container_user = '1017:1020'
}
process {
    executor = 'local'
    errorStrategy = 'terminate'
    maxRetries = 0
    maxForks = 1
    stageInMode = 'copy'
    cpus = 1
    memory = '3 GB'
    time = '5m'
    containerOptions = "--pull never --network none --user ${params.m39zero_container_user} --cpus 1 --memory 3g --memory-swap 3g"
    resourceLabels = [team: 'frank', lane: 'm39-zero-origin']
}
docker.enabled = true
docker.fixOwnership = false
executor.queueSize = 1
env {
    OMP_NUM_THREADS = '1'
    OPENBLAS_NUM_THREADS = '1'
    MKL_NUM_THREADS = '1'
    PYTHONDONTWRITEBYTECODE = '1'
}
trace {
    enabled = true
    overwrite = false
    fields = 'task_id,hash,native_id,name,status,exit,duration,realtime,peak_rss,cpus,memory'
}
