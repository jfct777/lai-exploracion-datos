// Resource configuration for DNABR QC pipeline
// Override these via CLI: --resources.preprocess_norm_leftalign.cpus 8

params {
  resources {
    // Module 01: bcftools norm (I/O + compression bound)
    // bcftools --threads only helps with I/O compression, not processing
    // Ref: https://samtools.github.io/bcftools/howtos/scaling.html
    preprocess_norm_leftalign {
      cpus = 2
      memory = '4 GB'
      threads = 2  // bcftools norm threading (I/O only)
      maxForks = null  // no limit by default
    }

    // Module 02: bcftools view + filter (I/O bound)
    preprocess_filter_snv_biallelic_pass {
      cpus = 2
      memory = '4 GB'
      threads = 2  // bcftools view threading (I/O only)
      maxForks = null
    }

    // Module 03: bcftools stats (moderate CPU)
    qc_bcftools_stats {
      cpus = 2
      memory = '4 GB'
      threads = 2  // bcftools stats threading (I/O only)
      maxForks = null
    }

    // Module 04: plink2 --make-pgen (CPU + RAM moderate)
    // plink2 --threads scales well for computation
    // Ref: https://www.cog-genomics.org/plink/2.0/parallel
    qc_plink_make_pgen {
      cpus = 4
      memory = '8 GB'
      threads = 4  // plink2 real threading
      maxForks = null
    }

    // Module 05: plink2 QC (CPU + RAM intensive)
    // This is the heaviest module; limit concurrency on laptops
    qc_plink_missing_het {
      cpus = 4
      memory = '8 GB'
      threads = 4  // plink2 real threading
      maxForks = 2  // limit parallel execution
    }

    // Module 06: Python aggregation (single-threaded)
    qc_aggregate_report_py {
      cpus = 1
      memory = '4 GB'
      threads = 1  // Python script (no parallelization)
      maxForks = 1  // only one aggregation at a time
    }

    // Module 07: SFS (bcftools query + python)
    sfs_from_filtered_vcf {
      cpus = 2
      memory = '4 GB'
      threads = 2
      maxForks = null
    }

    // Module 08: ancestral TSV build (bcftools query + samtools faidx + python)
    build_ancestral_tsv_from_fasta {
      cpus = 2
      memory = '4 GB'
      threads = 2
      maxForks = null
    }

    // Module 09: DAF/DSFS (bcftools query + pandas)
    daf_dsfs_from_ancestral_tsv {
      cpus = 2
      memory = '4 GB'
      threads = 1
      maxForks = null
    }

    // Module 10: LD decay (plink2 heavy)
    ld_decay_from_pgen {
      cpus = 4
      memory = '8 GB'
      threads = 4
      maxForks = 1
    }

    // Module 11: tag SNPs (plink2 pruning)
    tag_snps_from_pgen {
      cpus = 4
      memory = '8 GB'
      threads = 4
      maxForks = 1
    }

    // Module 12a: rare SNP tract scan over upstream rare-only VCFs
    rare_snp_tracts_scan {
      cpus = 20
      memory = '26 GB'
      threads = 4
      maxForks = 8
    }

    // Module 12b: rare SNP tract aggregation, plots and report
    rare_snp_tracts_aggregate {
      cpus = 20
      memory = '26 GB'
      threads = 4
      maxForks = 8
    }

    // Module 13a: per-individual pairwise distance analysis on rare VCFs
    individual_snp_distance_modes_scan {
      cpus = 2
      memory = '24 GB'
      threads = 1
      maxForks = 3
    }

    // Module 13b: aggregate summaries and final HTML report
    individual_snp_distance_modes_aggregate {
      cpus = 1
      memory = '8 GB'
      threads = 1
      maxForks = 1
    }

    // Module 14a: rare allele sharing painting per-chromosome scan
    // Memory is dominated by the per-pair streaming state (up to C(N,2)
    // entries) plus the matplotlib Agg canvas when painting large cohorts
    // (capped via --plot-max-height-inches; see rare_allele_sharing_painter.py).
    // 32 GB is a safety margin for N ~= 2500 with dense rare-variant sharing.
    rare_allele_sharing_scan {
      cpus = 2
      memory = '32 GB'
      threads = 1
      maxForks = 3
    }

    // Module 14b: rare allele sharing aggregation + HTML report
    rare_allele_sharing_aggregate {
      cpus = 1
      memory = '16 GB'
      threads = 1
      maxForks = 1
    }

    // Module 17a: rare variants in LAI tracts, per-chromosome (bcftools stream + .msp numpy)
    rare_in_lai_scan {
      cpus = 2
      memory = '16 GB'
      threads = 1
      maxForks = 8
    }

    // Module 17b: aggregate per-chr summary.json (sum of raw counts; trivial)
    rare_in_lai_aggregate {
      cpus = 1
      memory = '4 GB'
      threads = 1
      maxForks = 1
    }

    // Module 19: rare-variants-on-LAI-painting figure (windowing + matplotlib render)
    rare_on_lai_painting {
      cpus = 2
      memory = '16 GB'
      threads = 1
      maxForks = 8
    }
  }
}

// Apply resources to processes using withName
process {
  withName: 'PREPROCESS_NORM_LEFTALIGN' {
    cpus = params.resources.preprocess_norm_leftalign.cpus
    memory = params.resources.preprocess_norm_leftalign.memory
    maxForks = params.resources.preprocess_norm_leftalign.maxForks
  }

  withName: 'PREPROCESS_FILTER_SNV_BIALLELIC_PASS' {
    cpus = params.resources.preprocess_filter_snv_biallelic_pass.cpus
    memory = params.resources.preprocess_filter_snv_biallelic_pass.memory
    maxForks = params.resources.preprocess_filter_snv_biallelic_pass.maxForks
  }

  withName: 'QC_BCFTOOLS_STATS' {
    cpus = params.resources.qc_bcftools_stats.cpus
    memory = params.resources.qc_bcftools_stats.memory
    maxForks = params.resources.qc_bcftools_stats.maxForks
  }

  withName: 'QC_PLINK_MAKE_PGEN' {
    cpus = params.resources.qc_plink_make_pgen.cpus
    memory = params.resources.qc_plink_make_pgen.memory
    maxForks = params.resources.qc_plink_make_pgen.maxForks
  }

  withName: 'QC_PLINK_MISSING_HET' {
    cpus = params.resources.qc_plink_missing_het.cpus
    memory = params.resources.qc_plink_missing_het.memory
    maxForks = params.resources.qc_plink_missing_het.maxForks
  }

  withName: 'QC_AGGREGATE_REPORT_PY' {
    cpus = params.resources.qc_aggregate_report_py.cpus
    memory = params.resources.qc_aggregate_report_py.memory
    maxForks = params.resources.qc_aggregate_report_py.maxForks
  }

  withName: 'SFS_FROM_FILTERED_VCF' {
    cpus = params.resources.sfs_from_filtered_vcf.cpus
    memory = params.resources.sfs_from_filtered_vcf.memory
    maxForks = params.resources.sfs_from_filtered_vcf.maxForks
  }

  withName: 'BUILD_ANCESTRAL_TSV_FROM_FASTA' {
    cpus = params.resources.build_ancestral_tsv_from_fasta.cpus
    memory = params.resources.build_ancestral_tsv_from_fasta.memory
    maxForks = params.resources.build_ancestral_tsv_from_fasta.maxForks
  }

  withName: 'DAF_DSFS_FROM_ANCESTRAL_TSV' {
    cpus = params.resources.daf_dsfs_from_ancestral_tsv.cpus
    memory = params.resources.daf_dsfs_from_ancestral_tsv.memory
    maxForks = params.resources.daf_dsfs_from_ancestral_tsv.maxForks
  }

  withName: 'LD_DECAY_FROM_PGEN' {
    cpus = params.resources.ld_decay_from_pgen.cpus
    memory = params.resources.ld_decay_from_pgen.memory
    maxForks = params.resources.ld_decay_from_pgen.maxForks
  }

  withName: 'TAG_SNPS_FROM_PGEN' {
    cpus = params.resources.tag_snps_from_pgen.cpus
    memory = params.resources.tag_snps_from_pgen.memory
    maxForks = params.resources.tag_snps_from_pgen.maxForks
  }

  withName: 'ANALYZE_RARE_SNP_TRACTS' {
    cpus = params.resources.rare_snp_tracts_scan.cpus
    memory = params.resources.rare_snp_tracts_scan.memory
    maxForks = params.resources.rare_snp_tracts_scan.maxForks
  }

  withName: 'AGGREGATE_RARE_SNP_TRACTS' {
    cpus = params.resources.rare_snp_tracts_aggregate.cpus
    memory = params.resources.rare_snp_tracts_aggregate.memory
    maxForks = params.resources.rare_snp_tracts_aggregate.maxForks
  }

  withName: 'ANALYZE_INDIVIDUAL_SNP_DISTANCE_MODES' {
    cpus = params.resources.individual_snp_distance_modes_scan.cpus
    memory = params.resources.individual_snp_distance_modes_scan.memory
    maxForks = params.resources.individual_snp_distance_modes_scan.maxForks
  }

  withName: 'AGGREGATE_INDIVIDUAL_SNP_DISTANCE_MODES' {
    cpus = params.resources.individual_snp_distance_modes_aggregate.cpus
    memory = params.resources.individual_snp_distance_modes_aggregate.memory
    maxForks = params.resources.individual_snp_distance_modes_aggregate.maxForks
  }

  withName: 'ANALYZE_RARE_ALLELE_SHARING' {
    cpus = params.resources.rare_allele_sharing_scan.cpus
    memory = params.resources.rare_allele_sharing_scan.memory
    maxForks = params.resources.rare_allele_sharing_scan.maxForks
  }

  withName: 'AGGREGATE_RARE_ALLELE_SHARING' {
    cpus = params.resources.rare_allele_sharing_aggregate.cpus
    memory = params.resources.rare_allele_sharing_aggregate.memory
    maxForks = params.resources.rare_allele_sharing_aggregate.maxForks
  }

  withName: 'ANALYZE_RARE_IN_LAI' {
    cpus = params.resources.rare_in_lai_scan.cpus
    memory = params.resources.rare_in_lai_scan.memory
    maxForks = params.resources.rare_in_lai_scan.maxForks
  }

  withName: 'AGGREGATE_RARE_IN_LAI' {
    cpus = params.resources.rare_in_lai_aggregate.cpus
    memory = params.resources.rare_in_lai_aggregate.memory
    maxForks = params.resources.rare_in_lai_aggregate.maxForks
  }

  withName: 'RARE_ON_LAI_PAINTING' {
    cpus = params.resources.rare_on_lai_painting.cpus
    memory = params.resources.rare_on_lai_painting.memory
    maxForks = params.resources.rare_on_lai_painting.maxForks
  }
}
