    "maximum_guardrail_worsening": {
      "macro_ancestry_dose_MAE": 0.002,
      "NAM_truth_present_MAE": 0.005,
      "false_transitions_per_cM": 0.001,
      "haplotype_Brier": 0.002
    },
    "score_tiebreak_order": [
      "maximize_RE_minus_RD_boundary_F1_0.2cM",
      "maximize_min_RE_minus_RD_boundary_F1_sensitivity",
      "minimize_RE_minus_RD_NAM_truth_present_MAE",
      "minimize_RE_minus_RD_false_transitions_per_cM",
      "minimize_declared_complexity_rank",
      "family_then_config_id_lexical"
    ],
    "promotion_requires": [
      "complete_RD_RE_pair",
      "at_least_three_evaluated_configs_in_family",
      "primary_delta_at_least_provisional_minimum",
      "all_guardrails_within_declared_worsening",
      "config_belongs_to_declared_finite_space"
    ],
    "rank_only_fallback": {
      "enabled_only_if_zero_families_reach_provisional_minimum": true,
      "maximum_families": 2,
      "requires_positive_primary_delta": true,
      "label": "exploratory_rank_only_not_promoted",
      "maximum_guardrail_worsening": {
        "macro_ancestry_dose_MAE": 0.004,
        "NAM_truth_present_MAE": 0.01,
        "false_transitions_per_cM": 0.002,
        "haplotype_Brier": 0.004
      },
      "interpretation": "predeclared_noncatastrophic_fallback_for_radius_sensitivity_only"
    },
    "radius_selection": {
      "requires_all_declared_radii": true,
      "one_family_config_radius_tuple_per_family": true,
      "uses_same_deterministic_score_tiebreak_order": true,
      "no_family_or_architecture_replacement_after_radius_sensitivity": true
    },
    "no_p_values_during_screen": true,
    "no_family_elimination_from_two_or_fewer_points": true,
    "no_retuning_after_finalist_promotion": true
  },
  "training": {
    "optimizer": "AdamW",
