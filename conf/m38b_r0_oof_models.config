  m38b_oof_collect_max_forks = 6
}

workDir = "${params.m38b_oof_batch_root}/work/nextflow/${params.m38b_oof_run_id}"
docker.enabled = false

process {
  executor = 'google-batch'
  container = params.m38b_oof_python_image
  containerOptions = { "--network none --user ${params.m38b_oof_container_user}" }
  disk = '30 GB'
  errorStrategy = 'terminate'
  maxRetries = 0
  stageInMode = 'copy'
  resourceLabels = [team: 'frank', lane: 'm38b-oof-models']
}

executor.queueSize = 8
google {
  project = 'uspbr-242713'
  location = params.m38b_oof_region
  batch { spot = false; maxSpotAttempts = 0 }
}
