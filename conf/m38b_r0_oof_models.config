  m38b_oof_inner_seed_start = 38100000
  m38b_oof_lambda_grid = '0,0.25,0.5,1,2'
  m38b_oof_event_radius_cm = 0.2
  m38b_oof_evidence_scale = 2.0
  m38b_oof_hidden_dim = 96
  m38b_oof_depth = 3
  m38b_oof_kernel_size = 5
  m38b_oof_dropout = 0.0
  m38b_oof_dilations = '1,2,4'
  m38b_oof_updates = 800
  m38b_oof_learning_rate = 0.0001
  m38b_oof_batch_people = 8
  m38b_oof_marker_shard = 256
  m38b_oof_validation_every = 25
  m38b_oof_patience = 4
  m38b_oof_bootstrap_replicates = 10000
