  m38b_oof_amendment_1_sha256 = '26bfec992f977cfd15033376a211dd9436a71e0b1542186a1ebf3bf335622c15'
  m38b_oof_amendment_2_sha256 = '472607c4f95d782ae4a540decb994adcee09a2469ac7aae7b3df27a66b61bda8'
  m38b_oof_beta_prior_strength = 0.5
  m38b_oof_sham_seed = 3401103
