// Each worker serializes its declared paired arms; at most two configurations run together.
plugins { id 'nf-google@1.27.3' }
params {
    m39_gpu_run_id = System.getenv('M39_GPU_RUN_ID') ?: 'UNSET'
    m39_gpu_image = System.getenv('M39_GPU_IMAGE') ?: 'UNSET'
    m39_task_seconds = {
        def value = (System.getenv('M39_TRAIN_TASK_SECONDS') ?: '0') as int
        if (!(value in 60..28800)) throw new IllegalArgumentException('Frozen task duration required')
        value
    }()
    m39_max_workers = {
        def value = (System.getenv('M39_TRAIN_MAX_WORKERS') ?: '0') as int
        if (!(value in 1..2)) throw new IllegalArgumentException('One or two workers required')
        value
    }()
}
workDir = "gs://teams-usp/frank/lai-exploracion-datos/runs/${params.m39_gpu_run_id}/work"
params.m39_output_dir = "gs://teams-usp/frank/lai-exploracion-datos/runs/${params.m39_gpu_run_id}/outputs"
docker.enabled = false
process {
    executor = 'google-batch'
    container = params.m39_gpu_image
    // Batch COS supplies GPU access and driver mounts for the accelerator.
    containerOptions = '--user 0:0'
    machineType = 'g2-standard-8'
    accelerator = [request: 1, type: 'nvidia-l4']
    cpus = 2
    memory = '8 GB'
    disk = '50 GB'
    time = "${params.m39_task_seconds}s"
    maxForks = params.m39_max_workers
    maxRetries = 0
    stageInMode = 'copy'
    errorStrategy = 'terminate'
    resourceLabels = [team: 'frank', lane: 'm39-ordered-training', m39_run: params.m39_gpu_run_id]
}
executor.queueSize = params.m39_max_workers
google {
    project = 'uspbr-242713'
    location = 'us-central1'
    batch {
        serviceAccountEmail = (System.getenv('M39_GPU_SERVICE_ACCOUNT') ?: '')
            .find(/^[a-z0-9][a-z0-9-]*@(?:developer\.gserviceaccount\.com|[a-z0-9][a-z0-9-]*\.iam\.gserviceaccount\.com)$/)
            ?: { throw new IllegalArgumentException('Verified native VM service account required') }()
        spot = false
        maxSpotAttempts = 0
        installGpuDrivers = true
    }
}
