// Include from a pinned launcher -C config; image, resources and paths are
// explicit launcher inputs. Never inherit the historical HPC default profile.
process {
    executor = 'local'
    stageInMode = 'symlink'
    cache = 'deep'
    beforeScript = 'umask 077'
    withName: PREPROCESS_FILTER_SNV_BIALLELIC_PASS {
        publishDir = [path: { "${params.outdir}/02_filter" }, mode: 'copy', overwrite: false]
    }
    withName: RECOVER_M02_ADMISSION {
        publishDir = [path: { "${params.outdir}/admission" }, pattern: 'admission.json', mode: 'copy', overwrite: false]
    }
}
executor.queueSize = 1
