docker.enabled = true
docker.runOptions = '--network none --log-driver none --user 1017:1020 --cpus 1 --memory 2g -v /mnt/disks/r02-neural-cx:/mnt/disks/r02-neural-cx:ro -v /home/jose.tantalean/projects/lai-exploracion-datos:/home/jose.tantalean/projects/lai-exploracion-datos:ro'
process.executor = 'local'
process.errorStrategy = 'terminate'
process.maxRetries = 0
process.maxForks = 2
params.max_forks = 2
executor {
    queueSize = 2
    cpus = 2
    memory = '4 GB'
}
