plugins {
  id 'nf-google@1.27.3'
}

params {
  m35_batch_region = System.getenv('DNABR_CLOUD_REGION') ?: 'us-central1'
  m35_batch_root = 'gs://teams-usp/frank/lai-exploracion-datos'
  m35_run_id = System.getenv('DNABR_RUN_ID')
  m35_results_dir = "${params.m35_batch_root}/runs"
  m35_contract = "${baseDir}/../conf/m35_flare2_paired_contract.json"

  m35_reference_vcf = null
  m35_reference_tbi = null
  m35_target_vcf = null
  m35_target_tbi = null
  m35_sample_map = null
  m35_panel_macro_map = null
  m35_genetic_map = null
  // The inference image is built from containers/m35-flare2 and must be supplied by digest.
  m35_container_image = null
  // Canonical M34 parsing/packing/scoring runtime, supplied by digest.
  m35_scoring_image = (
    'us-central1-docker.pkg.dev/uspbr-242713/dnabr-lai/' +
    'm33-t0a@sha256:c03864a9ed0c56b00fd1a234daee2d17ddfa57d4c426628bd59cd9daf351ee99'
  )
  m35_truth_npz = null
  m35_canonical_f0_metrics = null
  m35_container_user = '0:0'

  // An explicit false is required to permit inference and the separate truth-opened score stage.
  m35_preflight_only = true
  m35_cpus = 4
  m35_memory = '8 GB'
  m35_time = '12h'
  m35_max_forks = 1
  m35_score_cpus = 1
  m35_score_memory = '4 GB'
  m35_score_time = '4h'
  m35_score_max_forks = 1
}

workDir = "${params.m35_batch_root}/work/nextflow/${params.m35_run_id}"
docker.enabled = false

process {
  executor = 'google-batch'
  disk = '30 GB'
  maxForks = 1
  errorStrategy = 'terminate'
  maxRetries = 0
  stageInMode = 'copy'
  resourceLabels = [team: 'frank']
}

executor.queueSize = 1

google {
  project = 'uspbr-242713'
  location = params.m35_batch_region
  batch {
    spot = false
    maxSpotAttempts = 0
  }
}
