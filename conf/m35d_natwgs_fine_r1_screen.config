plugins {
  id 'nf-google@1.27.3'
}

params {
  m35d_run_id = System.getenv('DNABR_RUN_ID')
  m35d_results_dir = 'gs://teams-usp/frank/lai-exploracion-datos/runs'
  m35d_contract = "${baseDir}/../conf/m35d_natwgs_fine_r1_contract.json"
  m35d_roles = null
  m35d_phased_scaffold_vcf = null
  m35d_target_vcf = null
  m35d_target_tbi = null
  m35d_genetic_map = null
  m35d_m27d_manifest = null
  m35d_m27d_strata = null
  m35d_m27d_training_set = null
  m35d_m27d_related_pairs = null
  m35d_r1_donor_audit = null
  m35d_r1_mosaic_receipt = null
  m35d_flare2_image = null
  m35d_tabix_image = 'us-central1-docker.pkg.dev/uspbr-242713/dnabr-lai/m33-tabix@sha256:e730c35759e3851a92d7f3a6619333105331d97f1ae44a50dfa8d59745c43e54'
  m35d_scoring_image = 'us-central1-docker.pkg.dev/uspbr-242713/dnabr-lai/m33-t0a@sha256:c03864a9ed0c56b00fd1a234daee2d17ddfa57d4c426628bd59cd9daf351ee99'
  m35d_container_user = '1017:1020'
  m35d_executor = System.getenv('DNABR_M35D_EXECUTOR') ?: 'local'
  m35d_prepare_max_forks = 1
  m35d_screen_cpus = 2
  m35d_screen_memory = '5 GB'
  m35d_screen_time = '1h'
  m35d_screen_max_forks = 3
  m35d_batch_region = System.getenv('DNABR_CLOUD_REGION') ?: 'us-central1'
}

process {
  executor = params.m35d_executor
  stageInMode = 'copy'
  errorStrategy = 'terminate'
  maxRetries = 0
  resourceLabels = [team: 'frank']
  withName: /M35D_.*/ { disk = '20 GB' }
}

docker.enabled = params.m35d_executor == 'local'
workDir = params.m35d_executor == 'local' \
  ? "/tmp/nextflow/${params.m35d_run_id}" \
  : "gs://teams-usp/frank/lai-exploracion-datos/work/nextflow/${params.m35d_run_id}"
executor.queueSize = params.m35d_executor == 'local' ? 3 : 6

google {
  project = 'uspbr-242713'
  location = params.m35d_batch_region
  batch { spot = false; maxSpotAttempts = 0 }
}
