plugins {
  id 'nf-google@1.27.3'
}

params {
  m38b_prepare_run_id = 'm38b-r0-prepare-baselines-20260903a'
  m38b_prepare_batch_root = 'gs://teams-usp/frank/lai-exploracion-datos'
  m38b_prepare_results_dir = "${params.m38b_prepare_batch_root}/runs"
  m38b_prepare_region = System.getenv('DNABR_CLOUD_REGION') ?: 'us-central1'
  m38b_prepare_root = 'R0'
  m38b_prepare_partition = 'FIT'

  // Exact FIT derivatives already produced by M38; these exclude S660.
  m38b_prepare_reference_vcf = 'gs://teams-usp/frank/lai-exploracion-datos/runs/m38-r0-f-minus-s660-baseline-20260903a/fit/indexed/reference/m38_f_minus_s660_reference.chr22.vcf.gz'
  m38b_prepare_reference_tbi = 'gs://teams-usp/frank/lai-exploracion-datos/runs/m38-r0-f-minus-s660-baseline-20260903a/fit/indexed/reference/m38_f_minus_s660_reference.chr22.vcf.gz.tbi'
  m38b_prepare_target_vcf = 'gs://teams-usp/frank/lai-exploracion-datos/runs/m38-r0-f-minus-s660-baseline-20260903a/fit/indexed/target/m38_f_minus_s660_target.chr22.vcf.gz'
  m38b_prepare_target_tbi = 'gs://teams-usp/frank/lai-exploracion-datos/runs/m38-r0-f-minus-s660-baseline-20260903a/fit/indexed/target/m38_f_minus_s660_target.chr22.vcf.gz.tbi'
  m38b_prepare_reference_vcf_sha256 = 'ec7869ebf400f6ba920a710f01c986b1cfaecc6709e812a70b2af197e67cf356'
  m38b_prepare_reference_tbi_sha256 = 'ddcbee7afbef48ea0764eeb1ef89c379a4bbee9409e4ce84c59af79ecb7a5c36'
  m38b_prepare_target_vcf_sha256 = 'bee39c39b61f5be47eedf2770ab03367070b57c6a9ea0abb5880fd2efb5dafed'
  m38b_prepare_target_tbi_sha256 = '4a57c0350ce3a8f1213b14da2b63671335dbb55ab59faab1f45c361c751942eb'

  // M34 R0 FIT artifacts are read-only canonical inputs.
  m38b_prepare_sample_map = 'gs://teams-usp/frank/lai-exploracion-datos/runs/m34-nam-128-r0-20260827a/fit/bridge/m34_fit_bridge/m34_ref_train.sample_map.tsv'
  m38b_prepare_sample_map_sha256 = 'c819aeeab51957cc7b11a7f32316d5a1d352998ba8f9e4ae8eab45dbd22803bc'
  m38b_prepare_full_f0 = 'gs://teams-usp/frank/lai-exploracion-datos/runs/m34-nam-128-r0-20260827a/fit/f0/m34_fit_f0/m34_f0.npz'
  m38b_prepare_full_f0_sha256 = '78263df0fb674b72d53f4ddb6544ad4a2efd204fcd2ec739da29c55a0a9dc1f6'
  m38b_prepare_full_marker_cm = 'gs://teams-usp/frank/lai-exploracion-datos/runs/m34-nam-128-r0-20260827a/fit/f0/m34_fit_f0/marker_cM.npz'
  m38b_prepare_full_marker_cm_sha256 = 'df07aedf4565832ea0230dab6667c3c7a4e165ded942be76c78e81b2ff6eb4a5'
  m38b_prepare_full_truth = 'gs://teams-usp/frank/lai-exploracion-datos/runs/m34-nam-128-r0-20260827a/fit/truth/m34_fit_truth/truth.npz'
  m38b_prepare_full_truth_sha256 = 'acfe6c19b87a32fb8d98616b00fe5a3ccbfa93af5e69a2f2e161d796edea7ad1'
  m38b_prepare_selected_loci = 'gs://teams-usp/frank/lai-exploracion-datos/runs/m34-nam-128-r0-20260827a/fit/bridge/m34_fit_bridge/m34_selected_loci.npz'
  m38b_prepare_selected_loci_sha256 = '0bdf50d6812abf3d74975774f1a7257b52c3c263822e8aeaa59cd673c5c31fd0'

  // Genetic map is a lab input and remains read-only. FLARE is the same 0.6
  // binary and image used in M34; only the marker universe changes.
  m38b_prepare_genetic_map = 'gs://projects-usp/dna-do-brasil/dnabr-lai-gnomix/maps/genetic.map.chr22'
  m38b_prepare_genetic_map_sha256 = '33c7a94e0cbc0ce3cc3ff83cd3838119a881cb7e838825521a778e07a01ee6e9'
  m38b_prepare_flare_jar = '/opt/flare/flare.jar'
  m38b_prepare_flare_jar_sha256 = '8c804341b555f302591b12cd72e870b1ca7849055d1dcd2b5cfa09b725bd9420'

  m38b_prepare_expected_full_loci = 42986
  m38b_prepare_expected_selected_loci = 660
  m38b_prepare_expected_fminus_loci = 42326
  m38b_prepare_expected_reference_samples = 753
  m38b_prepare_expected_fit_samples = 96

  m38b_prepare_python_image = 'us-central1-docker.pkg.dev/uspbr-242713/dnabr-lai/m33-t0a@sha256:c03864a9ed0c56b00fd1a234daee2d17ddfa57d4c426628bd59cd9daf351ee99'
  m38b_prepare_flare_image = 'us-central1-docker.pkg.dev/uspbr-242713/dnabr-lai/m30-flare-runtime@sha256:86bf36c5d23407ed187d546f2420a0d2c44fbb6eed12ba81ddfc0f75df6b3a84'
  m38b_prepare_container_user = '0:0'

  m38b_prepare_contract_cpus = 1
  m38b_prepare_contract_memory = '1 GB'
  m38b_prepare_contract_time = '15m'
  m38b_prepare_flare_cpus = 4
  m38b_prepare_flare_memory = '8 GB'
  m38b_prepare_flare_time = '6h'
  m38b_prepare_parse_cpus = 1
  m38b_prepare_parse_memory = '8 GB'
  m38b_prepare_parse_time = '2h'
  m38b_prepare_project_cpus = 1
  m38b_prepare_project_memory = '8 GB'
  m38b_prepare_project_time = '2h'
}

workDir = "${params.m38b_prepare_batch_root}/work/nextflow/${params.m38b_prepare_run_id}"
docker.enabled = false

process {
  executor = 'google-batch'
  disk = '30 GB'
  errorStrategy = 'terminate'
  maxRetries = 0
  stageInMode = 'copy'
  resourceLabels = [team: 'frank', lane: 'm38b-baseline']
}

executor.queueSize = 2

google {
  project = 'uspbr-242713'
  location = params.m38b_prepare_region
  batch {
    spot = false
    maxSpotAttempts = 0
  }
}
