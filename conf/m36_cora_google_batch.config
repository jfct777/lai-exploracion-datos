// Explicit production executor for the isolated M36 workflow.
plugins {
  id 'nf-google@1.27.3'
}

params {
  m36_cora_run_id = System.getenv('M36_CORA_RUN_ID') ?: 'UNSET'
}

workDir = "gs://teams-usp/frank/lai-exploracion-datos/work/nextflow/${System.getenv('M36_CORA_RUN_ID') ?: 'UNSET'}"
docker.enabled = false

process {
  executor = 'google-batch'
  container = 'us-central1-docker.pkg.dev/uspbr-242713/dnabr-lai/m33-t0a@sha256:c03864a9ed0c56b00fd1a234daee2d17ddfa57d4c426628bd59cd9daf351ee99'
  // Google Batch mounts the cloud work directory as root-owned.  The pinned
  // image defaults to the unprivileged `runner` account, which cannot create
  // Nextflow's command and log files on that mount.  Run the isolated task as
  // root inside the disposable container; inputs and published outputs remain
  // governed by the Batch service account and the read/write bucket split.
  containerOptions = '--user 0:0'
  disk = '50 GB'
  maxForks = 1
  errorStrategy = 'terminate'
  maxRetries = 0
  resourceLabels = [team: 'frank', lane: 'm36-cora']

  withName: 'M36_CORA_CANONICAL_ADAPTER' { cpus = 1; memory = '2 GB'; time = '15m' }
  withName: 'M36_CORA_MATERIALIZE' { cpus = 2; memory = '8 GB'; time = '4h' }
  withName: 'M36_CORA_SET_TRAIN' { cpus = 4; memory = '16 GB'; time = '6h' }
}

executor.queueSize = 1

google {
  project = 'uspbr-242713'
  location = 'us-central1'
  batch {
    spot = false
    maxSpotAttempts = 0
  }
}
