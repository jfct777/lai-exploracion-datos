// Local graph/staging check only. This profile cannot submit a Batch task.
params.m39_max_seconds = 1800
params.m39_gpu_run_id = 'm39-gpu-stub-only'
params.m39_gpu_image = 'us-central1-docker.pkg.dev/uspbr-242713/dnabr-lai/stub@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa'
process {
    executor = 'local'
    cpus = 1
    memory = '1 GB'
    time = '1m'
    maxForks = 1
    maxRetries = 0
    errorStrategy = 'terminate'
}
docker.enabled = false
executor.queueSize = 1
