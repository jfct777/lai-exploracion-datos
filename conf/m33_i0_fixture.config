params {
  // Gate explícito: este workflow nunca se abre por herencia de otro perfil.
  m33_i0_fixture_enabled = false
  // Identifica el fixture; no es una raíz científica ni una semilla de simulación.
  m33_i0_fixture_run_id = null
  m33_i0_fixture_authorization = "${baseDir}/../conf/m33_i0_fixture_authorization.json"
  m33_i0_fixture_contract = "${baseDir}/../conf/m33_m0_materializer_contract.json"
  m33_i0_fixture_source_auth = "${baseDir}/../conf/m33_i0_fixture_source_auth.json"
  m33_i0_fixture_real_asset_read = false
  m33_i0_fixture_safe_bridge = false
  m33_i0_fixture_materialize = false
  m33_i0_fixture_training = false
}

docker.enabled = true

process {
  executor = 'local'
  container = 'us-central1-docker.pkg.dev/uspbr-242713/dnabr-lai/m33-tabix@sha256:e730c35759e3851a92d7f3a6619333105331d97f1ae44a50dfa8d59745c43e54'
  maxForks = 1
  maxRetries = 0
  errorStrategy = 'terminate'
  containerOptions = '--network none'
}
