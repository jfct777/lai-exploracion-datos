params {
  m28b_tree_sequence = null
  m28b_pool_manifest = null
  m28b_genetic_map = null
  m28b_baseline_template = null
  m28b_m28_preregistration = "${baseDir}/../conf/m28_lai_simulation_preflight_preregistration.json"
  m28b_preregistration = "${baseDir}/../conf/m28b_lai_marker_capacity_preregistration.json"
  m28b_results_dir = "${baseDir}/../results/28b_lai_marker_capacity_audit"
  m28b_container_image = "dnabr-m28-lai-sim:0.1.1"
  m28b_container_digest = "sha256:1f08736aa2750eac4ab8fb0506fb22bad91d2266b7b02b9e35d971f554b807f7"
  // On shared Linux hosts set DNABR_CONTAINER_OPTIONS='--user <uid>:<gid>' so
  // Docker writes Nextflow trace files with the submitting user's ownership.
  m28b_container_options = System.getenv('DNABR_CONTAINER_OPTIONS') ?: ''
  // M28 measured 729.1 MB RSS and 6m22s while doing more work on the same
  // tree sequence. These ceilings preserve ample margin without oversizing.
  m28b_cpus = 1
  m28b_memory = "4 GB"
  m28b_time = "30m"
}

docker.enabled = true

process {
  executor = 'local'
  errorStrategy = 'terminate'
  maxRetries = 0
}
