plugins { id 'nf-google@1.27.3' }

params {
  m38b_finalizer_run_id = 'm38b-r0-finalize-decision-20260904a'
  m38b_finalizer_source_run_id = 'm38b-r0-oof-models-20260903c'
  m38b_finalizer_batch_root = 'gs://teams-usp/frank/lai-exploracion-datos'
  m38b_finalizer_results_dir = "${params.m38b_finalizer_batch_root}/runs"
  m38b_finalizer_region = System.getenv('DNABR_CLOUD_REGION') ?: 'us-central1'
  m38b_finalizer_input_manifest = "${projectDir}/../conf/m38b_r0_oof_finalizer_inputs.json"
  m38b_finalizer_input_manifest_sha256 = '0d063742f5fdccd27bf1200912f93947048bb62d32621605e3ad69b6875f4b2b'
  m38b_finalizer_code_commit = System.getenv('M38B_FINALIZER_CODE_COMMIT') ?: ''
  m38b_finalizer_python_image = 'us-central1-docker.pkg.dev/uspbr-242713/dnabr-lai/m33-t0a@sha256:c03864a9ed0c56b00fd1a234daee2d17ddfa57d4c426628bd59cd9daf351ee99'
  m38b_finalizer_container_user = '0:0'
}

workDir = "${params.m38b_finalizer_batch_root}/work/nextflow/${params.m38b_finalizer_run_id}"
docker.enabled = false

process {
  executor = 'google-batch'
  container = params.m38b_finalizer_python_image
  containerOptions = { "--network none --user ${params.m38b_finalizer_container_user}" }
  disk = '10 GB'
  errorStrategy = 'terminate'
  maxRetries = 0
  stageInMode = 'copy'
  resourceLabels = [team: 'frank', lane: 'm38b-finalizer']
}

executor.queueSize = 1
google {
  project = 'uspbr-242713'
  location = params.m38b_finalizer_region
  batch { spot = false; maxSpotAttempts = 0 }
}
