params {
  m31_ordered_linear_run_id = System.getenv('DNABR_RUN_ID')
  m31_ordered_linear_preregistration = "${baseDir}/../conf/m31_ordered_linear_preregistration.json"
  m31_ordered_linear_genetic_map = null
  m31_ordered_linear_results_dir = "${baseDir}/../results/runs/${System.getenv('DNABR_RUN_ID') ?: 'RUN_ID_REQUIRED'}/31_ordered_linear"

  // Required explicitly: no existing immutable image is yet authenticated for the M31 dependencies.
  m31_ordered_linear_container_image = null
  m31_ordered_linear_container_digest = null
  m31_ordered_linear_container_options = System.getenv('DNABR_CONTAINER_OPTIONS') ?: ''
  m31_ordered_linear_cpus = 8
  m31_ordered_linear_memory = '16 GB'
  m31_ordered_linear_time = '2h'

  // Root 17: authenticated M31 preflight, M28 truth-bearing simulation and M30 FLARE baseline.
  m31_ordered_linear_root17_sites = null
  m31_ordered_linear_root17_target = null
  m31_ordered_linear_root17_tree = null
  m31_ordered_linear_root17_pools = null
  m31_ordered_linear_root17_truth = null
  m31_ordered_linear_root17_flare_vcf = null
  m31_ordered_linear_root17_flare_audit = null

  // Root 18: same contracts as root 17; the two directions are not independent replicates.
  m31_ordered_linear_root18_sites = null
  m31_ordered_linear_root18_target = null
  m31_ordered_linear_root18_tree = null
  m31_ordered_linear_root18_pools = null
  m31_ordered_linear_root18_truth = null
  m31_ordered_linear_root18_flare_vcf = null
  m31_ordered_linear_root18_flare_audit = null
}

docker.enabled = true

process {
  executor = 'local'
  errorStrategy = 'terminate'
  maxRetries = 0
  maxForks = 1
}
