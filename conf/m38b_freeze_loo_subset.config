plugins {
  id 'nf-google@1.27.3'
}

params {
  m38b_run_id = 'm38b-r0-oof-20260903a'
  m38b_batch_root = 'gs://teams-usp/frank/lai-exploracion-datos'
  m38b_results_dir = "${params.m38b_batch_root}/runs"
  m38b_region = System.getenv('DNABR_CLOUD_REGION') ?: 'us-central1'

  m38b_python_image = 'us-central1-docker.pkg.dev/uspbr-242713/dnabr-lai/m33-t0a@sha256:c03864a9ed0c56b00fd1a234daee2d17ddfa57d4c426628bd59cd9daf351ee99'
  // The pinned M33 image defaults to a non-root UID. Google Batch exposes
  // GCS work objects as root-owned mode 0644/0755, so that UID cannot read
  // Nextflow's .command.run or create .command.log on the mounted workdir.
  // This is the same runtime identity already validated by M38 on this image.
  m38b_loo_container_user = '0:0'
  m38b_panel_vcf = 'gs://projects-usp/nam-diversity/shapeit/phased/natwgs.1000G.sgdp.hgdp.andamanese.hg38.22.norm.PHASED.vcf.gz'
  m38b_panel_sha256 = '71161973b2e233963321feb03db63eff04f14bc5c7a561a2f0dbce623fc05395'
  m38b_split_tsv = 'gs://projects-usp/dnaBr-lai/datalake/refined/DNABR_QC/runs/m27f-blind-split-20260816a/results/27f_blind_split/m27f_split.private.tsv'
  m38b_split_sha256 = '7e4abe2aa57c7375023268e56e3c1dbf9c7bbedc31c3acf1e07b4b07dabfdd07'
  m38b_selected_loci = 'gs://teams-usp/frank/lai-exploracion-datos/runs/m34-nam-128-r0-20260827a/fit/bridge/m34_fit_bridge/m34_selected_loci.npz'
  m38b_selected_sha256 = '0bdf50d6812abf3d74975774f1a7257b52c3c263822e8aeaa59cd673c5c31fd0'

  m38b_loo_posterior_draws = 131072
  m38b_loo_seed = 3802103
  m38b_loo_cpus = 2
  m38b_loo_memory = '8 GB'
  m38b_loo_time = '2h'
}

workDir = "${params.m38b_batch_root}/work/nextflow/${params.m38b_run_id}/loo"
docker.enabled = false

process {
  executor = 'google-batch'
  container = params.m38b_python_image
  containerOptions = { "--network none --user ${params.m38b_loo_container_user}" }
  disk = '20 GB'
  errorStrategy = 'terminate'
  maxRetries = 0
  stageInMode = 'copy'
  resourceLabels = [team: 'frank', lane: 'm38b-loo']
}

google {
  project = 'uspbr-242713'
  location = params.m38b_region
  batch {
    spot = false
    maxSpotAttempts = 0
  }
}
