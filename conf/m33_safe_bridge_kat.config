params {
    fixture = "${baseDir}/../tests/fixtures/m33_safe_bridge_minor0_overlap_missing.json"
    contract = "${baseDir}/../conf/m33_safe_bridge_kat_contract.json"
    base_contract = "${baseDir}/../conf/m33_m0_materializer_contract.json"
    runner = "${baseDir}/../bin/m33_safe_bridge_kat.py"
    core = "${baseDir}/../bin/m33_safe_bridge_core.py"
    container_image = 'us-central1-docker.pkg.dev/uspbr-242713/dnabr-lai/m28-lai-sim@sha256:06e7b70a2484de19c73a18a6fc9ddefbfa1599e43cbcdcd60fd185495dfb9a19'
}

process {
    executor = 'local'
    maxForks = 1
    stageInMode = 'copy'
    withName: SAFE_BRIDGE_KAT {
        container = params.container_image
        containerOptions = '--network=none --read-only --user 1017:1020'
    }
}

docker.enabled = true
singularity.enabled = false
timeline.enabled = false
report.enabled = false
trace.enabled = false
