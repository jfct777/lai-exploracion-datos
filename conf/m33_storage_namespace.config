def m33RunId = System.getenv('DNABR_RUN_ID')
if( !m33RunId || !(m33RunId ==~ /[a-z0-9][a-z0-9._-]{2,63}/) ) {
  throw new IllegalStateException('DNABR_RUN_ID no es válido para M33.')
}

def m33ProjectRoot = 'gs://teams-usp/frank/lai-exploracion-datos'
def m33RunRoot = "${m33ProjectRoot}/runs/${m33RunId}"
def m33WorkRoot = "${m33ProjectRoot}/work/nextflow/${m33RunId}"
def m33LogRoot = "${m33ProjectRoot}/logs/${m33RunId}"
def m33ManifestRoot = "${m33ProjectRoot}/manifests/${m33RunId}"
def m33ContractInspection = System.getenv('DNABR_M33_CONTRACT_INSPECTION')
if( m33ContractInspection != '1' ) {
  throw new IllegalStateException('M33 permanece bloqueado: esta configuración solo puede inspeccionarse con DNABR_M33_CONTRACT_INSPECTION=1.')
}

params {
  m33_project_write_root = "${m33ProjectRoot}/"
  m33_run_id = m33RunId
  m33_results_dir = m33RunRoot
  m33_work_dir = m33WorkRoot
  m33_logs_dir = m33LogRoot
  m33_manifests_dir = m33ManifestRoot
  m33_storage_policy = "${projectDir}/conf/m33_storage_namespace_policy.json"
  m33_real_run_authorized = false
  m33_batch_region = 'us-central1'
  m33_batch_resource_labels = [team: 'frank']
}

workDir = m33WorkRoot
