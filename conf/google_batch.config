// Configuración del proyecto dnaBr-lai para Google Batch.
// Cada ejecución usa un identificador propio para separar resultados y caché.

def runId = System.getenv('DNABR_RUN_ID')
if( !runId ) {
  throw new IllegalStateException('Falta DNABR_RUN_ID. Usa un nombre corto, por ejemplo qc-chr22-20260804.')
}
if( !(runId ==~ /[a-z0-9][a-z0-9._-]{2,63}/) ) {
  throw new IllegalStateException("DNABR_RUN_ID no es válido: ${runId}. Usa minúsculas, números, punto, guion o guion bajo.")
}

def projectId      = 'uspbr-242713'
def region         = 'us-central1'
def bucketRoot     = 'gs://projects-usp/dnaBr-lai'
def datalakeRoot   = "${bucketRoot}/datalake"
def rawRoot        = "${datalakeRoot}/raw/DNABR_QC"
def trustedRoot    = "${datalakeRoot}/trusted/DNABR_QC"
def refinedRoot    = "${datalakeRoot}/refined/DNABR_QC"
def transientRoot  = "${datalakeRoot}/transient/DNABR_QC"
def sharedRoot     = "${datalakeRoot}/shared/DNABR_QC"
def currentResults = "${refinedRoot}/runs/${runId}"
def currentWork    = "${transientRoot}/tmp/nxf_work/${runId}"
def metadataUri    = System.getenv('DNABR_METADATA_URI') ?: "${trustedRoot}/metadata/metadata_cleaned.txt"

params {
  cloud_project         = projectId
  cloud_region          = region
  cloud_bucket_root     = bucketRoot
  cloud_datalake_root   = datalakeRoot
  cloud_raw_root        = rawRoot
  cloud_trusted_root    = trustedRoot
  cloud_refined_root    = refinedRoot
  cloud_transient_root  = transientRoot
  cloud_shared_root     = sharedRoot
  cloud_run_id          = runId

  vcf_dir   = "${rawRoot}/decrypted"
  ref_fasta = "${trustedRoot}/reference/hg38_ucsc/Homo_sapiens_assembly38.fasta"
  outdir    = currentResults
  workdir   = currentWork

  container_image  = 'us-central1-docker.pkg.dev/uspbr-242713/dnabr-lai/dnabr-qc:27-01-2026-procps'
  container_digest = '3baca87521291075c1ea5c7b17a3706a5030adda65174313fbc203c1a1324b35'

  // Derivada versionada en containers/Dockerfile.m14-analysis. Su alcance se
  // limita a los procesos M14/M24 que requieren scipy/joblib.
  m14_analysis_container_image  = 'us-central1-docker.pkg.dev/uspbr-242713/dnabr-lai/dnabr-qc:m14-analysis-20260805'
  m14_analysis_container_digest = '883fdadc1f951edc335c1f394d5a00958411dcd04a95d65334c6ce80e7b5d53d'

  // El perfil cloud no ejecuta módulos por accidente. Cada corrida activa solo las etapas necesarias.
  run_qc            = false
  run_downstream    = false
  run_model_pipeline = false
  run_rare_bench    = false
  enable_norm        = false
  enable_filter      = false
  enable_lai_rare    = false
  enable_bcfstats    = false
  enable_pgen        = false
  enable_missing_het = false
  enable_report      = false

  ancestral_fasta     = "${trustedRoot}/reference/ensembl_ancestral/homo_sapiens_ancestor_GRCh38.fa"
  exclude_regions_bed = "${trustedRoot}/reference/exclude_regions_hg38/exclude_regions_hg38.bed"

  painting_input_dir         = "${refinedRoot}/results_modtest_mac2/lai_rare"
  rare_tract_input_dir       = "${refinedRoot}/results_modtest_mac2/lai_rare"
  distance_mode_input_dir    = "${refinedRoot}/results_modtest_mac2/lai_rare"
  rare_in_lai_input_dir      = "${refinedRoot}/results_modtest_mac2/lai_rare"
  rare_on_lai_input_dir      = "${refinedRoot}/results_modtest_mac2/lai_rare"
  presence_channel_input_dir = "${refinedRoot}/results_modtest_mac2/lai_rare"
  feature_build_input_dir    = "${refinedRoot}/results_modtest_mac2/lai_rare"
  allele_orientation_audit_input_dir = "${refinedRoot}/results_modtest_mac2/lai_rare"

  // Se declaran de forma explícita porque el perfil HPC calcula estos valores
  // a partir de su outdir antes de que se cargue esta configuración.
  rare_tract_results_dir       = "${currentResults}/12_rare_snp_tracts"
  distance_mode_results_dir    = "${currentResults}/13_individual_snp_distance_modes"
  painting_results_dir         = "${currentResults}/14_rare_allele_sharing_painting"
  ibd_enhanced_results_dir     = "${currentResults}/16_5_ibd_community_enhanced"
  rare_in_lai_results_dir      = "${currentResults}/17_rare_in_lai_tracts"
  asibd_results_dir            = "${currentResults}/18_common_asibd_comparator"
  rare_on_lai_results_dir      = "${currentResults}/19_rare_on_lai_painting"
  feature_build_results_dir    = "${currentResults}/20_feature_store"
  allele_orientation_audit_results_dir = "${currentResults}/24_rare_allele_orientation_audit"
  presence_channel_results_dir = "${currentResults}/21_presence_channel"
  flags_tsv                    = "${currentResults}/06_report/flags_per_sample.tsv"

  rare_in_lai_msp_dir = "${trustedRoot}/lai-genomix/persnplai_default_rephase_results"
  rare_on_lai_msp_dir = "${trustedRoot}/lai-genomix/persnplai_default_rephase_results"
  asibd_input_dir       = "${trustedRoot}/reference/external_datasets/nunes_asibd"
  presence_panel_dir    = "${trustedRoot}/reference/external_panels"
  presence_lcr_mask_dir = "${trustedRoot}/reference/masks_hg38/raw"

  feature_build_m14_dir = "${refinedRoot}/14_wgs_2619_mac2_matrix/14_rare_allele_sharing_painting_autosomes_only"
  feature_build_metadata_file = metadataUri
  rare_tract_metadata    = metadataUri
  rare_in_lai_metadata   = metadataUri
  rare_on_lai_metadata   = metadataUri
  asibd_metadata         = metadataUri
  ibd_enhanced_metadata_file = metadataUri

  model_pipeline_results_dir       = "${currentResults}/22_model_pipeline"
  model_pipeline_feature_store_tsv = "${refinedRoot}/20_feature_store/20_feature_store/feature_store.tsv"
  model_pipeline_leiden_tsv        = "${refinedRoot}/14_wgs_2619_mac2_matrix/16_5_minedge_2Mb_mac2_autosomes/leiden_assignments.tsv"
  model_pipeline_graph_nodes_tsv   = "${refinedRoot}/14_wgs_2619_mac2_matrix/16_5_minedge_2Mb_mac2_autosomes/graph_nodes.tsv"
  model_pipeline_pcrelate_kin_tsv  = "${refinedRoot}/qc_pcrelate/dnabr.pcrelate.kin.tsv"
  model_pipeline_metadata_file     = metadataUri

  rare_bench_results_dir     = "${currentResults}/23_rare_matrix_benchmark"
  rare_bench_rare_vcf_dir    = "${refinedRoot}/results_modtest_mac2/lai_rare"
  rare_bench_split_manifest  = "${refinedRoot}/model_pipeline_canonical/22_model_pipeline/split/split_manifest.tsv"
  rare_bench_modeling_master = "${refinedRoot}/model_pipeline_canonical/22_model_pipeline/modeling_master/modeling_master.tsv"
  allele_orientation_audit_canonical_m14_per_chr_dir = "${refinedRoot}/14_wgs_2619_mac2_matrix/14_rare_allele_sharing_painting/per_chr"
  allele_orientation_audit_split_manifest = "${refinedRoot}/model_pipeline_canonical/22_model_pipeline/split/split_manifest.tsv"
}

workDir = currentWork

process {
  executor = 'google-batch'
  container = params.container_image
  disk = '100 GB'

  // Los límites conservan paralelismo útil sin crear demasiadas máquinas a la vez.
  withName: 'PREPROCESS_NORM_LEFTALIGN'            { disk = '500 GB'; maxForks = 4 }
  withName: 'PREPROCESS_FILTER_SNV_BIALLELIC_PASS' { disk = '750 GB'; maxForks = 4 }
  withName: 'QC_BCFTOOLS_STATS'                    { disk = '250 GB'; maxForks = 6 }
  withName: 'QC_PLINK_MAKE_PGEN'                   { disk = '500 GB'; maxForks = 4 }
  withName: 'QC_PLINK_MISSING_HET'                 { disk = '500 GB'; maxForks = 4 }
  withName: 'SFS_FROM_FILTERED_VCF'                { disk = '250 GB'; maxForks = 6 }
  withName: 'BUILD_ANCESTRAL_TSV_FROM_FASTA'       { disk = '250 GB'; maxForks = 4 }
  withName: 'DAF_DSFS_FROM_ANCESTRAL_TSV'          { disk = '250 GB'; maxForks = 4 }
  withName: 'LD_DECAY_FROM_PGEN'                   { disk = '350 GB'; maxForks = 4 }
  withName: 'TAG_SNPS_FROM_PGEN'                   { disk = '350 GB'; maxForks = 4 }
  withName: 'LAI_RARE_BIALELIC_ONLY'               { disk = '250 GB'; maxForks = 6 }
  withName: 'ANALYZE_RARE_ALLELE_SHARING'          { container = params.m14_analysis_container_image; disk = '200 GB'; maxForks = 4 }
  withName: 'IBD_COMMUNITY_ENHANCED'               { disk = '250 GB'; maxForks = 1 }
  withName: 'COMPARE_ASIBD_COMMON'                 { disk = '200 GB'; maxForks = 1 }
  withName: 'ANALYZE_PRESENCE_CHANNEL'             { disk = '150 GB'; maxForks = 6 }
  withName: 'COUNT_RARE_DENSITY'                   { disk = '150 GB'; maxForks = 6 }
  withName: 'EXTRACT_RARE_MATRIX_CHR'              { disk = '150 GB'; maxForks = 6 }
  withName: 'CONCAT_RARE_MATRIX'                   { disk = '250 GB'; maxForks = 1 }
  withName: 'RARE_BENCH_PREFLIGHT'                 { disk = '250 GB'; maxForks = 1 }
  withName: 'RARE_BENCH_CV_ABC'                    { disk = '250 GB'; maxForks = 1 }
  withName: 'RARE_BENCH_CV_FOLD'                   { disk = '250 GB'; maxForks = 4 }
  withName: 'RARE_BENCH_REFIT_FOLD'                { disk = '250 GB'; maxForks = 4 }
  withName: 'AUDIT_RARE_ALLELE_ORIENTATION'        { container = params.m14_analysis_container_image; disk = '250 GB'; maxForks = 1 }
  withName: 'WRITE_MODEL_RUN_PROVENANCE'            { disk = '20 GB'; maxForks = 1 }
  withName: 'WRITE_RARE_BENCH_RUN_PROVENANCE'       { disk = '20 GB'; maxForks = 1 }
  withName: 'WRITE_ALLELE_ORIENTATION_AUDIT_RUN_PROVENANCE' { disk = '20 GB'; maxForks = 1 }
}

executor.queueSize = 20

google {
  project  = projectId
  location = region
}

profiles {
  // Cadena principal desde los VCF conjuntos hasta el reporte de QC.
  google_batch_qc {
    params {
      run_qc            = true
      enable_norm        = true
      enable_filter      = true
      enable_bcfstats    = true
      enable_pgen        = true
      enable_missing_het = true
      enable_report      = true
    }
  }
}
