params {
    m39_image = 'us-central1-docker.pkg.dev/uspbr-242713/dnabr-lai/m33-t0a@sha256:c03864a9ed0c56b00fd1a234daee2d17ddfa57d4c426628bd59cd9daf351ee99'
    m39_output_dir = null
    m39_capacity_widths = [32, 64]
    m39_capacity_rates = [0.003]
    m39_capacity_heads = ['multiplicative']
    m39_capacity_baselines = ['balanced']
    m39_capacity_steps = 300
    m39_capacity_seed = 39052026
    m39_container_user = System.getenv('M39_CONTAINER_USER') ?: '1017:1020'
}
process {
    executor = 'local'
    errorStrategy = 'terminate'
    maxRetries = 0
    stageInMode = 'copy'
    containerOptions = "--network none --user ${params.m39_container_user} --cpus 2 --memory 3g --memory-swap 3g --env TORCHINDUCTOR_CACHE_DIR=/tmp/m39-torch-cache"
    resourceLabels = [team: 'frank', lane: 'm39-capacity']
}
docker.enabled = true
docker.fixOwnership = false
executor.queueSize = 2
executor.cpus = 4
executor.memory = '6 GB'
trace {
    enabled = true
    overwrite = false
    fields = 'task_id,hash,native_id,name,status,exit,submit,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar,cpus,memory'
}
timeline.enabled = true
report.enabled = true
