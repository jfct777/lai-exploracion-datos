params {
  m28c_smoke_reference_vcf = "${baseDir}/../results/28c_b0_input_preflight/run6/seed-20260818/m28c_ingest/m28c_b0_reference.vcf.gz"
  m28c_smoke_reference_tbi = "${baseDir}/../results/28c_b0_input_preflight/run6/seed-20260818/m28c_ingest/m28c_b0_reference.vcf.gz.tbi"
  m28c_smoke_target_vcf = "${baseDir}/../results/28c_b0_input_preflight/run6/seed-20260818/m28c_ingest/m28c_b0_target.vcf.gz"
  m28c_smoke_target_tbi = "${baseDir}/../results/28c_b0_input_preflight/run6/seed-20260818/m28c_ingest/m28c_b0_target.vcf.gz.tbi"
  m28c_smoke_sample_map = "${baseDir}/../results/28c_b0_input_preflight/run6/seed-20260818/m28c_b0/m28c_b0_reference.sample_map.tsv"
  m28c_smoke_b0_markers = "${baseDir}/../results/28b_lai_optimal_matching_audit/run1/m28b_v4_validation/m28b_v4_validation_B0.tsv.gz"
  m28c_smoke_genetic_map = "${baseDir}/../results/28c_gnomix_training_smoke/inputs/genetic.map.chr22"
  m28c_smoke_gnomix_config = "${baseDir}/../conf/m28c_gnomix_training_smoke.yaml"
  m28c_smoke_preregistration = "${baseDir}/../conf/m28c_gnomix_training_smoke_preregistration.json"
  m28c_smoke_results_dir = "${baseDir}/../results/28c_gnomix_training_smoke/run1"
  m28c_smoke_container_image = "dnabr-m28c-gnomix:e758f2c-r4"
  m28c_smoke_container_digest = "sha256:0691d58732a4deb16125059658618d794997338de7e630255559b1832775a2a4"
  m28c_smoke_container_options = System.getenv('DNABR_CONTAINER_OPTIONS') ?: ''

  m28c_smoke_prepare_cpus = 2
  m28c_smoke_prepare_memory = "4 GB"
  m28c_smoke_prepare_time = "10m"
  m28c_smoke_train_cpus = 4
  m28c_smoke_train_memory = "8 GB"
  m28c_smoke_train_time = "30m"
  m28c_smoke_infer_cpus = 4
  m28c_smoke_infer_memory = "8 GB"
  m28c_smoke_infer_time = "10m"
  m28c_smoke_compare_cpus = 1
  m28c_smoke_compare_memory = "2 GB"
  m28c_smoke_compare_time = "5m"
}

docker.enabled = true

process {
  executor = 'local'
  errorStrategy = 'terminate'
  maxRetries = 0

  withName: TRAIN_M28C_GNOMIX_SMOKE {
    maxForks = 2
  }
}
