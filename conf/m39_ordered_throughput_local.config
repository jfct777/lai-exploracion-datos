// Small TRAIN-only throughput with synthetic labels; no scientific sweep.
params {
    m39_image = 'us-central1-docker.pkg.dev/uspbr-242713/dnabr-lai/m33-t0a@sha256:c03864a9ed0c56b00fd1a234daee2d17ddfa57d4c426628bd59cd9daf351ee99'
    m39_store_dir = null
    m39_parent_receipt = null
    m39_folds = null
    m39_profile_config = null
    m39_profile_sha256 = null
    m39_source_commit = null
    m39_output_dir = null
    m39_run_token = null
    m39_container_user = System.getenv('M39_CONTAINER_USER') ?: '1017:1020'
}
process {
    executor = 'local'
    errorStrategy = 'terminate'
    maxRetries = 0
    // Ten Python sources plus small folds/JSON contracts, never the store.
    stageInMode = 'copy'
    containerOptions = "--network none --pull never --user ${params.m39_container_user} --cpus 2 --memory 8g --memory-swap 8g --label dnabr.m39_run=${params.m39_run_token} --mount type=bind,src=${params.m39_store_dir},dst=/m39-ordered-store,readonly"
    resourceLabels = [team: 'frank', lane: 'm39-ordered-throughput-technical']
}
docker.enabled = true
docker.fixOwnership = false
docker.writableInputMounts = false
executor.queueSize = 2
executor.cpus = 4
executor.memory = '16 GB'
trace {
    enabled = true
    overwrite = false
    fields = 'task_id,hash,native_id,name,status,exit,submit,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar,cpus,memory'
}
timeline.enabled = true
report.enabled = true

