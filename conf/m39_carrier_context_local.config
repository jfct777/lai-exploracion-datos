params {
    m39_image = 'us-central1-docker.pkg.dev/uspbr-242713/dnabr-lai/m33-t0a@sha256:c03864a9ed0c56b00fd1a234daee2d17ddfa57d4c426628bd59cd9daf351ee99'
    m39_contract = "${projectDir}/../conf/m39_carrier_context_bridge.json"
    m39_input_dir = null
    m39_output_dir = null
}
process {
    executor = 'local'
    errorStrategy = 'terminate'
    maxRetries = 0
    stageInMode = 'copy'
    containerOptions = '--network none --cpus 2 --memory 6g --memory-swap 6g'
    resourceLabels = [team: 'frank', lane: 'm39-context']
}
docker.enabled = true
docker.fixOwnership = true
executor.queueSize = 1
executor.cpus = 2
executor.memory = '6 GB'
trace {
    enabled = true
    overwrite = false
    fields = 'task_id,hash,native_id,name,status,exit,submit,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar,cpus,memory'
}
timeline.enabled = true
report.enabled = true
