params {
  // DNABR_QC HPC paths (Aesop)
  vcf_dir = "/scratch/datalake/raw/genbr/genbr_bioinfo/projects/DNABR_QC/decrypted"
  ref_fasta = "/scratch/datalake/trusted/genbr/genbr_bioinfo/projects/DNABR_QC/reference/hg38_ucsc/Homo_sapiens_assembly38.fasta"
  //outdir = "/scratch/datalake/refined/genbr/genbr_bioinfo/projects/DNABR_QC/results"
  outdir = "/scratch/datalake/refined/genbr/genbr_bioinfo/projects/DNABR_QC/results_modtest"
  // Force stable work dir for -resume
  workdir = "/scratch/datalake/transient/genbr/genbr_bioinfo/projects/DNABR_QC/tmp/nxf_work"

  // Singularity SIF location
  // dnabr-qc-hpc.sif is the maintained image: same Python toolchain as
  // the legacy dnabr-qc_27-01-2026.sif PLUS procps (for Nextflow process
  // monitoring) and the 2026-05 visualisation extras (plotly>=5,
  // adjustText) required by M16.5's interactive HTML + label-repulsion
  // path.  Do NOT revert to the legacy image — it lacks those libs and
  // M16.5 plot mode degrades silently.
  container_image = "${System.getenv('HOME')}/images/dnabr-qc-hpc.sif"

  // Downstream 07+
  run_downstream = true

  // Ancestral / DAF / DSFS
  ancestral_fasta = "/scratch/datalake/trusted/genbr/genbr_bioinfo/projects/DNABR_QC/reference/ensembl_ancestral/homo_sapiens_ancestor_GRCh38.fa"
  enable_build_ancestral_tsv = false  // M08 opt-in: solo activar si vas a correr M09 DAF/DSFS
  enable_daf = false

  // SFS
  enable_sfs = false  // true para activar módulo 07 (site frequency spectrum)

  // LD decay / Tag SNPs
  enable_ld = false  // true para activar módulo 10 (LD decay analysis)
  enable_tag_snps = false  // true para activar módulo 11 (tag SNP identification)
  tag_step = 1
  exclude_regions_bed = "/scratch/datalake/trusted/genbr/genbr_bioinfo/projects/DNABR_QC/reference/exclude_regions_hg38/exclude_regions_hg38.bed"
  // Si exclude_regions_bed no existe, el workflow corre sin exclusión de regiones (módulos 10/11 lo permiten)

  // Rare SNP tracts from upstream lai_rare outputs
  enable_rare_snp_tracts = false
  rare_tract_input_dir = "/scratch/datalake/refined/genbr/genbr_bioinfo/projects/DNABR_QC/results_modtest/lai_rare"
  rare_tract_plot_dpi = 600
  rare_tract_plot_palette = "journal"

  // Module 13: per-individual pairwise distances between carrier rare SNPs
  enable_individual_snp_distance_modes = false
  distance_mode_input_dir = "/scratch/datalake/refined/genbr/genbr_bioinfo/projects/DNABR_QC/results_modtest/lai_rare"
  distance_mode_results_dir = "${params.outdir}/13_individual_snp_distance_modes"
  distance_mode_plot_dpi = 600
  distance_mode_plot_palette = "journal"

  // Module 14: rare allele sharing painting
  enable_rare_allele_painting = false
  painting_input_dir = "/scratch/datalake/refined/genbr/genbr_bioinfo/projects/DNABR_QC/results_modtest/lai_rare"
  painting_results_dir = "${params.outdir}/14_rare_allele_sharing_painting"
  painting_plot_dpi = 600
  painting_plot_palette = "journal"

  // Module 17: rare variants in LAI tracts (Gnomix local-ancestry painting)
  enable_rare_in_lai = false
  rare_in_lai_input_dir = "/scratch/datalake/refined/genbr/genbr_bioinfo/projects/DNABR_QC/results_modtest/lai_rare"
  rare_in_lai_msp_dir = "/scratch/datalake/trusted/genbr/genbr_bioinfo/projects/DNABR_QC/lai-genomix/persnplai_default_rephase_results"
  rare_in_lai_results_dir = "${params.outdir}/17_rare_in_lai_tracts"

  // Module 19: figura raras-sobre-painting-LAI. Input = matriz canónica MAC=2.
  enable_rare_on_lai_painting = false
  rare_on_lai_input_dir = "/scratch/datalake/refined/genbr/genbr_bioinfo/projects/DNABR_QC/results_modtest_mac2/lai_rare"
  rare_on_lai_msp_dir = "/scratch/datalake/trusted/genbr/genbr_bioinfo/projects/DNABR_QC/lai-genomix/persnplai_default_rephase_results"
  rare_on_lai_results_dir = "${params.outdir}/19_rare_on_lai_painting"

  // Filtros QC (heredados de nextflow.config; override aquí si necesitas cambiarlos para HPC)
  // keep_pass = true  // false para no filtrar por flag PASS
  // max_missing_site = 0.05  // 1.0 para anular filtro de missingness
}
